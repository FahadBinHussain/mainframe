+// These are counterexamples for the pinned SDK, NOT snapshot safety tests.
+// No SQL store, socket, account, credentials, or media is opened. DangerousInternals
+// is used only to deliver synthetic input to the real dependency producer paths.
+func snapshotProbeAwait(t *testing.T, ch <-chan struct{}, what string) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(5 * time.Second):
+		t.Fatalf("timed out waiting for %s", what)
+	}
+}
+
+type snapshotProbeKeys struct {
+	store.AppStateSyncKeyStore // unexpected calls panic instead of touching real state
+	entered                    chan struct{}
+	release                    chan struct{}
+	written                    chan struct{}
+	ctxErr                     error
+}
+
+func (s *snapshotProbeKeys) PutAppStateSyncKey(ctx context.Context, _ []byte, _ store.AppStateSyncKey) error {
+	s.ctxErr = ctx.Err()
+	close(s.entered)
+	<-s.release
+	// This in-memory effect stands in for the dependency-owned session write.
+	close(s.written)
+	return nil
+}
+
+type snapshotProbeVersions struct {
+	store.AppStateStore
+	remaining int
+	done      chan struct{}
+}
+
+func (s *snapshotProbeVersions) GetAppStateVersion(context.Context, string) (uint64, [128]byte, error) {
+	s.remaining--
+	if s.remaining == 0 {
+		close(s.done)
+	}
+	// Already-synced collections prevent any network fetch.
+	return 1, [128]byte{}, nil
+}
+
+type snapshotProbeMetadata struct {
+	AppStateKeyStateStore
+	cleared chan struct{}
+}
+
+func (s *snapshotProbeMetadata) ClearAppStateKeyUnavailable(context.Context, string, []byte) error {
+	close(s.cleared)
+	return nil
+}
+
+func TestSnapshotDependencyProbeKeyWriterOutlivesWrapperClose(t *testing.T) {
+	keys := &snapshotProbeKeys{entered: make(chan struct{}), release: make(chan struct{}), written: make(chan struct{})}
+	versions := &snapshotProbeVersions{remaining: len(appstate.AllPatchNames), done: make(chan struct{})}
+	metadata := &snapshotProbeMetadata{cleared: make(chan struct{})}
+	guard := &appStateKeyGuard{AppStateSyncKeyStore: keys, state: metadata, account: "synthetic"}
+	cli := whatsmeow.NewClient(&store.Device{AppStateKeys: guard, AppState: versions}, nil)
+	wrapper := &Client{client: cli}
+	var once sync.Once
+	release := func() { once.Do(func() { close(keys.release) }) }
+	t.Cleanup(func() {
+		release()
+		wrapper.Close()
+	})
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel() // handleProtocolMessage deliberately passes WithoutCancel to its worker.
+	info := &types.MessageInfo{MessageSource: types.MessageSource{IsFromMe: true, Sender: types.JID{Device: 1}}}
+	msg := &waE2E.Message{ProtocolMessage: &waE2E.ProtocolMessage{
+		AppStateSyncKeyShare: &waE2E.AppStateSyncKeyShare{Keys: []*waE2E.AppStateSyncKey{{
+			KeyID:   &waE2E.AppStateSyncKeyId{KeyID: []byte("synthetic-id")},
+			KeyData: &waE2E.AppStateSyncKeyData{KeyData: []byte("synthetic-only")},
+		}}},
+	}}
+	if !cli.DangerousInternals().HandleProtocolMessage(ctx, info, msg) {
+		t.Fatal("synthetic protocol input was not accepted")
+	}
+	snapshotProbeAwait(t, keys.entered, "dependency key-store admission")
+	if keys.ctxErr != nil {
+		t.Fatal("expected detached worker to retain an uncanceled context")
+	}
+	closed := make(chan struct{})
+	go func() { wrapper.Close(); close(closed) }()
+	snapshotProbeAwait(t, closed, "wrapper Close while key writer is blocked")
+	select {
+	case <-keys.written:
+		t.Fatal("fixture write completed before release")
+	default:
+	}
+	release()
+	snapshotProbeAwait(t, keys.written, "write after wrapper Close returned")
+	snapshotProbeAwait(t, metadata.cleared, "WACLI metadata write after wrapper Close returned")
+	snapshotProbeAwait(t, versions.done, "post-write dependency continuation")
+}
