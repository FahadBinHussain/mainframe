+func TestSnapshotDependencyProbeQueueCloseIsNotNodeJoin(t *testing.T) {
+	id := types.JID{User: "synthetic-self", Server: types.DefaultUserServer}
+	cli := whatsmeow.NewClient(&store.Device{ID: &id}, nil)
+	entered, release, finished := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	unblock := func() { once.Do(func() { close(release) }) }
+	cli.AddEventHandler(func(evt any) {
+		if _, ok := evt.(*events.ChatPresence); ok {
+			close(entered)
+			<-release
+			close(finished)
+		}
+	})
+	connCtx, cancel := context.WithCancel(context.Background())
+	queue := make(chan *waBinary.Node, 1)
+	queueClosed := make(chan struct{})
+	loopDone := make(chan struct{})
+	go func() {
+		cli.DangerousInternals().HandlerQueueLoop(context.Background(), connCtx, queue, queueClosed)
+		close(loopDone)
+	}()
+	t.Cleanup(func() {
+		cancel()
+		unblock()
+		snapshotProbeAwait(t, loopDone, "queue loop cleanup")
+	})
+	queue <- &waBinary.Node{Tag: "chatstate", Attrs: waBinary.Attrs{
+		"from": types.JID{User: "synthetic", Server: types.DefaultUserServer},
+	}, Content: []waBinary.Node{{Tag: "composing"}}}
+	snapshotProbeAwait(t, entered, "node event handler admission")
+	cancel()
+	snapshotProbeAwait(t, queueClosed, "dependency queue-close signal")
+	select {
+	case <-finished:
+		t.Fatal("fixture node handler completed before release")
+	default:
+	}
+	unblock()
+	snapshotProbeAwait(t, finished, "node handler after queue-close signal")
+}
