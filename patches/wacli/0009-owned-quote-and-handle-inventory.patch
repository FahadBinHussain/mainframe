diff --git a/internal/app/owned_quote_test.go b/internal/app/owned_quote_test.go
new file mode 100644
index 0000000..5dcd479
--- /dev/null
+++ b/internal/app/owned_quote_test.go
@@ -0,0 +1,182 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/openclaw/wacli/internal/store"
+	"go.mau.fi/whatsmeow/types"
+)
+
+type ownedQuoteProbe struct {
+	calls   atomic.Int32
+	entered chan struct{}
+	release chan struct{}
+	failure error
+	panics  bool
+}
+
+func (p *ownedQuoteProbe) read() error {
+	p.calls.Add(1)
+	if p.entered != nil {
+		close(p.entered)
+		<-p.release
+	}
+	if p.panics {
+		panic(p.failure)
+	}
+	return p.failure
+}
+func (p *ownedQuoteProbe) GetMessage(string, string) (store.Message, error) {
+	return store.Message{}, p.read()
+}
+func (p *ownedQuoteProbe) GetMediaDownloadInfo(string, string) (store.MediaDownloadInfo, error) {
+	return store.MediaDownloadInfo{}, p.read()
+}
+
+func TestOwnedQuoteRefusalHasZeroDBAndClientEffects(t *testing.T) {
+	for _, mode := range []string{"finished", "missing", "foreign", "canceled", "sealed-finished", "sealed-missing"} {
+		t.Run(mode, func(t *testing.T) {
+			a, client, ctx, finish := ownedTestApp(t)
+			db, err := a.OwnedDB(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			wa, err := a.OwnedWA(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			probe := &ownedQuoteProbe{}
+			db.quote = probe
+			use := ctx
+			switch mode {
+			case "finished":
+				finish(nil)
+			case "missing":
+				use = context.Background()
+			case "foreign":
+				other := &App{}
+				var end func(error)
+				use, end, err = other.BeginScopedOperation(context.Background())
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer end(nil)
+			case "canceled":
+				var cancel context.CancelFunc
+				use, cancel = context.WithCancel(ctx)
+				cancel()
+			case "sealed-finished", "sealed-missing":
+				finish(nil)
+				if held, err := a.BeginDrain(context.Background()); held != nil || !errors.Is(err, ErrDrainCoverageIncomplete) {
+					t.Fatalf("seal unexpectedly certified capture: %v %v", held, err)
+				}
+				if mode == "sealed-missing" {
+					use = context.Background()
+				}
+				if _, _, err := a.BeginScopedOperation(context.Background()); !errors.Is(err, ErrOperationSealed) {
+					t.Fatal(err)
+				}
+			}
+			if _, err := db.GetMessage(use, "synthetic", "quote"); !errors.Is(err, ErrHandleRevoked) {
+				t.Fatalf("message read: %v", err)
+			}
+			if _, err := db.GetMediaDownloadInfo(use, "synthetic", "quote"); !errors.Is(err, ErrHandleRevoked) {
+				t.Fatalf("media read: %v", err)
+			}
+			if _, err := wa.SendText(use, types.JID{}, "synthetic"); !errors.Is(err, ErrHandleRevoked) {
+				t.Fatalf("client admission: %v", err)
+			}
+			if probe.calls.Load() != 0 || client.calls.Load() != 0 {
+				t.Fatalf("refusal reached DB/client: %d/%d", probe.calls.Load(), client.calls.Load())
+			}
+		})
+	}
+}
+
+func TestOwnedQuoteLiveParentAfterSealAndActualReadJoin(t *testing.T) {
+	for _, media := range []bool{false, true} {
+		name := "message"
+		if media {
+			name = "media"
+		}
+		t.Run(name, func(t *testing.T) {
+			a, _, ctx, finish := ownedTestApp(t)
+			db, err := a.OwnedDB(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			failure := errors.New("synthetic quote read failure")
+			probe := &ownedQuoteProbe{entered: make(chan struct{}), release: make(chan struct{}), failure: failure}
+			db.quote = probe
+			canceled, cancel := context.WithCancel(context.Background())
+			cancel()
+			if held, err := a.BeginDrain(canceled); held != nil || !errors.Is(err, ErrDrainCoverageIncomplete) {
+				t.Fatalf("seal: %v %v", held, err)
+			}
+			result := make(chan error, 1)
+			go func() {
+				var err error
+				if media {
+					_, err = db.GetMediaDownloadInfo(ctx, "synthetic", "quote")
+				} else {
+					_, err = db.GetMessage(ctx, "synthetic", "quote")
+				}
+				result <- err
+			}()
+			select {
+			case <-probe.entered:
+			case <-time.After(time.Second):
+				t.Fatal("accepted parent could not start quote read after seal")
+			}
+			finish(nil)
+			drained := make(chan error, 1)
+			go func() { _, err := a.BeginDrain(context.Background()); drained <- err }()
+			select {
+			case err := <-drained:
+				t.Fatalf("drain escaped active quote read: %v", err)
+			case <-time.After(20 * time.Millisecond):
+			}
+			close(probe.release)
+			if err := <-result; !errors.Is(err, failure) {
+				t.Fatal(err)
+			}
+			select {
+			case err := <-drained:
+				if !errors.Is(err, failure) || !errors.Is(err, ErrDrainCoverageIncomplete) {
+					t.Fatalf("lost failure or fail-closed coverage: %v", err)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("drain did not join completed quote read")
+			}
+			if probe.calls.Load() != 1 {
+				t.Fatal("unexpected query count")
+			}
+		})
+	}
+}
+
+func TestOwnedQuotePanicRetainsFailure(t *testing.T) {
+	a, _, ctx, finish := ownedTestApp(t)
+	db, err := a.OwnedDB(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	failure := errors.New("synthetic quote panic")
+	db.quote = &ownedQuoteProbe{failure: failure, panics: true}
+	func() {
+		defer func() {
+			if recover() != failure {
+				t.Error("quote panic changed")
+			}
+		}()
+		_, _ = db.GetMessage(ctx, "synthetic", "quote")
+	}()
+	finish(nil)
+	if held, err := a.BeginDrain(context.Background()); held != nil || !errors.Is(err, failure) || !errors.Is(err, ErrDrainCoverageIncomplete) {
+		t.Fatalf("lost quote panic: %v %v", held, err)
+	}
+}
