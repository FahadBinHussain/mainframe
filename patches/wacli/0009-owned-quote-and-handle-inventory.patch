index 0000000..6bc3d91
--- /dev/null
+++ b/cmd/wacli/owned_handle_inventory_test.go
@@ -0,0 +1,186 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"go/ast"
+	"go/format"
+	"go/parser"
+	"go/token"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+)
+
+// ownedHandleSite is deliberately syntactic: it does not attempt receiver type
+// resolution or infer whether a command's root scope protects a retained handle.
+type ownedHandleSite struct {
+	ID         string `json:"id"`
+	Path       string `json:"path"`
+	Function   string `json:"function"`
+	Accessor   string `json:"accessor"`
+	Line       int    `json:"line"`
+	Column     int    `json:"column"`
+	Expression string `json:"expression"`
+	Status     string `json:"status"`
+}
+
+func TestOwnedHandleInventory(t *testing.T) {
+	root := filepath.Join("..", "..")
+	got, err := scanOwnedHandleSites(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fixturePath := filepath.Join("testdata", "owned_handle_inventory.json")
+	if os.Getenv("WACLI_UPDATE_OWNED_HANDLE_INVENTORY") == "1" {
+		data, err := json.MarshalIndent(got, "", "  ")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(fixturePath, append(data, '\n'), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		t.Logf("updated %s with %d sites", fixturePath, len(got))
+		return
+	}
+	data, err := os.ReadFile(fixturePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var want []ownedHandleSite
+	if err := json.Unmarshal(data, &want); err != nil {
+		t.Fatal(err)
+	}
+	if len(want) != len(got) {
+		t.Fatalf("owned-handle inventory count changed: fixture=%d source=%d; review additions and deletions, then regenerate with WACLI_UPDATE_OWNED_HANDLE_INVENTORY=1", len(want), len(got))
+	}
+	for i := range want {
+		if want[i] != got[i] {
+			t.Errorf("owned-handle inventory drift at index %d:\nfixture: %+v\nsource:  %+v", i, want[i], got[i])
+		}
+		if want[i].Status != "raw_escape" {
+			t.Errorf("%s has unsupported status %q; every syntactic site remains unproven until separately reviewed", want[i].ID, want[i].Status)
+		}
+	}
+}
+
+func TestOwnedHandleInventorySyntheticSyntax(t *testing.T) {
+	root := t.TempDir()
+	source := `package probe
+var global = a.DB()
+func f() {
+    // a.WA() is not a call in the AST.
+    _ = "a.DB()"
+    _ = a.WA // method values remain an explicit inventory limitation
+    _ = a.DB()
+    go func() { a.WA(); a.DB() }()
+}
+`
+	if err := os.WriteFile(filepath.Join(root, "probe.go"), []byte(source), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, "ignored_test.go"), []byte("not valid Go"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	sites, err := scanOwnedHandleSites(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(sites) != 4 {
+		t.Fatalf("expected four real calls, got %+v", sites)
+	}
+	if sites[0].Function != "(file scope)" || sites[2].Function != "f" || sites[2].Accessor != "WA" {
+		t.Fatalf("lost file or nested callback ownership: %+v", sites)
+	}
+	if sites[1].ID == sites[3].ID || sites[3].ID != "probe.go:f:DB:occurrence-2" {
+		t.Fatalf("repeated accessors lost identity: %+v", sites)
+	}
+	for _, site := range sites {
+		if site.Status != "raw_escape" {
+			t.Fatalf("syntactic inventory approved ownership: %+v", site)
+		}
+	}
+}
+
+func scanOwnedHandleSites(root string) ([]ownedHandleSite, error) {
+	var sites []ownedHandleSite
+	fset := token.NewFileSet()
+	err := filepath.WalkDir(root, func(path string, entry fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if entry.IsDir() {
+			if entry.Name() == ".git" || entry.Name() == "vendor" {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if !strings.HasSuffix(path, ".go") || strings.HasSuffix(path, "_test.go") {
+			return nil
+		}
+		file, err := parser.ParseFile(fset, path, nil, parser.ParseComments)
+		if err != nil {
+			return err
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		rel = filepath.ToSlash(rel)
+		var funcs []*ast.FuncDecl
+		for _, decl := range file.Decls {
+			if fn, ok := decl.(*ast.FuncDecl); ok && fn.Body != nil {
+				funcs = append(funcs, fn)
+			}
+		}
+		ast.Inspect(file, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok || len(call.Args) != 0 {
+				return true
+			}
+			sel, ok := call.Fun.(*ast.SelectorExpr)
+			if !ok || (sel.Sel.Name != "DB" && sel.Sel.Name != "WA") {
+				return true
+			}
+			fn := "(file scope)"
+			for _, candidate := range funcs {
+				if candidate.Pos() <= call.Pos() && call.End() <= candidate.End() {
+					fn = candidate.Name.Name
+					break
+				}
+			}
+			var expr bytes.Buffer
+			err := format.Node(&expr, fset, call)
+			if err != nil {
+				return true
+			}
+			pos := fset.Position(call.Pos())
+			sites = append(sites, ownedHandleSite{Path: rel, Function: fn, Accessor: sel.Sel.Name, Line: pos.Line, Column: pos.Column, Expression: expr.String(), Status: "raw_escape"})
+			return true
+		})
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	sort.Slice(sites, func(i, j int) bool {
+		if sites[i].Path != sites[j].Path {
+			return sites[i].Path < sites[j].Path
+		}
+		if sites[i].Line != sites[j].Line {
+			return sites[i].Line < sites[j].Line
+		}
+		return sites[i].Column < sites[j].Column
+	})
+	occurrence := make(map[string]int)
+	for i := range sites {
+		key := sites[i].Path + ":" + sites[i].Function + ":" + sites[i].Accessor
+		occurrence[key]++
+		sites[i].ID = fmt.Sprintf("%s:%s:%s:occurrence-%d", sites[i].Path, sites[i].Function, sites[i].Accessor, occurrence[key])
+	}
+	return sites, nil
+}
