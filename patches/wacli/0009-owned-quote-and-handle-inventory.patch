@@ -0,0 +1,101 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/openclaw/wacli/internal/app"
+	"github.com/openclaw/wacli/internal/store"
+	"go.mau.fi/whatsmeow/types"
+)
+
+// A zero OwnedWA deliberately has no client: any attempted client invocation
+// panics. Revocation must be reported by OwnedDB before the client can be used.
+// Raw accessors panic independently, catching accidental production fallback.
+type ownedQuoteRoute struct{ owner *app.App }
+
+func (*ownedQuoteRoute) WA() app.WAClient                              { panic("raw WA accessor reached") }
+func (*ownedQuoteRoute) DB() *store.DB                                 { panic("raw DB accessor reached") }
+func (*ownedQuoteRoute) OwnedWA(context.Context) (*app.OwnedWA, error) { return &app.OwnedWA{}, nil }
+func (r *ownedQuoteRoute) OwnedDB(ctx context.Context) (*app.OwnedDB, error) {
+	return r.owner.OwnedDB(ctx)
+}
+
+func TestOwnedQuoteFileRouteRefusesWithoutRawOrClientEffects(t *testing.T) {
+	for _, mode := range []string{"finished", "missing", "foreign", "canceled", "sealed"} {
+		t.Run(mode, func(t *testing.T) {
+			a, err := app.New(app.Options{StoreDir: t.TempDir()})
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(a.Close)
+			ctx, finish, err := a.BeginScopedOperation(context.Background())
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer finish(nil)
+			use := ctx
+			switch mode {
+			case "finished":
+				finish(nil)
+			case "missing":
+				use = context.Background()
+			case "foreign":
+				other := &app.App{}
+				var end func(error)
+				use, end, err = other.BeginScopedOperation(context.Background())
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer end(nil)
+			case "canceled":
+				var cancel context.CancelFunc
+				use, cancel = context.WithCancel(ctx)
+				cancel()
+			case "sealed":
+				finish(nil)
+				if held, err := a.BeginDrain(context.Background()); held != nil || !errors.Is(err, app.ErrDrainCoverageIncomplete) {
+					t.Fatalf("seal: %v %v", held, err)
+				}
+			}
+			// Missing file is intentional: admission must refuse even before reading it.
+			_, err = sendFile(use, &ownedQuoteRoute{owner: a}, types.JID{User: "synthetic", Server: types.DefaultUserServer}, "not-opened", sendFileOptions{replyTo: "synthetic-quote"})
+			if !errors.Is(err, app.ErrHandleRevoked) {
+				t.Fatalf("owned route failed to refuse before effects: %v", err)
+			}
+		})
+	}
+}
+
+// Each partial adapter panics if any accessor is invoked: facet completeness
+// must be checked before either owned admission or raw fallback is attempted.
+type ownedQuotePartialWA struct{}
+
+func (ownedQuotePartialWA) WA() app.WAClient { panic("raw WA reached") }
+func (ownedQuotePartialWA) DB() *store.DB    { panic("raw DB reached") }
+func (ownedQuotePartialWA) OwnedWA(context.Context) (*app.OwnedWA, error) {
+	panic("partial OwnedWA reached")
+}
+
+type ownedQuotePartialDB struct{}
+
+func (ownedQuotePartialDB) WA() app.WAClient { panic("raw WA reached") }
+func (ownedQuotePartialDB) DB() *store.DB    { panic("raw DB reached") }
+func (ownedQuotePartialDB) OwnedDB(context.Context) (*app.OwnedDB, error) {
+	panic("partial OwnedDB reached")
+}
+
+func TestOwnedQuotePartialFacadesRefuseBeforeEffects(t *testing.T) {
+	for _, a := range []interface {
+		WA() app.WAClient
+		DB() *store.DB
+	}{ownedQuotePartialWA{}, ownedQuotePartialDB{}} {
+		if _, err := sendFile(context.Background(), a, types.JID{}, "not-opened", sendFileOptions{replyTo: "quote"}); !errors.Is(err, app.ErrHandleRevoked) {
+			t.Fatalf("file mixed facet: %v", err)
+		}
+		if _, err := sendSticker(context.Background(), a, types.JID{}, "not-opened", sendStickerOptions{replyTo: "quote"}); !errors.Is(err, app.ErrHandleRevoked) {
+			t.Fatalf("sticker mixed facet: %v", err)
+		}
+	}
+}
