--- a/internal/app/owned_db.go
+++ b/internal/app/owned_db.go
@@ -11 +11,7 @@ import (
-// OwnedDB is the deliberately limited metadata-write facade used by file send.
+// ownedQuoteReader is private; callers cannot supply or borrow a raw DB through it.
+type ownedQuoteReader interface {
+	GetMessage(string, string) (store.Message, error)
+	GetMediaDownloadInfo(string, string) (store.MediaDownloadInfo, error)
+}
+
+// OwnedDB is the deliberately limited metadata and quote facade used by file send.
@@ -15,2 +21,3 @@ type OwnedDB struct {
-	db  *store.DB
-	app *App
+	db    *store.DB
+	app   *App
+	quote ownedQuoteReader
@@ -29 +36 @@ func (a *App) OwnedDB(ctx context.Context) (*OwnedDB, error) {
-	return &OwnedDB{db: a.db, app: a}, nil
+	return &OwnedDB{db: a.db, app: a, quote: a.db}, nil
@@ -42,0 +50,21 @@ func (d *OwnedDB) effect(ctx context.Context) (context.Context, func(error), err
+// GetMessage performs the narrow read needed to construct a quoted reply.
+// Like metadata writes, the lookup is covered by a per-invocation child lease.
+func (d *OwnedDB) GetMessage(ctx context.Context, chatJID, msgID string) (msg store.Message, err error) {
+	_, finish, err := d.effect(ctx)
+	if err != nil {
+		return store.Message{}, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return d.quote.GetMessage(chatJID, msgID)
+}
+
+// GetMediaDownloadInfo performs the companion read needed when quoting media.
+func (d *OwnedDB) GetMediaDownloadInfo(ctx context.Context, chatJID, msgID string) (info store.MediaDownloadInfo, err error) {
+	_, finish, err := d.effect(ctx)
+	if err != nil {
+		return store.MediaDownloadInfo{}, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return d.quote.GetMediaDownloadInfo(chatJID, msgID)
+}
