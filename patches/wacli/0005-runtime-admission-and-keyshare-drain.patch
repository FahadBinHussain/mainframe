+++ b/internal/app/admission_boundary_test.go
@@ -0,0 +1,66 @@
+package app
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestClosePreventsLazySessionReopen(t *testing.T) {
+	a, err := New(Options{StoreDir: t.TempDir()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := a.CloseWithError(); err != nil {
+		t.Fatal(err)
+	}
+	if err := a.OpenWA(); !errors.Is(err, ErrClosed) {
+		t.Fatalf("OpenWA after Close error = %v, want ErrClosed", err)
+	}
+	if _, err := a.ReadOnlyResolver(); !errors.Is(err, ErrClosed) {
+		t.Fatalf("ReadOnlyResolver after Close error = %v, want ErrClosed", err)
+	}
+}
+
+func TestCloseConcurrentWithLazyAdmission(t *testing.T) {
+	a, err := New(Options{StoreDir: t.TempDir()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	const callers = 16
+	results := make(chan error, callers)
+	start := make(chan struct{})
+	for i := 0; i < callers; i++ {
+		go func() {
+			<-start
+			results <- a.CloseWithError()
+		}()
+	}
+	admitDone := make(chan error, 1)
+	go func() {
+		<-start
+		admitDone <- a.OpenWA()
+	}()
+	close(start)
+	var receipt error
+	for i := 0; i < callers; i++ {
+		err := <-results
+		if i == 0 {
+			receipt = err
+		} else if (err == nil) != (receipt == nil) || (err != nil && receipt != nil && err.Error() != receipt.Error()) {
+			t.Fatalf("close call %d returned %v, first returned %v", i, err, receipt)
+		}
+	}
+	if err := <-admitDone; err != nil && !errors.Is(err, ErrClosed) {
+		t.Fatalf("concurrent lazy admission error = %v, want nil or ErrClosed", err)
+	}
+}
+
+func TestCloseZeroValueApp(t *testing.T) {
+	a := &App{}
+	if err := a.CloseWithError(); err != nil {
+		t.Fatal(err)
+	}
+	if err := a.CloseWithError(); err != nil {
+		t.Fatal(err)
+	}
+}
