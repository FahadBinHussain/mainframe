--- /dev/null
+++ b/internal/app/close_receipt_test.go
@@ -0,0 +1,77 @@
+package app
+
+import (
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type receiptWA struct {
+	WAClient
+	started chan struct{}
+	release chan struct{}
+	calls   atomic.Int32
+	failure error
+}
+
+func (w *receiptWA) Disconnect() {}
+func (w *receiptWA) Close()      { panic("error-returning close must be preferred") }
+func (w *receiptWA) CloseWithError() error {
+	w.calls.Add(1)
+	close(w.started)
+	<-w.release
+	return w.failure
+}
+
+func TestCloseReceiptSealsLazyAdmissionAndRetainsSessionError(t *testing.T) {
+	a, err := New(Options{StoreDir: t.TempDir()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	failure := errors.New("synthetic session persistence failure")
+	w := &receiptWA{started: make(chan struct{}), release: make(chan struct{}), failure: failure}
+	a.wa = w
+	var once sync.Once
+	release := func() { once.Do(func() { close(w.release) }) }
+	t.Cleanup(func() { release(); a.Close() })
+	const callers = 8
+	results := make(chan error, callers)
+	for range callers {
+		go func() { results <- a.CloseWithError() }()
+	}
+	select {
+	case <-w.started:
+	case <-time.After(5 * time.Second):
+		t.Fatal("close did not reach session boundary")
+	}
+	if err := a.OpenWA(); !errors.Is(err, ErrClosed) {
+		t.Fatalf("lazy session opened during close: %v", err)
+	}
+	if _, err := a.ReadOnlyResolver(); !errors.Is(err, ErrClosed) {
+		t.Fatalf("lazy resolver opened during close: %v", err)
+	}
+	select {
+	case err := <-results:
+		t.Fatalf("close returned before session drain: %v", err)
+	default:
+	}
+	release()
+	for range callers {
+		select {
+		case err := <-results:
+			if !errors.Is(err, failure) {
+				t.Fatalf("close lost session error: %v", err)
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatal("concurrent close did not return")
+		}
+	}
+	if w.calls.Load() != 1 {
+		t.Fatalf("session closed %d times", w.calls.Load())
+	}
+	if !errors.Is(a.CloseWithError(), failure) {
+		t.Fatal("later caller lost close error")
+	}
+}
