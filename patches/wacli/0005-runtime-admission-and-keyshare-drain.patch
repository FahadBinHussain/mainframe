+
+// CloseWithError joins accepted app-state key-share workers, including the
+// synchronous application key-store continuation, before closing session SQL.
+// Other SDK producer families are NOT joined; this is not a capture receipt.
+func (c *Client) CloseWithError() error {
+	c.closeOnce.Do(func() {
+		c.mu.Lock()
+		cli, container := c.client, c.container
+		// Revoke new wrapper borrows before waiting, without holding mu across
+		// SDK callbacks. Already-borrowed SDK handles are not a fenced frontier.
+		c.client, c.container = nil, nil
+		c.mu.Unlock()
+		if cli != nil {
+			cli.Disconnect()
+			c.closeErr = errors.Join(c.closeErr, cli.DrainAppStateKeyShares(context.Background()))
+		}
+		if container != nil {
+			c.closeErr = errors.Join(c.closeErr, container.Close())
+		}
+	})
+	return c.closeErr
