+package app
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+type contextCallbackFakeWA struct {
+	*fakeWA
+	handler func(context.Context, any) error
+}
+
+func (f *contextCallbackFakeWA) AddEventHandlerWithContext(handler func(context.Context, any) error) uint32 {
+	f.handler = handler
+	return 1
+}
+
+func TestAddEventHandlerPreservesSDKCallbackContext(t *testing.T) {
+	fake := &contextCallbackFakeWA{fakeWA: &fakeWA{}}
+	a := &App{wa: fake}
+	parent := context.WithValue(context.Background(), struct{}{}, "sdk-lineage")
+	var got context.Context
+	a.addEventHandler(context.Background(), func(callbackCtx context.Context, _ any) {
+		got = callbackCtx
+	})
+	if fake.handler == nil {
+		t.Fatal("context-aware registration was not selected")
+	}
+	if err := fake.handler(parent, struct{}{}); err != nil {
+		t.Fatal(err)
+	}
+	if got.Value(struct{}{}) != "sdk-lineage" || got.Value(operationScopeKey{}) == nil {
+		t.Fatalf("callback context = %v, want SDK lineage", got)
+	}
+}
+
+func TestDrainApplicationCallbackChildAfterSeal(t *testing.T) {
+	fake := &contextCallbackFakeWA{fakeWA: &fakeWA{}}
+	a := &App{wa: fake}
+	var childFinish func(error)
+	a.addEventHandler(context.Background(), func(callbackCtx context.Context, _ any) {
+		a.operations.cancelAccepted()
+		_, finish, err := RegisterOperationChild(callbackCtx)
+		if err != nil {
+			t.Fatalf("accepted callback child rejected after seal: %v", err)
+		}
+		childFinish = finish
+	})
+	if err := fake.handler(context.Background(), "synthetic event"); err != nil {
+		t.Fatal(err)
+	}
+	defer childFinish(nil)
+	wait, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+	if held, err := a.BeginDrain(wait); held != nil || !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("callback child escaped join: %v %v", held, err)
+	}
+	failure := errors.New("synthetic callback continuation failed")
+	childFinish(failure)
+	if held, err := a.BeginDrain(context.Background()); held != nil || !errors.Is(err, failure) || !errors.Is(err, ErrDrainCoverageIncomplete) {
+		t.Fatalf("callback error lost: %v %v", held, err)
+	}
+	if err := fake.handler(context.Background(), "late synthetic event"); !errors.Is(err, ErrOperationSealed) {
+		t.Fatalf("late callback not rejected before effects: %v", err)
+	}
+}
