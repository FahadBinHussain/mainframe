+	if err != nil || value != 7 || attempts != 2 {
+		t.Fatalf("retry result: value=%d attempts=%d err=%v", value, attempts, err)
+	}
+	held, drainErr := a.BeginDrain(context.Background())
+	if held != nil || !errors.Is(drainErr, failure) || !errors.Is(drainErr, app.ErrDrainCoverageIncomplete) {
+		t.Fatalf("successful retry erased failure evidence: held=%v err=%v", held, drainErr)
+	}
+}
