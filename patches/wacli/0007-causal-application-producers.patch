+				}
+				panic(recovered)
+			}
+			finish(nil)
+		}()
+		handler(ownedCtx, evt)
+		return nil
+	}
+	if h, ok := a.wa.(contextEventWA); ok {
+		return h.AddEventHandlerWithContext(invoke)
+	}
+	return a.wa.AddEventHandler(func(evt any) { _ = invoke(ctx, evt) })
+}
