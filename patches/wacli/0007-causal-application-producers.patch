+		ctx, finish, err := a.BeginScopedOperation(context.Background())
+		if err != nil {
+			t.Fatal(err)
+		}
+		child := make(chan func(error), 1)
+		var wg sync.WaitGroup
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, end, err := RegisterOperationChild(ctx)
+			if err != nil && !errors.Is(err, ErrOperationScopeDone) {
