+package app
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestDrainCausalGrandchildSurvivesAncestorFinish(t *testing.T) {
+	a := &App{}
+	ctx, finish, err := a.BeginScopedOperation(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer finish(nil)
+	canceled, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err = a.BeginDrain(canceled)
+	if !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	childCtx, childFinish, err := RegisterOperationChild(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer childFinish(nil)
+	finish(nil)
+	if _, _, err := RegisterOperationChild(ctx); !errors.Is(err, ErrOperationScopeDone) {
+		t.Fatalf("finished parent admitted: %v", err)
+	}
+	_, grandFinish, err := RegisterOperationChild(childCtx)
+	if err != nil {
+		t.Fatalf("live child could not register grandchild: %v", err)
+	}
+	defer grandFinish(nil)
+	childFinish(nil)
+	done := make(chan error, 1)
+	go func() {
+		held, err := a.BeginDrain(context.Background())
+		if held != nil {
+			done <- errors.New("incomplete app returned held boundary")
+			return
+		}
+		done <- err
+	}()
+	select {
+	case <-done:
+		t.Fatal("grandchild escaped app join")
+	default:
+	}
+	failure := errors.New("synthetic multi-store descendant failure")
+	grandFinish(failure)
+	if err := <-done; !errors.Is(err, failure) || !errors.Is(err, ErrDrainCoverageIncomplete) {
+		t.Fatalf("failure lost: %v", err)
+	}
+	if _, _, err := a.BeginScopedOperation(context.Background()); !errors.Is(err, ErrOperationSealed) {
+		t.Fatal(err)
+	}
+}
+
+func TestDrainCloseCancelsChildAfterParentReturned(t *testing.T) {
+	a := &App{}
+	ctx, finish, err := a.BeginScopedOperation(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	childCtx, childFinish, err := RegisterOperationChild(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer childFinish(nil)
+	finish(nil)
+	a.operations.cancelAccepted()
+	select {
+	case <-childCtx.Done():
+	case <-time.After(time.Second):
+		t.Fatal("returned parent's live descendant lost cancellation ownership")
+	}
+	done := make(chan error, 1)
+	go func() { done <- a.CloseWithError() }()
+	select {
+	case <-done:
+		t.Fatal("close escaped actual descendant lifetime")
+	default:
+	}
+	childFinish(context.Canceled)
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("close did not join descendant")
+	}
+}
+
+func TestDrainOperationChildFinishRaceHasStableZero(t *testing.T) {
+	for range 100 {
+		a := &App{}
+		ctx, finish, err := a.BeginScopedOperation(context.Background())
+		if err != nil {
+			t.Fatal(err)
+		}
+		child := make(chan func(error), 1)
+		var wg sync.WaitGroup
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, end, err := RegisterOperationChild(ctx)
+			if err != nil && !errors.Is(err, ErrOperationScopeDone) {
+				t.Errorf("child admission: %v", err)
+			}
+			child <- end
+		}()
+		finish(nil)
+		wg.Wait()
+		if end := <-child; end != nil {
+			end(nil)
+		}
+		if err := a.operations.drain(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+		a.operations.mu.Lock()
+		active := a.operations.active
+		a.operations.mu.Unlock()
+		if active != 0 {
+			t.Fatalf("unstable zero: %d", active)
+		}
+	}
+}
