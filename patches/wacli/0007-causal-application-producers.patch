+// runOwnedSendOperation binds retries and their potentially long-lived
+// attempt workers to the application's operation scope. Missing scope
+// authority is a hard error: sending must not proceed unowned.
+func runOwnedSendOperation[T any](
+	ctx context.Context,
+	owner any,
+	reconnect func(context.Context) error,
+	op func(context.Context) (T, error),
+) (result T, err error) {
+	scoped, ok := owner.(interface {
+		BeginScopedOperation(context.Context) (context.Context, func(error), error)
+	})
+	if !ok {
+		return result, app.ErrOperationScopeMissing
+	}
+	ownedCtx, finish, beginErr := scoped.BeginScopedOperation(ctx)
+	if beginErr != nil {
+		return result, beginErr
+	}
+	defer func() { finish(err) }()
+	return runSendOperation(ownedCtx, reconnect, op)
+}
