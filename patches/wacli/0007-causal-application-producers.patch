+// A bounded attempt may return while its registered worker is still running.
+// The command scope alone is not its lifetime; runSendAttempt owns a child.
+func sendOwnedPresenceWithRetry(ctx context.Context, a *app.App, reconnect func(context.Context) error, send func(context.Context) error) (err error) {
