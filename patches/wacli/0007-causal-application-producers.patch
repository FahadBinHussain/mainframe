+// AddEventHandlerWithContext registers a handler that receives the SDK's
+// accepted causal context. It is additive; callers that only need the legacy
+// callback API can continue using AddEventHandler.
+func (c *Client) AddEventHandlerWithContext(handler func(context.Context, any) error) uint32 {
+	c.mu.Lock()
+	cli := c.client
+	c.mu.Unlock()
+	if cli == nil {
+		return 0
+	}
+	if contextHandler, ok := any(cli).(interface {
+		AddEventHandlerWithContext(func(context.Context, any) error) uint32
+	}); ok {
+		return contextHandler.AddEventHandlerWithContext(handler)
+	}
+	// Older SDKs have no causal context; preserve the additive wrapper API.
+	return cli.AddEventHandler(func(evt any) { _ = handler(context.Background(), evt) })
+}
