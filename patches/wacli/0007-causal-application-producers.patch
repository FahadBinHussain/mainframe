+// contextEventWA is optional so existing fakes and integrations remain
+// source-compatible. Real whatsmeow clients preserve the SDK callback lineage.
+type contextEventWA interface {
+	AddEventHandlerWithContext(func(context.Context, any) error) uint32
+}
+
+// addEventHandler prefers the context-aware SDK registration. The legacy
+// fallback keeps synchronous callback effects within the SDK callback; it cannot
+// manufacture lineage for SDKs that do not expose it.
+func (a *App) addEventHandler(ctx context.Context, handler func(context.Context, any)) uint32 {
+	invoke := func(callbackCtx context.Context, evt any) error {
+		ownedCtx, finish, err := a.BeginScopedOperation(callbackCtx)
+		if err != nil {
+			return err
+		}
+		defer func() {
+			if recovered := recover(); recovered != nil {
+				if cause, ok := recovered.(error); ok {
+					finish(fmt.Errorf("application callback panic: %w", cause))
+				} else {
+					finish(fmt.Errorf("application callback panic: %v", recovered))
+				}
+				panic(recovered)
+			}
+			finish(nil)
+		}()
+		handler(ownedCtx, evt)
+		return nil
+	}
+	if h, ok := a.wa.(contextEventWA); ok {
+		return h.AddEventHandlerWithContext(invoke)
+	}
+	return a.wa.AddEventHandler(func(evt any) { _ = invoke(ctx, evt) })
+}
