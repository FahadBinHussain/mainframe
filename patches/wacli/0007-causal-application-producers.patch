@@ -0,0 +1,152 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/openclaw/wacli/internal/app"
+)
+
+type unscopedSendOwner struct {
+	finished bool
+}
+
+func (o *unscopedSendOwner) BeginScopedOperation(ctx context.Context) (context.Context, func(error), error) {
+	return ctx, func(error) { o.finished = true }, nil
+}
+
+func TestDrainOwnedSendMissingOwnerRefusesBeforeEffects(t *testing.T) {
+	var operations, reconnects int
+	_, err := runOwnedSendOperation(context.Background(), struct{}{}, func(context.Context) error {
+		reconnects++
+		return nil
+	}, func(context.Context) (int, error) {
+		operations++
+		return 1, nil
+	})
+	if !errors.Is(err, app.ErrOperationScopeMissing) {
+		t.Fatalf("missing owner error = %v, want %v", err, app.ErrOperationScopeMissing)
+	}
+	if operations != 0 || reconnects != 0 {
+		t.Fatalf("unowned send had effects: operations=%d reconnects=%d", operations, reconnects)
+	}
+}
+
+func TestDrainOwnedSendUnscopedOwnerRefusesBeforeEffects(t *testing.T) {
+	owner := &unscopedSendOwner{}
+	var operations, reconnects int
+	_, err := runOwnedSendOperation(context.Background(), owner, func(context.Context) error {
+		reconnects++
+		return nil
+	}, func(context.Context) (int, error) {
+		operations++
+		return 1, nil
+	})
+	if !errors.Is(err, app.ErrOperationScopeMissing) {
+		t.Fatalf("unscoped owner error = %v, want %v", err, app.ErrOperationScopeMissing)
+	}
+	if !owner.finished {
+		t.Fatal("owner scope was not finished")
+	}
+	if operations != 0 || reconnects != 0 {
+		t.Fatalf("unscoped send had effects: operations=%d reconnects=%d", operations, reconnects)
+	}
+}
+
+func TestDrainSendAttemptOutlivesTimeoutAndRetainsFailure(t *testing.T) {
+	a := &app.App{}
+	ctx, finish, err := a.BeginScopedOperation(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer finish(nil)
+	entered, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	unblock := func() { once.Do(func() { close(release) }) }
+	t.Cleanup(unblock)
+	failure := errors.New("synthetic final send persistence failure")
+	result := make(chan error, 1)
+	go func() {
+		_, err := runSendAttempt(ctx, 20*time.Millisecond, func(context.Context) (int, error) { close(entered); <-release; return 0, failure })
+		result <- err
+	}()
+	<-entered
+	select {
+	case err := <-result:
+		if err == nil {
+			t.Fatal("timeout reported success")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("caller did not time out")
+	}
+	finish(nil)
+	wait, stop := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer stop()
+	held, err := a.BeginDrain(wait)
+	if held != nil || !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("drain escaped actual send worker: %v %v", held, err)
+	}
+	unblock()
+	held, err = a.BeginDrain(context.Background())
+	if held != nil || !errors.Is(err, failure) || !errors.Is(err, app.ErrDrainCoverageIncomplete) {
+		t.Fatalf("send worker error lost: %v %v", held, err)
+	}
+}
+
+func TestDrainOwnedSendPanicIsRetained(t *testing.T) {
+	a := &app.App{}
+	failure := errors.New("synthetic send worker panic")
+	_, err := runOwnedSendOperation(context.Background(), a, func(context.Context) error { return nil }, func(context.Context) (int, error) { panic(failure) })
+	if err == nil {
+		t.Fatal("panic reported success")
+	}
+	held, drainErr := a.BeginDrain(context.Background())
+	if held != nil || !errors.Is(drainErr, app.ErrDrainCoverageIncomplete) || drainErr == nil {
+		t.Fatalf("panic escaped refusal: %v %v", held, drainErr)
+	}
+}
+
+func TestDrainCanceledSendAttemptDoesNotLaunchEffects(t *testing.T) {
+	a := &app.App{}
+	ctx, finish, err := a.BeginScopedOperation(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer finish(nil)
+	canceled, cancel := context.WithCancel(ctx)
+	cancel()
+	var effects int
+	_, err = runSendAttempt(canceled, time.Second, func(context.Context) (int, error) {
+		effects++
+		return 1, nil
+	})
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled send attempt error = %v, want context canceled", err)
+	}
+	if effects != 0 {
+		t.Fatalf("canceled send attempt launched effects: %d", effects)
+	}
+}
+
+func TestDrainRetrySuccessDoesNotEraseAttemptFailure(t *testing.T) {
+	a := &app.App{}
+	failure := errors.New("failed to get device list: synthetic uncertain attempt")
+	attempts := 0
+	value, err := runOwnedSendOperation(context.Background(), a, func(context.Context) error { return nil }, func(context.Context) (int, error) {
+		attempts++
+		if attempts == 1 {
