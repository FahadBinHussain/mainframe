+++ b/internal/app/admission_race_test.go
@@ -0,0 +1,83 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestOperationAdmissionSealRaceHasNoLateAcceptance(t *testing.T) {
+	var admission operationAdmission
+	const callers = 64
+	start := make(chan struct{})
+	accepted := make(chan func(error), callers)
+	sealed := make(chan struct{}, callers)
+	var wg sync.WaitGroup
+	for i := 0; i < callers; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			finish, err := admission.begin(context.Background())
+			if errors.Is(err, ErrOperationSealed) {
+				sealed <- struct{}{}
+				return
+			}
+			if err != nil {
+				t.Errorf("begin: %v", err)
+				return
+			}
+			accepted <- finish
+		}()
+	}
+	close(start)
+	admission.cancelAccepted()
+	wg.Wait()
+	close(accepted)
+	for finish := range accepted {
+		finish(nil)
+	}
+	if _, err := admission.begin(context.Background()); !errors.Is(err, ErrOperationSealed) {
+		t.Fatalf("post-seal admission: %v", err)
+	}
+	if err := admission.drain(context.Background()); err != nil {
+		t.Fatalf("drain after race: %v", err)
+	}
+}
+
+func TestAcceptedOperationMayJoinDescendantBeforeDrain(t *testing.T) {
+	var admission operationAdmission
+	finish, err := admission.begin(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	childDone := make(chan struct{})
+	drainDone := make(chan error, 1)
+	go func() { drainDone <- admission.drain(context.Background()) }()
+	select {
+	case err := <-drainDone:
+		t.Fatalf("drain returned before accepted descendant joined: %v", err)
+	case <-time.After(10 * time.Millisecond):
+	}
+	go func() {
+		// A callback/worker descendant is covered by the parent's accepted
+		// operation until the owner finishes its frontier.
+		close(childDone)
+		finish(nil)
+	}()
+	select {
+	case <-childDone:
+	case <-time.After(time.Second):
+		t.Fatal("accepted descendant did not run")
+	}
+	select {
+	case err := <-drainDone:
+		if err != nil {
+			t.Fatalf("drain: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("drain did not join accepted descendant")
+	}
+}
