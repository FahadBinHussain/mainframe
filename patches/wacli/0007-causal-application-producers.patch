diff --git a/internal/app/worker_lifecycle_test.go b/internal/app/worker_lifecycle_test.go
new file mode 100644
index 0000000..b91f391
--- /dev/null
+++ b/internal/app/worker_lifecycle_test.go
@@ -0,0 +1,105 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/openclaw/wacli/internal/wa"
+)
+
+func TestDrainWorkerLifecycleChildFinishesAfterReturn(t *testing.T) {
+	a, err := New(Options{StoreDir: t.TempDir()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	ctx, rootFinish, err := a.BeginCancelableOperation(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	childCtx, childFinish, err := RegisterOperationChild(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	wg.Add(1)
+	returned := make(chan struct{})
+	go func() {
+		defer wg.Done()
+		defer childFinish(nil)
+		<-childCtx.Done()
+		close(returned)
+	}()
+	a.operations.cancelAccepted()
+	select {
+	case <-returned:
+	case <-t.Context().Done():
+		t.Fatal("worker did not observe cancellation")
+	}
+	wg.Wait()
+	rootFinish(nil)
+	if _, _, err := a.BeginCancelableOperation(context.Background()); !errors.Is(err, ErrOperationSealed) {
+		t.Fatalf("late admission = %v", err)
+	}
+}
+
+func TestDrainMediaWorkerRecoveredPanicIsFailure(t *testing.T) {
+	a := &App{}
+	queue := newMediaQueue(1)
+	wait, cancel, err := a.runMediaWorkers(context.Background(), queue, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer cancel()
+	// A nil synthetic database intentionally panics inside the real job path.
+	queue.enqueue(context.Background(), mediaJob{chatJID: "synthetic", msgID: "synthetic"})
+	ctx, stop := context.WithTimeout(context.Background(), time.Second)
+	defer stop()
+	if !queue.waitIdle(ctx) {
+		t.Fatal("synthetic job did not finish")
+	}
+	cancel()
+	wait()
+	held, err := a.BeginDrain(context.Background())
+	var incomplete *DrainIncompleteError
+	if held != nil || !errors.As(err, &incomplete) || incomplete.Cause == nil {
+		t.Fatalf("recovered media panic became success: %v %v", held, err)
+	}
+}
+
+func TestDrainWebhookFailuresAreNotLogOnly(t *testing.T) {
+	for _, panics := range []bool{false, true} {
+		t.Run(map[bool]string{false: "error", true: "panic"}[panics], func(t *testing.T) {
+			old := syncWebhookPrivateHTTPClient
+			defer func() { syncWebhookPrivateHTTPClient = old }()
+			entered := make(chan struct{}, 1)
+			syncWebhookPrivateHTTPClient = &http.Client{Transport: roundTripFunc(func(*http.Request) (*http.Response, error) {
+				entered <- struct{}{}
+				if panics {
+					panic("synthetic webhook panic")
+				}
+				return nil, errors.New("synthetic webhook failure; no network")
+			})}
+			a := &App{}
+			jobs := make(chan syncWebhookEvent)
+			stop := a.runSyncWebhookWorker(context.Background(), SyncOptions{WebhookURL: "https://example.invalid/synthetic", WebhookAllowPrivate: true}, jobs)
+			jobs <- syncWebhookEvent{Kind: SyncWebhookEventMessage, Message: wa.ParsedMessage{ID: "synthetic"}}
+			select {
+			case <-entered:
+			case <-time.After(time.Second):
+				t.Fatal("synthetic webhook not executed")
+			}
+			close(jobs)
+			stop()
+			held, err := a.BeginDrain(context.Background())
+			var incomplete *DrainIncompleteError
+			if held != nil || !errors.As(err, &incomplete) || incomplete.Cause == nil {
+				t.Fatalf("webhook failure became successful drain: %v %v", held, err)
+			}
+		})
+	}
+}
