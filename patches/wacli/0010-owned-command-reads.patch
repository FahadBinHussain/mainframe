@@ -0,0 +1,31 @@
+package main
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"testing"
+)
+
+// This is a narrow route regression, not whole-program ownership proof. Legacy
+// mutation helpers, output descriptors and direct application fields stay gaps.
+func TestOwnedCommandRoutesDoNotBorrowRawHandles(t *testing.T) {
+	for _, path := range []string{"messages_read.go", "messages_changes.go", "calls.go", "history.go", "store_stats.go"} {
+		fset := token.NewFileSet()
+		file, err := parser.ParseFile(fset, path, nil, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ast.Inspect(file, func(n ast.Node) bool {
+			sel, ok := n.(*ast.SelectorExpr)
+			if !ok {
+				return true
+			}
+			switch sel.Sel.Name {
+			case "DB", "WA", "LocalResolver", "ReadOnlyResolver":
+				t.Errorf("%s: migrated route borrows raw accessor/method value %s", fset.Position(sel.Pos()), sel.Sel.Name)
+			}
+			return true
+		})
+	}
+}
