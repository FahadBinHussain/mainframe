+func TestOwnedMessageReadsRefuseAfterScopeFinish(t *testing.T) {
+	a, _, ctx, finish := ownedMessageTestApp(t)
+	defer finish(nil)
+	reads, err := a.OwnedMessageReads(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	finish(nil)
+	_, err = reads.ListPage(ctx, "list", store.ListMessagesParams{Limit: 1}, "")
+	if !errors.Is(err, ErrHandleRevoked) {
+		t.Fatalf("read after finish = %v", err)
