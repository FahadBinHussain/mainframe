+func TestOwnedMessageReadsSealedRefusalHasZeroViewEffects(t *testing.T) {
+	a, _, ctx, finish := ownedMessageTestApp(t)
+	defer finish(nil)
+	reads, err := a.OwnedMessageReads(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	calls := 0
+	reads.viewProbe = func(context.Context) error { calls++; return nil }
+	finish(nil)
+	if held, err := a.BeginDrain(context.Background()); held != nil || !errors.Is(err, ErrDrainCoverageIncomplete) {
+		t.Fatalf("seal = %v %v", held, err)
+	}
+	for _, use := range []context.Context{ctx, context.Background()} {
+		operations := []struct {
+			name string
+			call func() error
+		}{
+			{"name", func() error { _, e := reads.ResolveMessageName(use, "Synthetic Contact", false); return e }},
+			{"filter", func() error { _, e := reads.ChatJIDFilter(use, "1234567"); return e }},
+			{"list", func() error { _, e := reads.ListPage(use, "list", store.ListMessagesParams{Limit: 1}, ""); return e }},
+			{"search", func() error {
+				_, _, e := reads.SearchPage(use, store.SearchMessagesParams{Query: "synthetic", Limit: 1}, "", 0, 0)
+				return e
+			}},
+			{"starred", func() error { _, _, e := reads.ListStarred(use, store.ListStarredMessagesParams{Limit: 1}); return e }},
+			{"message", func() error { _, e := reads.GetMessage(use, []string{"synthetic"}, "message"); return e }},
+			{"context", func() error { _, e := reads.MessageContext(use, []string{"synthetic"}, "message", 1, 1); return e }},
+			{"changes", func() error { _, e := reads.Changes(use, "", true, 1); return e }},
+			{"senders", func() error { _, e := reads.ResolveMessageSenderNames(use, nil); return e }},
