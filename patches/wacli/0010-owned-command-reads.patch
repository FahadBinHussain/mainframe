+func TestOwnedMessageReadsChatJIDFilterRefusesEveryInvalidContext(t *testing.T) {
+	for _, mode := range []string{"finished", "canceled", "foreign", "missing"} {
+		t.Run(mode, func(t *testing.T) {
+			a, _, parent, finish := ownedMessageTestApp(t)
+			defer finish(nil)
+			reads, err := a.OwnedMessageReads(parent)
+			if err != nil {
+				t.Fatal(err)
+			}
+			use := parent
+			var foreignFinish func(error)
+			switch mode {
+			case "finished":
+				finish(nil)
+			case "canceled":
+				var cancel context.CancelFunc
+				use, cancel = context.WithCancel(parent)
+				cancel()
+			case "foreign":
+				other := &App{}
+				var err error
+				use, foreignFinish, err = other.BeginScopedOperation(context.Background())
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer foreignFinish(nil)
+			case "missing":
+				use = context.Background()
+			}
+			if _, err := reads.ChatJIDFilter(use, "1234567"); !errors.Is(err, ErrHandleRevoked) {
+				t.Fatalf("%s ChatJIDFilter = %v", mode, err)
+			}
+		})
+	}
+}
+
+func TestOwnedMessageReadsChatJIDFilterJoinsBlockedInvocationAfterParentFinish(t *testing.T) {
+	a, _, parent, finish := ownedMessageTestApp(t)
+	defer finish(nil)
+	reads, err := a.OwnedMessageReads(parent)
+	if err != nil {
+		t.Fatal(err)
+	}
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	reads.viewProbe = func(ctx context.Context) error {
+		close(entered)
+		<-release
+		return nil
+	}
+	result := make(chan error, 1)
+	go func() {
+		_, err := reads.ChatJIDFilter(parent, "1234567")
+		result <- err
+	}()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("ChatJIDFilter did not enter admitted read view")
+	}
+	finish(nil)
+	drain := make(chan error, 1)
+	go func() { _, err := a.BeginDrain(context.Background()); drain <- err }()
+	select {
+	case err := <-drain:
+		t.Fatalf("drain escaped blocked child: %v", err)
+	case <-time.After(25 * time.Millisecond):
+	}
+	close(release)
+	if err := <-result; err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-drain:
+		if !errors.Is(err, ErrDrainCoverageIncomplete) {
+			t.Fatalf("drain result = %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("drain did not join ChatJIDFilter")
+	}
+}
