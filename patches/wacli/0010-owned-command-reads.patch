diff --git a/internal/app/owned_message_reads.go b/internal/app/owned_message_reads.go
new file mode 100644
index 0000000..e0af658
--- /dev/null
+++ b/internal/app/owned_message_reads.go
@@ -0,0 +1,360 @@
+package app
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/openclaw/wacli/internal/store"
+	"github.com/openclaw/wacli/internal/wa"
+	"go.mau.fi/whatsmeow/types"
+)
+
+// OwnedMessageReads is the command read facade. The database and resolver are
+// deliberately private; each method admits and leases its complete effect.
+type OwnedMessageReads struct {
+	db        *store.DB
+	app       *App
+	viewProbe func(context.Context) error
+}
+
+type OwnedSearchHitContext struct {
+	ChatJID  string          `json:"chat_jid"`
+	MsgID    string          `json:"msg_id"`
+	Messages []store.Message `json:"messages"`
+}
+
+func (a *App) OwnedMessageReads(ctx context.Context) (*OwnedMessageReads, error) {
+	if err := a.admitHandle(ctx); err != nil {
+		return nil, err
+	}
+	a.waMu.Lock()
+	closed, db := a.closed, a.db
+	a.waMu.Unlock()
+	if closed || db == nil {
+		return nil, ErrHandleRevoked
+	}
+	return &OwnedMessageReads{db: db, app: a}, nil
+}
+
+func (r *OwnedMessageReads) effect(ctx context.Context) (context.Context, func(error), error) {
+	if err := r.app.admitHandle(ctx); err != nil {
+		return nil, nil, err
+	}
+	child, finish, err := RegisterOperationChild(ctx)
+	if err != nil {
+		return nil, nil, errors.Join(ErrHandleRevoked, err)
+	}
+	return child, finish, nil
+}
+
+func (r *OwnedMessageReads) withView(ctx context.Context, fn func(context.Context, *store.DB) error) (err error) {
+	owned, finish, err := r.effect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return r.db.ReadView(func(view *store.DB) error {
+		if probe := r.viewProbe; probe != nil {
+			if err := probe(owned); err != nil {
+				return err
+			}
+		}
+		return fn(owned, view)
+	})
+}
+
+func (r *OwnedMessageReads) ResolveMessageName(ctx context.Context, input string, chats bool) (out string, err error) {
+	if input == "" {
+		return "", nil
+	}
+	jid, parseErr := wa.ParseUserOrJID(input)
+	if parseErr == nil {
+		return jid.String(), nil
+	}
+	explicit, numeric := strings.Contains(input, "@"), true
+	for _, c := range input {
+		if (c < '0' || c > '9') && !strings.ContainsRune("+ -()", c) {
+			numeric = false
+			break
+		}
+	}
+	if explicit || numeric {
+		return "", parseErr
+	}
+	err = r.withView(ctx, func(_ context.Context, db *store.DB) error {
+		out, err = db.ResolveMessageName(input, chats)
+		return err
+	})
+	return out, err
+}
+
+func (r *OwnedMessageReads) ChatJIDFilter(ctx context.Context, chat string) ([]string, error) {
+	chat = strings.TrimSpace(chat)
+	if chat == "" {
+		return nil, nil
+	}
+	var out []string
+	err := r.withView(ctx, func(child context.Context, db *store.DB) error {
+		resolved, err := localOwnedIdentifier(db, chat, true)
+		if err != nil {
+			return err
+		}
+		jid, err := wa.ParseUserOrJID(resolved)
+		if err != nil {
+			return err
+		}
+		jids := []types.JID{canonicalOwnedMessageJID(jid)}
+		if _, err := os.Stat(filepath.Join(r.app.opts.StoreDir, "session.db")); err != nil {
+			out = ownedJIDStrings(jids)
+			return nil
+		}
+		resolver, err := r.app.LocalResolver()
+		if err != nil {
+			out = ownedJIDStrings(jids)
+			return nil
+		}
+		switch jid.Server {
+		case types.DefaultUserServer:
+			jids = append(jids, canonicalOwnedMessageJID(resolver.ResolvePNToLID(child, jid)))
+		case types.HiddenUserServer:
+			jids = append(jids, canonicalOwnedMessageJID(resolver.ResolveLIDToPN(child, jid)))
+		}
+		out = ownedJIDStrings(jids)
+		return nil
+	})
+	return out, err
+}
+
+func (r *OwnedMessageReads) ListPage(ctx context.Context, command string, p store.ListMessagesParams, cursor string) (page store.MessagePage, err error) {
+	err = r.withView(ctx, func(c context.Context, db *store.DB) error {
+		page, err = db.ListMessagesPage(command, p, cursor)
+		if err == nil {
+			page.Messages = r.resolveNames(c, db, page.Messages)
+		}
+		return err
+	})
+	return
+}
+func (r *OwnedMessageReads) SearchPage(ctx context.Context, p store.SearchMessagesParams, cursor string, before, after int) (page store.MessagePage, contexts []OwnedSearchHitContext, err error) {
+	if before < 0 || after < 0 || before > 20 || after > 20 {
+		return page, nil, fmt.Errorf("context counts must be between 0 and 20")
+	}
+	if (before > 0 || after > 0) && p.Limit > 100 {
+		return page, nil, fmt.Errorf("context search requires --limit at most 100 hits")
+	}
+	err = r.withView(ctx, func(c context.Context, db *store.DB) error {
+		page, err = db.SearchMessagesPage(p, cursor)
+		if err != nil {
+			return err
+		}
+		page.Messages = r.resolveNames(c, db, page.Messages)
+		if before == 0 && after == 0 {
+			return nil
+		}
+		contexts = make([]OwnedSearchHitContext, 0, len(page.Messages))
+		for _, hit := range page.Messages {
+			chats, e := r.chatFilterInView(c, db, hit.ChatJID)
+			if e != nil {
+				return e
+			}
+			msgs, e := db.MessageContextInChats(chats, hit, before, after)
+			if e != nil {
+				return e
+			}
+			contexts = append(contexts, OwnedSearchHitContext{ChatJID: hit.ChatJID, MsgID: hit.MsgID, Messages: r.resolveNames(c, db, msgs)})
+		}
+		return nil
+	})
+	return
+}
+func (r *OwnedMessageReads) ListStarred(ctx context.Context, p store.ListStarredMessagesParams) (msgs []store.Message, fts bool, err error) {
+	err = r.withView(ctx, func(c context.Context, db *store.DB) error {
+		msgs, err = db.ListStarredMessages(p)
+		if err == nil {
+			msgs = r.resolveNames(c, db, msgs)
+			fts = db.HasFTS()
+		}
+		return err
+	})
+	return
+}
+func (r *OwnedMessageReads) GetMessage(ctx context.Context, chats []string, id string) (m store.Message, err error) {
+	err = r.withView(ctx, func(_ context.Context, db *store.DB) error { m, err = getOwnedMessage(db, chats, id); return err })
+	return
+}
+func (r *OwnedMessageReads) MessageContext(ctx context.Context, chats []string, id string, before, after int) (msgs []store.Message, err error) {
+	err = r.withView(ctx, func(_ context.Context, db *store.DB) error {
+		msgs, err = getOwnedContext(db, chats, id, before, after)
+		return err
+	})
+	return
+}
+func (r *OwnedMessageReads) Changes(ctx context.Context, since string, checkpoint bool, limit int) (page store.ChangesPage, err error) {
+	child, finish, err := r.effect(ctx)
+	if err != nil {
+		return page, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	if r.viewProbe != nil {
+		if err = r.viewProbe(child); err != nil {
+			return page, err
+		}
+	}
+	// MessageChanges owns its consistent transaction; do not nest ReadView.
+	return r.db.MessageChanges(since, checkpoint, limit)
+}
+
+func (r *OwnedMessageReads) ResolveMessageSenderNames(ctx context.Context, msgs []store.Message) (out []store.Message, err error) {
+	err = r.withView(ctx, func(c context.Context, db *store.DB) error { out = r.resolveNames(c, db, msgs); return nil })
+	return out, err
+}
+func (r *OwnedMessageReads) resolveNames(ctx context.Context, db *store.DB, msgs []store.Message) []store.Message {
+	if len(msgs) == 0 || !ownedMessagesNeedNames(msgs) {
+		return msgs
+	}
+	if _, err := os.Stat(filepath.Join(r.app.opts.StoreDir, "session.db")); err != nil {
+		return msgs
+	}
+	resolver, err := r.app.LocalResolver()
+	if err != nil {
+		return msgs
+	}
+	for i := range msgs {
+		if msgs[i].FromMe || strings.TrimSpace(msgs[i].SenderName) != "" {
+			continue
+		}
+		jid, e := types.ParseJID(strings.TrimSpace(msgs[i].SenderJID))
+		if e != nil || jid.Server != types.HiddenUserServer {
+			continue
+		}
+		pn := resolver.ResolveLIDToPN(ctx, jid)
+		if pn.IsEmpty() || pn == jid {
+			continue
+		}
+		contact, e := db.GetContact(pn.String())
+		if e == nil {
+			if contact.Alias != "" {
+				msgs[i].SenderName = contact.Alias
+			} else if contact.Name != "" {
+				msgs[i].SenderName = contact.Name
+			} else if contact.Phone != "" {
+				msgs[i].SenderName = contact.Phone
+			}
+		}
+		if msgs[i].SenderName == "" {
+			msgs[i].SenderName = pn.String()
+		}
+	}
+	return msgs
+}
+func (r *OwnedMessageReads) chatFilterInView(ctx context.Context, db *store.DB, chat string) ([]string, error) {
+	resolved, err := localOwnedIdentifier(db, chat, true)
+	if err != nil {
+		return nil, err
+	}
+	jid, err := wa.ParseUserOrJID(resolved)
+	if err != nil {
+		return nil, err
+	}
+	jids := []types.JID{canonicalOwnedMessageJID(jid)}
+	if _, err := os.Stat(filepath.Join(r.app.opts.StoreDir, "session.db")); err != nil {
+		return ownedJIDStrings(jids), nil
+	}
+	resolver, e := r.app.LocalResolver()
+	if e == nil {
+		if jid.Server == types.DefaultUserServer {
+			jids = append(jids, canonicalOwnedMessageJID(resolver.ResolvePNToLID(ctx, jid)))
+		} else if jid.Server == types.HiddenUserServer {
+			jids = append(jids, canonicalOwnedMessageJID(resolver.ResolveLIDToPN(ctx, jid)))
+		}
+	}
+	return ownedJIDStrings(jids), nil
+}
+func localOwnedIdentifier(db *store.DB, input string, chats bool) (string, error) {
+	if input == "" {
+		return "", nil
+	}
+	jid, err := wa.ParseUserOrJID(input)
+	if err == nil {
+		return jid.String(), nil
+	}
+	explicit, numeric := strings.Contains(input, "@"), true
+	for _, c := range input {
+		if (c < '0' || c > '9') && !strings.ContainsRune("+ -()", c) {
+			numeric = false
+			break
+		}
+	}
+	if explicit || numeric {
+		return "", err
+	}
+	return db.ResolveMessageName(input, chats)
+}
+func canonicalOwnedMessageJID(jid types.JID) types.JID {
+	if jid.Server == types.DefaultUserServer {
+		return jid.ToNonAD()
+	}
+	return jid
+}
+func ownedJIDStrings(jids []types.JID) []string {
+	out := make([]string, 0, len(jids))
+	seen := map[string]bool{}
+	for _, j := range jids {
+		if j.IsEmpty() || seen[j.String()] {
+			continue
+		}
+		seen[j.String()] = true
+		out = append(out, j.String())
+	}
+	return out
+}
+func ownedMessagesNeedNames(msgs []store.Message) bool {
+	for _, m := range msgs {
+		if !m.FromMe && strings.TrimSpace(m.SenderName) == "" && strings.HasSuffix(strings.TrimSpace(m.SenderJID), "@"+types.HiddenUserServer) {
+			return true
+		}
+	}
+	return false
+}
+func getOwnedMessage(db *store.DB, chats []string, id string) (store.Message, error) {
+	var nf error
+	for _, chat := range chats {
+		m, err := db.GetMessage(chat, id)
+		if err == nil {
+			if c, e := db.MessageReceipts(m.ChatJID, m.MsgID); e == nil {
+				m.DeliveredTo, m.ReadBy = c.Delivered, c.Read
+			}
+			return m, nil
+		}
+		if !errors.Is(err, sql.ErrNoRows) {
+			return store.Message{}, err
+		}
+		nf = err
+	}
+	if nf != nil {
+		return store.Message{}, nf
+	}
+	return store.Message{}, sql.ErrNoRows
+}
+func getOwnedContext(db *store.DB, chats []string, id string, before, after int) ([]store.Message, error) {
+	var nf error
+	for _, chat := range chats {
+		m, err := db.MessageContext(chat, id, before, after)
+		if err == nil {
+			return m, nil
+		}
+		if !errors.Is(err, sql.ErrNoRows) {
+			return nil, err
+		}
+		nf = err
+	}
+	if nf != nil {
+		return nil, nf
+	}
+	return nil, sql.ErrNoRows
+}
