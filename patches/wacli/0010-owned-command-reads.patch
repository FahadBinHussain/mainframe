+func TestOwnedMessageReadsReadViewFailureAndPanicRetainLifecycleCause(t *testing.T) {
+	failure := errors.New("synthetic message read failure")
+	for _, tc := range []struct {
+		name  string
+		panic bool
+	}{
+		{name: "failure"},
+		{name: "panic", panic: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			a, _, parent, finish := ownedMessageTestApp(t)
+			defer finish(nil)
+			reads, err := a.OwnedMessageReads(parent)
+			if err != nil {
+				t.Fatal(err)
+			}
+			reads.viewProbe = func(context.Context) error {
+				if tc.panic {
+					panic(failure)
+				}
+				return failure
+			}
+			if tc.panic {
+				func() {
+					defer func() {
+						if recover() != failure {
+							t.Fatal("read panic was changed")
+						}
+					}()
+					_, _ = reads.ChatJIDFilter(parent, "1234567")
+				}()
+			} else if _, err := reads.ChatJIDFilter(parent, "1234567"); !errors.Is(err, failure) {
+				t.Fatalf("read failure = %v", err)
+			}
+			finish(nil)
+			if held, err := a.BeginDrain(context.Background()); held != nil || !errors.Is(err, failure) || !errors.Is(err, ErrDrainCoverageIncomplete) {
+				t.Fatalf("lifecycle cause/coverage lost: %v %v", held, err)
+			}
+		})
+	}
+}
