+func TestOwnedMessageChangesRetainsOwnTransaction(t *testing.T) {
+	// The store method begins its own transaction. Wrapping it in ReadView can
+	// deadlock a one-connection pool and cannot provide its claimed snapshot.
+	f, err := parser.ParseFile(token.NewFileSet(), "owned_message_reads.go", nil, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, decl := range f.Decls {
+		fn, ok := decl.(*ast.FuncDecl)
+		if !ok || fn.Name.Name != "Changes" {
+			continue
+		}
+		ast.Inspect(fn.Body, func(n ast.Node) bool {
+			if sel, ok := n.(*ast.SelectorExpr); ok && (sel.Sel.Name == "withView" || sel.Sel.Name == "ReadView") {
+				t.Errorf("Changes must not nest its own transaction in %s", sel.Sel.Name)
+			}
+			return true
+		})
+	}
+	a, _, ctx, finish := ownedMessageTestApp(t)
+	defer finish(nil)
+	reads, err := a.OwnedMessageReads(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	page, err := reads.Changes(ctx, "", true, 1)
+	if err != nil || page.NextCheckpoint == "" {
+		t.Fatalf("synthetic checkpoint = %+v, %v", page, err)
+	}
+}
