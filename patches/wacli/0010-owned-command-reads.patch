+func TestOwnedMessageReadsRefuseForeignOrCanceledContexts(t *testing.T) {
+	a, _, parent, finish := ownedMessageTestApp(t)
+	defer finish(nil)
+	reads, err := a.OwnedMessageReads(parent)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := reads.ListPage(context.Background(), "list", store.ListMessagesParams{Limit: 1}, ""); !errors.Is(err, ErrHandleRevoked) {
+		t.Fatalf("foreign read = %v", err)
+	}
+	canceled, cancel := context.WithCancel(parent)
+	cancel()
+	if _, err := reads.ListPage(canceled, "list", store.ListMessagesParams{Limit: 1}, ""); !errors.Is(err, ErrHandleRevoked) {
+		t.Fatalf("canceled read = %v", err)
