diff --git a/internal/app/owned_archive.go b/internal/app/owned_archive.go
new file mode 100644
index 0000000..dd27ad8
--- /dev/null
+++ b/internal/app/owned_archive.go
@@ -0,0 +1,53 @@
+package app
+
+import (
+	"context"
+
+	"github.com/openclaw/wacli/internal/store"
+)
+
+// ListCallEvents reads local call diagnostics while retaining the child lease
+// for the complete store invocation.
+func (d *OwnedDB) ListCallEvents(ctx context.Context, p store.ListCallEventsParams) (events []store.CallEvent, err error) {
+	_, finish, err := d.effect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return d.archive.ListCallEvents(p)
+}
+
+// ListHistoryCoverage reads local archive coverage while retaining the child
+// lease for the complete store invocation.
+func (d *OwnedDB) ListHistoryCoverage(ctx context.Context, p store.ListHistoryCoverageParams) (coverage []store.HistoryCoverage, err error) {
+	_, finish, err := d.effect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return d.archive.ListHistoryCoverage(p)
+}
+
+// CountArchiveStats reads all store counters used by the local diagnostics
+// command under one invocation lease.
+func (d *OwnedDB) CountArchiveStats(ctx context.Context) (chats, groups, leftGroups, messages int64, err error) {
+	_, finish, err := d.effect(ctx)
+	if err != nil {
+		return 0, 0, 0, 0, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	chats, err = d.archive.CountChats()
+	if err != nil {
+		return 0, 0, 0, 0, err
+	}
+	groups, err = d.archive.CountGroups()
+	if err != nil {
+		return 0, 0, 0, 0, err
+	}
+	leftGroups, err = d.archive.CountLeftGroups()
+	if err != nil {
+		return 0, 0, 0, 0, err
+	}
+	messages, err = d.archive.CountMessages()
+	return chats, groups, leftGroups, messages, err
+}
diff --git a/internal/app/owned_archive_test.go b/internal/app/owned_archive_test.go
new file mode 100644
index 0000000..3f51ea2
--- /dev/null
+++ b/internal/app/owned_archive_test.go
@@ -0,0 +1,185 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/openclaw/wacli/internal/store"
+)
+
+type ownedArchiveProbe struct {
+	ownedArchiveReader
+	calls            atomic.Int32
+	entered, release chan struct{}
+	failure          error
+	panics           bool
+}
+
+func (p *ownedArchiveProbe) read() error {
+	p.calls.Add(1)
+	if p.entered != nil {
+		close(p.entered)
+		<-p.release
+	}
+	if p.panics {
+		panic(p.failure)
+	}
+	return p.failure
+}
+func (p *ownedArchiveProbe) ListCallEvents(store.ListCallEventsParams) ([]store.CallEvent, error) {
+	return nil, p.read()
+}
+func (p *ownedArchiveProbe) ListHistoryCoverage(store.ListHistoryCoverageParams) ([]store.HistoryCoverage, error) {
+	return nil, p.read()
+}
+func (p *ownedArchiveProbe) CountChats() (int64, error) { return 0, p.read() }
+
+var ownedArchiveInvocations = []struct {
+	name string
+	call func(*OwnedDB, context.Context) error
+}{
+	{"calls", func(d *OwnedDB, c context.Context) error {
+		_, e := d.ListCallEvents(c, store.ListCallEventsParams{})
+		return e
+	}},
+	{"history", func(d *OwnedDB, c context.Context) error {
+		_, e := d.ListHistoryCoverage(c, store.ListHistoryCoverageParams{})
+		return e
+	}},
+	{"stats", func(d *OwnedDB, c context.Context) error { _, _, _, _, e := d.CountArchiveStats(c); return e }},
+}
+
+func TestOwnedArchiveRefusalHasZeroStoreEffects(t *testing.T) {
+	for _, mode := range []string{"sealed-finished", "sealed-missing", "foreign", "canceled"} {
+		t.Run(mode, func(t *testing.T) {
+			a, _, ctx, finish := ownedTestApp(t)
+			defer finish(nil)
+			d, err := a.OwnedDB(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			probe := &ownedArchiveProbe{ownedArchiveReader: d.archive}
+			d.archive = probe
+			use := ctx
+			switch mode {
+			case "sealed-finished", "sealed-missing":
+				finish(nil)
+				if held, err := a.BeginDrain(context.Background()); held != nil || !errors.Is(err, ErrDrainCoverageIncomplete) {
+					t.Fatalf("seal = %v %v", held, err)
+				}
+				if mode == "sealed-missing" {
+					use = context.Background()
+				}
+			case "foreign":
+				other := &App{}
+				var end func(error)
+				use, end, err = other.BeginScopedOperation(context.Background())
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer end(nil)
+			case "canceled":
+				var cancel context.CancelFunc
+				use, cancel = context.WithCancel(ctx)
+				cancel()
+			}
+			for _, op := range ownedArchiveInvocations {
+				if err := op.call(d, use); !errors.Is(err, ErrHandleRevoked) {
+					t.Fatalf("%s = %v", op.name, err)
+				}
+			}
+			if probe.calls.Load() != 0 {
+				t.Fatalf("refused operations performed %d store effects", probe.calls.Load())
+			}
+		})
+	}
+}
+
+func TestOwnedArchiveAcceptedAfterSealAndActualInvocationJoin(t *testing.T) {
+	for _, op := range ownedArchiveInvocations {
+		t.Run(op.name, func(t *testing.T) {
+			a, _, ctx, finish := ownedTestApp(t)
+			defer finish(nil)
+			d, err := a.OwnedDB(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			failure := errors.New("synthetic archive failure")
+			probe := &ownedArchiveProbe{ownedArchiveReader: d.archive, entered: make(chan struct{}), release: make(chan struct{}), failure: failure}
+			d.archive = probe
+			var release sync.Once
+			defer release.Do(func() { close(probe.release) })
+			sealed, cancel := context.WithCancel(context.Background())
+			cancel()
+			if held, err := a.BeginDrain(sealed); held != nil || !errors.Is(err, ErrDrainCoverageIncomplete) {
+				t.Fatalf("seal = %v %v", held, err)
+			}
+			result := make(chan error, 1)
+			go func() { result <- op.call(d, ctx) }()
+			select {
+			case <-probe.entered:
+			case <-time.After(time.Second):
+				t.Fatal("live parent failed to admit child after seal")
+			}
+			finish(nil)
+			drain := make(chan error, 1)
+			go func() { _, err := a.BeginDrain(context.Background()); drain <- err }()
+			select {
+			case err := <-drain:
+				t.Fatalf("drain escaped invocation: %v", err)
+			case <-time.After(20 * time.Millisecond):
+			}
+			release.Do(func() { close(probe.release) })
+			select {
+			case err := <-result:
+				if !errors.Is(err, failure) {
+					t.Fatal(err)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("invocation failed to return")
+			}
+			select {
+			case err := <-drain:
+				if !errors.Is(err, failure) || !errors.Is(err, ErrDrainCoverageIncomplete) {
+					t.Fatal(err)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("drain did not join")
+			}
+			if probe.calls.Load() != 1 {
+				t.Fatal("unexpected store effect count")
+			}
+		})
+	}
+}
+
+func TestOwnedArchivePanicRetainsCause(t *testing.T) {
+	for _, op := range ownedArchiveInvocations {
+		t.Run(op.name, func(t *testing.T) {
+			a, _, ctx, finish := ownedTestApp(t)
+			defer finish(nil)
+			d, err := a.OwnedDB(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			failure := errors.New("synthetic archive panic")
+			d.archive = &ownedArchiveProbe{ownedArchiveReader: d.archive, failure: failure, panics: true}
+			func() {
+				defer func() {
+					if recover() != failure {
+						t.Error("panic cause changed")
+					}
+				}()
+				_ = op.call(d, ctx)
+			}()
+			finish(nil)
+			if held, err := a.BeginDrain(context.Background()); held != nil || !errors.Is(err, failure) || !errors.Is(err, ErrDrainCoverageIncomplete) {
+				t.Fatalf("lost panic = %v %v", held, err)
+			}
+		})
+	}
+}
