@@ -0,0 +1,93 @@
+//go:build linux
+
+package main
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/openclaw/wacli/internal/store"
+)
+
+func TestStoreVerifyMediaSyntheticReferencesAndRefusal(t *testing.T) {
+	root := t.TempDir()
+	media := filepath.Join(t.TempDir(), "synthetic-media")
+	data := []byte("synthetic media bytes only")
+	if err := os.WriteFile(media, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	sum := sha256.Sum256(data)
+	db, err := store.Open(filepath.Join(root, "wacli.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	chat := "synthetic@s.whatsapp.net"
+	if err := db.UpsertChat(chat, "dm", "synthetic", time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.UpsertMessage(store.UpsertMessageParams{ChatJID: chat, MsgID: "m", Timestamp: time.Now(), MediaType: "document", FileSHA256: sum[:], FileLength: uint64(len(data))}); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.MarkMediaDownloaded(chat, "m", media, time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.UpsertMessage(store.UpsertMessageParams{ChatJID: chat, MsgID: "unknown-length", Timestamp: time.Now(), MediaType: "document", FileSHA256: sum[:]}); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.MarkMediaDownloaded(chat, "unknown-length", media, time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Close(); err != nil {
+		t.Fatal(err)
+	}
+	var output bytes.Buffer
+	cmd := newStoreVerifyMediaCmd(&rootFlags{storeDir: root, asJSON: true})
+	cmd.SetOut(&output)
+	if err := cmd.Execute(); err != nil {
+		t.Fatal(err)
+	}
+	var result map[string]any
+	if err := json.Unmarshal(output.Bytes(), &result); err != nil {
+		t.Fatal(err)
+	}
+	dataResult, ok := result["data"].(map[string]any)
+	if !ok {
+		t.Fatalf("missing diagnostic data: %v", result)
+	}
+	result = dataResult
+	if result["checked_references"] != float64(2) || result["complete"] != false || result["capture_enabled"] != false || result["publishable"] != false || result["boundary"] != "UNVERIFIED" {
+		t.Fatalf("misleading report: %v", result)
+	}
+	if _, err := os.Stat(filepath.Join(root, "session.db")); !os.IsNotExist(err) {
+		t.Fatalf("session source was opened: %v", err)
+	}
+	if err := os.WriteFile(media, []byte("foreign mutation"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	output.Reset()
+	cmd = newStoreVerifyMediaCmd(&rootFlags{storeDir: root, asJSON: true})
+	cmd.SetOut(&output)
+	cmd.SetErr(&output)
+	if err := cmd.Execute(); err == nil {
+		t.Fatal("changed media was accepted")
+	}
+	if bytes.Contains(output.Bytes(), []byte("verified-byte-objects-only")) {
+		t.Fatal("partial success report after failure")
+	}
+	got, err := os.ReadFile(media)
+	if err != nil || string(got) != "foreign mutation" {
+		t.Fatalf("original changed or removed: %q, %v", got, err)
+	}
+}
+
+func TestStoreVerifyMediaWired(t *testing.T) {
+	command, _, err := newStoreCmd(&rootFlags{}).Find([]string{"verify-media"})
+	if err != nil || command == nil || command.Name() != "verify-media" {
+		t.Fatalf("command = %v, %v", command, err)
+	}
+}
diff --git a/docs/store.md b/docs/store.md
index 15c34ee..e1546b0 100644
--- a/docs/store.md
+++ b/docs/store.md
@@ -91,0 +92,10 @@ wacli groups prune --include-active --days 365 --dry-run
+
+## Verify local media bytes (Linux)
+
+`wacli --json store verify-media` opens only the local message index in read-only mode. It enumerates every nonempty message media path and local-media alias, including repeated paths and orphan aliases, then verifies each object against its stored plaintext SHA-256 and length when present. It does not connect to WhatsApp, fetch missing media, open `session.db`, change the originals, or publish a backup.
+
+Verified bytes are held temporarily in Linux `memfd` objects with kernel write, grow, shrink and seal locks. Foreign writes through an original path or retained original descriptor cannot alter those staged objects. This is an immutable content-object policy, **not ownership of the original external directories or their names**.
+
+The check is all-or-nothing: missing files, absent or malformed fingerprints, orphan metadata, mismatched bytes, unsupported kernels and cancellation fail the entire command. Limits of 1,024 references/descriptors and 256 MiB of staged bytes also fail the entire command; no reference is silently skipped. Originals are never deleted to satisfy a limit. Empty local paths do not identify locally downloaded objects, so this is not a check that every remote attachment has been downloaded.
+
+A successful result says `verified-byte-objects-only`, with `boundary: UNVERIFIED`, `complete: false` and `publishable: false`. The temporary descriptors are closed after reporting. Concurrent producers can still change database membership or the external roots, so this diagnostic is **not** a held whole-store frontier, a capture receipt, a restore or a Windows validation. Other platforms refuse immutable staging rather than weakening the contract.
