@@ -0,0 +1,32 @@
+package wa
+
+import (
+	"context"
+
+	"go.mau.fi/whatsmeow"
+)
+
+// BeginDrain retains the stores while the SDK seals and joins its registered
+// operations. The pinned SDK refuses a whole-client receipt when coverage is
+// incomplete; neither a missing client nor a closed wrapper is a held boundary.
+func (c *Client) BeginDrain(ctx context.Context) (*whatsmeow.HeldBoundary, error) {
+	c.mu.Lock()
+	cli := c.client
+	c.mu.Unlock()
+	if cli == nil {
+		return nil, whatsmeow.ErrLifecycleCoverageIncomplete
+	}
+	return cli.BeginDrain(ctx)
+}
+
+// DrainOperationalError strips only the exact known coverage wrapper/marker.
+// Unknown wrapped or joined errors are kept intact, never dropped by errors.Is.
+func DrainOperationalError(err error) error {
+	if incomplete, ok := err.(*whatsmeow.LifecycleDrainError); ok {
+		return incomplete.Cause
+	}
+	if err == whatsmeow.ErrLifecycleCoverageIncomplete {
+		return nil
+	}
+	return err
+}
