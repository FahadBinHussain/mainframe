+package wa
+
+import (
+	"errors"
+	"testing"
+
+	"go.mau.fi/whatsmeow"
+)
+
+func TestDrainOperationalErrorPreservesJoinedFailures(t *testing.T) {
+	first := errors.New("synthetic SDK failure")
+	second := errors.New("synthetic independent failure")
+	if DrainOperationalError(whatsmeow.ErrLifecycleCoverageIncomplete) != nil {
+		t.Fatal("coverage-only marker became close failure")
+	}
+	if DrainOperationalError(&whatsmeow.LifecycleDrainError{}) != nil {
+		t.Fatal("coverage-only typed result became close failure")
+	}
+	known := &whatsmeow.LifecycleDrainError{Cause: first}
+	if !errors.Is(DrainOperationalError(known), first) {
+		t.Fatal("typed operational cause lost")
+	}
+	for _, joined := range []error{errors.Join(whatsmeow.ErrLifecycleCoverageIncomplete, first, second), errors.Join(known, second)} {
+		got := DrainOperationalError(joined)
+		if !errors.Is(got, first) || !errors.Is(got, second) {
+			t.Fatalf("joined operational errors lost: %v", got)
+		}
+	}
+}
