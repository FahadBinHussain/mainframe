diff --git a/internal/app/drain.go b/internal/app/drain.go
new file mode 100644
index 0000000..d4cf8cd
--- /dev/null
+++ b/internal/app/drain.go
@@ -0,0 +1,184 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"sync"
+
+	"github.com/openclaw/wacli/internal/wa"
+	"go.mau.fi/whatsmeow"
+)
+
+var ErrDrainCoverageIncomplete = errors.New("WACLI lifecycle coverage is incomplete: raw DB/WA handles and unregistered workers remain")
+var ErrOperationSealed = errors.New("WACLI operation admission is sealed")
+
+// DrainIncompleteError retains operational failures separately from the known
+// coverage gap. Ordinary Close may report Cause without claiming a held boundary.
+type DrainIncompleteError struct{ Cause error }
+
+func (e *DrainIncompleteError) Error() string {
+	if e.Cause != nil {
+		return ErrDrainCoverageIncomplete.Error() + ": " + e.Cause.Error()
+	}
+	return ErrDrainCoverageIncomplete.Error()
+}
+func (e *DrainIncompleteError) Unwrap() []error { return []error{ErrDrainCoverageIncomplete, e.Cause} }
+
+// HeldBoundary is reserved for a complete application frontier. No current path
+// constructs or returns one. Closing SQLite is not a substitute.
+type HeldBoundary struct{ _ struct{} }
+
+type operationAdmission struct {
+	mu        sync.Mutex
+	sealed    bool
+	active    int
+	nextID    uint64
+	cancels   map[uint64]context.CancelFunc
+	done      chan struct{}
+	completed bool
+	err       error
+}
+
+func (o *operationAdmission) begin(ctx context.Context) (func(error), error) {
+	_, finish, err := o.beginWithCancel(ctx, false)
+	return finish, err
+}
+
+func (o *operationAdmission) beginWithCancel(ctx context.Context, cancelable bool) (context.Context, func(error), error) {
+	if err := ctx.Err(); err != nil {
+		return nil, nil, err
+	}
+	ownedCtx := ctx
+	var cancel context.CancelFunc
+	if cancelable {
+		ownedCtx, cancel = context.WithCancel(ctx)
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.sealed {
+		if cancel != nil {
+			cancel()
+		}
+		return nil, nil, ErrOperationSealed
+	}
+	o.active++
+	var id uint64
+	if cancel != nil {
+		if o.cancels == nil {
+			o.cancels = make(map[uint64]context.CancelFunc)
+		}
+		o.nextID++
+		id = o.nextID
+		o.cancels[id] = cancel
+	}
+	var once sync.Once
+	finish := func(err error) {
+		once.Do(func() {
+			if cancel != nil {
+				cancel()
+			}
+			o.mu.Lock()
+			defer o.mu.Unlock()
+			if cancel != nil {
+				delete(o.cancels, id)
+			}
+			if o.err == nil && err != nil {
+				o.err = err
+			}
+			o.active--
+			o.completeLocked()
+		})
+	}
+	return ownedCtx, finish, nil
+}
+
+func (o *operationAdmission) cancelAccepted() {
+	o.mu.Lock()
+	o.sealed = true
+	if o.done == nil {
+		o.done = make(chan struct{})
+	}
+	cancels := make([]context.CancelFunc, 0, len(o.cancels))
+	for _, cancel := range o.cancels {
+		cancels = append(cancels, cancel)
+	}
+	o.mu.Unlock()
+	for _, cancel := range cancels {
+		cancel()
+	}
+}
+func (o *operationAdmission) completeLocked() {
+	if o.sealed && o.active == 0 && !o.completed {
+		o.completed = true
+		close(o.done)
+	}
+}
+func (o *operationAdmission) drain(ctx context.Context) error {
+	o.mu.Lock()
+	if o.done == nil {
+		o.done = make(chan struct{})
+	}
+	o.sealed = true
+	o.completeLocked()
+	done := o.done
+	o.mu.Unlock()
+	select {
+	case <-done:
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		o.mu.Lock()
+		defer o.mu.Unlock()
+		return o.err
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+// BeginOperation tracks explicitly admitted CLI/delegate operations. The finish
+// function must run after their synchronous effects and is safe to call twice.
+// This does not track arbitrary goroutines launched by a borrowed DB/WA handle.
+func (a *App) BeginOperation(ctx context.Context) (func(error), error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return a.operations.begin(ctx)
+}
+
+// BeginCancelableOperation tracks an admitted delegate and returns a context
+// owned by the app. Close cancels this context after sealing admission, before
+// waiting for the operation to finish. Unlike BeginOperation, cancellation is
+// intentionally app-owned; callers still must invoke finish after all effects.
+func (a *App) BeginCancelableOperation(ctx context.Context) (context.Context, func(error), error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return a.operations.beginWithCancel(ctx, true)
+}
+
+// BeginDrain seals explicit application operations and invokes the SDK drain
+// while both stores remain open. It never returns a successful held boundary:
+// the public DB/WA accessors and remaining application workers are not revoked.
+// A canceled drain stays sealed; retrying may finish waiting but cannot certify.
+func (a *App) BeginDrain(ctx context.Context) (*HeldBoundary, error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	workErr := a.operations.drain(ctx)
+	if ctx.Err() == nil {
+		a.waMu.Lock()
+		client := a.wa
+		a.waMu.Unlock()
+		if client != nil {
+			if drainer, ok := client.(interface {
+				BeginDrain(context.Context) (*whatsmeow.HeldBoundary, error)
+			}); ok {
+				_, err := drainer.BeginDrain(ctx)
+				if err = wa.DrainOperationalError(err); err != nil {
+					workErr = errors.Join(workErr, err)
+				}
+			}
+		}
+	}
+	return nil, &DrainIncompleteError{Cause: workErr}
+}
diff --git a/internal/app/drain_test.go b/internal/app/drain_test.go
new file mode 100644
index 0000000..6f5e025
--- /dev/null
+++ b/internal/app/drain_test.go
@@ -0,0 +1,235 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+)
+
+type drainWA struct {
+	WAClient
+	calls int
+	err   error
+}
+
+func (w *drainWA) BeginDrain(context.Context) (*whatsmeow.HeldBoundary, error) {
+	w.calls++
+	return nil, w.err
+}
+func (w *drainWA) Disconnect() {}
+func (w *drainWA) Close()      {}
+
+func TestDrainWaitsForAcceptedOperationAndRetainsFailure(t *testing.T) {
+	a, err := New(Options{StoreDir: t.TempDir()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	finish, err := a.BeginOperation(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	failure := errors.New("synthetic accepted effect failed")
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	boundary, err := a.BeginDrain(ctx)
+	if boundary != nil || !errors.Is(err, context.Canceled) || !errors.Is(err, ErrDrainCoverageIncomplete) {
+		t.Fatalf("drain = %v, %v", boundary, err)
+	}
+	if _, err := a.BeginOperation(t.Context()); !errors.Is(err, ErrOperationSealed) {
+		t.Fatalf("late admission = %v", err)
+	}
+	finished := make(chan error, 1)
+	go func() { _, err := a.BeginDrain(t.Context()); finished <- err }()
+	select {
+	case err := <-finished:
+		t.Fatalf("early drain: %v", err)
+	case <-time.After(10 * time.Millisecond):
+	}
+	if _, err := a.DB().CountMessages(); err != nil {
+		t.Fatalf("accepted continuation lost application store: %v", err)
+	}
+	finish(failure)
+	finish(nil)
+	select {
+	case err := <-finished:
+		if !errors.Is(err, failure) || !errors.Is(err, ErrDrainCoverageIncomplete) {
+			t.Fatalf("lost error: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("drain did not finish")
+	}
+	if !errors.Is(a.CloseWithError(), failure) {
+		t.Fatal("close lost accepted operation failure")
+	}
+}
+
+func TestDrainAlwaysRefusesEvenIdleAndPropagatesSDKFailure(t *testing.T) {
+	for _, failure := range []error{nil, whatsmeow.ErrLifecycleCoverageIncomplete, errors.New("synthetic SDK effect failure")} {
+		a := &App{}
+		w := &drainWA{err: failure}
+		a.wa = w
+		boundary, err := a.BeginDrain(t.Context())
+		if boundary != nil || !errors.Is(err, ErrDrainCoverageIncomplete) {
+			t.Fatalf("unsafe receipt: %v, %v", boundary, err)
+		}
+		if failure != nil && failure != whatsmeow.ErrLifecycleCoverageIncomplete && !errors.Is(err, failure) {
+			t.Fatalf("lost SDK failure: %v", err)
+		}
+		if w.calls != 1 {
+			t.Fatalf("SDK drain calls = %d", w.calls)
+		}
+	}
+}
+
+func TestDrainConcurrentIdleAndClose(t *testing.T) {
+	a, err := New(Options{StoreDir: t.TempDir()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	for range 12 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			boundary, err := a.BeginDrain(t.Context())
+			if boundary != nil || !errors.Is(err, ErrDrainCoverageIncomplete) {
+				t.Errorf("unsafe receipt: %v, %v", boundary, err)
+			}
+		}()
+	}
+	wg.Wait()
+	if err := a.CloseWithError(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestCloseCancelsCancelableDelegateBeforeWaiting(t *testing.T) {
+	a, err := New(Options{StoreDir: t.TempDir()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, finish, err := a.BeginCancelableOperation(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	canceled := make(chan struct{})
+	go func() {
+		<-ctx.Done()
+		close(canceled)
+		finish(context.Canceled)
+	}()
+	closeDone := make(chan error, 1)
+	go func() { closeDone <- a.CloseWithError() }()
+	select {
+	case <-canceled:
+	case <-time.After(5 * time.Second):
+		t.Fatal("close did not cancel admitted delegate")
+	}
+	select {
+	case err := <-closeDone:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("close lost cancellation failure: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("close did not wait for delegate finish")
+	}
+}
+
+func TestCloseKeepsStoreLiveUntilCanceledEffectFinishes(t *testing.T) {
+	a, err := New(Options{StoreDir: t.TempDir()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, finish, err := a.BeginCancelableOperation(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	canceled := make(chan struct{})
+	go func() { <-ctx.Done(); close(canceled) }()
+	closeDone := make(chan error, 1)
+	go func() { closeDone <- a.CloseWithError() }()
+	select {
+	case <-canceled:
+	case <-time.After(5 * time.Second):
+		t.Fatal("delegate was not canceled")
+	}
+	if _, err := a.DB().CountMessages(); err != nil {
+		t.Fatalf("store closed before canceled effect cleanup: %v", err)
+	}
+	select {
+	case err := <-closeDone:
+		t.Fatalf("close returned before effect finish: %v", err)
+	default:
+	}
+	finish(context.Canceled)
+	if err := <-closeDone; !errors.Is(err, context.Canceled) {
+		t.Fatalf("close lost effect failure: %v", err)
+	}
+}
+
+func TestDrainCancelableAdmissionRejectedAfterCloseSeals(t *testing.T) {
+	a, err := New(Options{StoreDir: t.TempDir()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, finish, err := a.BeginCancelableOperation(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	closeDone := make(chan error, 1)
+	go func() { closeDone <- a.CloseWithError() }()
+	<-ctx.Done()
+	if _, _, err := a.BeginCancelableOperation(t.Context()); !errors.Is(err, ErrOperationSealed) {
+		t.Fatalf("late admission = %v, want ErrOperationSealed", err)
+	}
+	finish(context.Canceled)
+	if err := <-closeDone; !errors.Is(err, context.Canceled) {
+		t.Fatalf("close lost accepted cancellation: %v", err)
+	}
+}
+
+func TestDrainCancelableFinishReleasesOwnedContext(t *testing.T) {
+	a, err := New(Options{StoreDir: t.TempDir()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, finish, err := a.BeginCancelableOperation(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	finish(nil)
+	finish(nil)
+	if !errors.Is(ctx.Err(), context.Canceled) {
+		t.Fatal("completed operation retained parent context")
+	}
+	if err := a.CloseWithError(); err != nil {
+		t.Fatalf("normal completion became close failure: %v", err)
+	}
+}
+
+func TestDrainDoesNotCancelAcceptedDelegate(t *testing.T) {
+	a, err := New(Options{StoreDir: t.TempDir()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, finish, err := a.BeginCancelableOperation(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	waitCtx, cancel := context.WithCancel(t.Context())
+	cancel()
+	boundary, err := a.BeginDrain(waitCtx)
+	if boundary != nil || !errors.Is(err, context.Canceled) || !errors.Is(err, ErrDrainCoverageIncomplete) {
+		t.Fatalf("unsafe drain: %v, %v", boundary, err)
+	}
+	if ctx.Err() != nil {
+		t.Fatal("public drain canceled accepted work")
+	}
+	finish(nil)
+}
