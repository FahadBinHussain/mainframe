+package main
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/openclaw/wacli/internal/app"
+)
+
+func TestDrainDelegateOwnerRejectsAfterSeal(t *testing.T) {
+	a, err := app.New(app.Options{StoreDir: t.TempDir()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer a.Close()
+	boundary, err := a.BeginDrain(nil)
+	if boundary != nil || !errors.Is(err, app.ErrDrainCoverageIncomplete) {
+		t.Fatalf("unsafe receipt: %v, %v", boundary, err)
+	}
+	_, err = executeAdmittedDelegate(t.Context(), a, sendDelegateRequest{Version: sendDelegateVersion, Kind: "unsupported"})
+	if !errors.Is(err, app.ErrOperationSealed) {
+		t.Fatalf("late delegate reached dispatch: %v", err)
+	}
+}
