@@ -184,0 +185,9 @@ func startSendDelegateServer(ctx context.Context, a *app.App, spacing sendSpacin
+func executeAdmittedDelegate(ctx context.Context, a *app.App, req sendDelegateRequest) (response sendDelegateResponse, operationErr error) {
+	ownedCtx, finish, err := a.BeginCancelableOperation(ctx)
+	if err != nil {
+		return sendDelegateResponse{}, err
+	}
+	defer func() { finish(operationErr) }()
+	return executeDelegatedSend(ownedCtx, a, req)
+}
