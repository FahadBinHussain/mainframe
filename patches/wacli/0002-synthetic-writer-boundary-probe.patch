+package main
+
+import (
+	"context"
+	"encoding/json"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/openclaw/wacli/internal/delegate"
+)
+
+// This counterexample must not be mistaken for a snapshot implementation.
+func TestSnapshotBoundaryProbeStopReturnsBeforeAcceptedExecutorRelease(t *testing.T) {
+	started := make(chan struct{})
+	release := make(chan struct{})
+	executorDone := make(chan struct{})
+	var releaseOnce sync.Once
+	unblock := func() { releaseOnce.Do(func() { close(release) }) }
+	ctx, cancel := context.WithCancel(context.Background())
+	storeDir := t.TempDir()
+	stop, err := startSendDelegateServerForStore(ctx, storeDir, sendSpacing{}, func(context.Context, sendDelegateRequest) (sendDelegateResponse, error) {
+		close(started)
+		<-release
+		close(executorDone)
+		return sendDelegateResponse{OK: true}, nil
+	})
+	if err != nil {
+		cancel()
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		cancel()
+		unblock()
+		stop()
+	})
+	conn, err := delegate.Dial(ctx, storeDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = conn.Close() })
+	if err := json.NewEncoder(conn).Encode(sendDelegateRequest{Version: sendDelegateVersion, Kind: chatStateKind, TimeoutMS: 5000}); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-started:
+	case <-time.After(2 * time.Second):
+		t.Fatal("synthetic executor did not start")
+	}
+	t.Cleanup(func() {
+		unblock()
+		select {
+		case <-executorDone:
+		case <-time.After(2 * time.Second):
+			t.Error("synthetic executor did not finish")
+		}
+	})
+	stopped := make(chan struct{})
+	go func() { stop(); close(stopped) }()
+	select {
+	case <-stopped:
+	case <-time.After(2 * time.Second):
+		t.Fatal("stop did not return after listener close")
+	}
+	select {
+	case <-executorDone:
+		t.Fatal("counterexample did not reproduce: executor finished before release")
+	default:
+		t.Log("stop returned while an accepted synthetic executor remained blocked")
+	}
+	unblock()
+	select {
+	case <-executorDone:
+	case <-time.After(2 * time.Second):
+		t.Fatal("synthetic executor did not complete after release")
+	}
+}
