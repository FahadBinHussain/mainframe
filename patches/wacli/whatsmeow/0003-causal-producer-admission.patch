new file mode 100644
index 0000000..1d1f9d7
--- /dev/null
+++ b/socket/socket_lifecycle_test.go
@@ -0,0 +1,115 @@
+package socket
+
+import (
+	"context"
+	"crypto/aes"
+	"crypto/cipher"
+	"errors"
+	"net/http"
+	"sync"
+	"testing"
+	"time"
+
+	waLog "go.mau.fi/whatsmeow/util/log"
+)
+
+func syntheticNoiseSocket(t *testing.T, hooks LifecycleHooks) *NoiseSocket {
+	t.Helper()
+	block, err := aes.NewCipher(make([]byte, 32))
+	if err != nil {
+		t.Fatal(err)
+	}
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fs := NewFrameSocket(waLog.Noop, nil)
+	fs.SetLifecycleHooks(hooks)
+	return &NoiseSocket{fs: fs, writeKey: aead}
+}
+
+func TestSyntheticSocketWriteOutlivesCallerCancellation(t *testing.T) {
+	entered, release, joined := make(chan struct{}), make(chan struct{}), make(chan error, 1)
+	var once sync.Once
+	unblock := func() { once.Do(func() { close(release) }) }
+	t.Cleanup(unblock)
+	ns := syntheticNoiseSocket(t, LifecycleHooks{Launch: func(ctx context.Context, fn func(context.Context) error) error {
+		// Registration occurs synchronously before the helper returns.
+		close(entered)
+		go func() { <-release; joined <- fn(ctx) }()
+		return nil
+	}})
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	result := make(chan error, 1)
+	go func() { result <- ns.SendFrame(ctx, []byte("synthetic frame")) }()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("write not registered")
+	}
+	cancel()
+	select {
+	case err := <-result:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("caller did not cancel")
+	}
+	select {
+	case <-joined:
+		t.Fatal("write lifetime ended with caller")
+	default:
+	}
+	unblock()
+	select {
+	case err := <-joined:
+		if !errors.Is(err, ErrSocketClosed) {
+			t.Fatalf("registered write lost error: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("write did not finish")
+	}
+}
+
+func TestSyntheticSocketWriteRejectedBeforeLaunch(t *testing.T) {
+	rejected := errors.New("synthetic sealed socket owner")
+	ns := syntheticNoiseSocket(t, LifecycleHooks{Launch: func(context.Context, func(context.Context) error) error { return rejected }})
+	if err := ns.SendFrame(context.Background(), []byte("synthetic")); !errors.Is(err, rejected) {
+		t.Fatal(err)
+	}
+}
+
+type syntheticFailingTransport struct{ err error }
+
+func (f syntheticFailingTransport) RoundTrip(*http.Request) (*http.Response, error) {
+	return nil, f.err
+}
+
+func TestSyntheticSocketDialFailureReleasesScopeAndLock(t *testing.T) {
+	failure := errors.New("synthetic transport refusal; no network")
+	fs := NewFrameSocket(waLog.Noop, &http.Client{Transport: syntheticFailingTransport{failure}})
+	finished := make(chan error, 1)
+	fs.SetLifecycleHooks(LifecycleHooks{Begin: func(ctx context.Context) (context.Context, func(error), error) {
+		return ctx, func(err error) { finished <- err }, nil
+	}})
+	if err := fs.Connect(context.Background()); err == nil {
+		t.Fatal("fake dial succeeded")
+	}
+	select {
+	case err := <-finished:
+		if !errors.Is(err, failure) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("failed dial leaked scope")
+	}
+	done := make(chan struct{})
+	go func() { _ = fs.Context(); fs.Close(0); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("failed dial left socket lock held")
