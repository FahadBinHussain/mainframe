+package whatsmeow
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+func TestLifecycleFirstFailureRemainsSticky(t *testing.T) {
+	cli := syntheticLifecycleClient()
+	root, err := cli.BeginScope(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	first := errors.New("synthetic first operational cause")
+	later := errors.New("synthetic later operational cause")
+	cli.lifecycle.recordError(first)
+	root.Finish(later)
+	held, drainErr := cli.BeginDrain(context.Background())
+	if held != nil || !errors.Is(drainErr, first) || !errors.Is(drainErr, ErrLifecycleCoverageIncomplete) {
+		t.Fatalf("first cause no longer denies a successful boundary: held=%v err=%v", held, drainErr)
+	}
+	if errors.Is(drainErr, later) {
+		t.Fatal("first-cause registry unexpectedly claimed an exhaustive error history")
+	}
+}
