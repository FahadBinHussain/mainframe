+package whatsmeow
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+)
+
+func TestLifecycleContextCallbackChildAfterSeal(t *testing.T) {
+	cli := syntheticLifecycleClient()
+	ctx, root, err := cli.BeginOperation(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer root.Finish(nil)
+	entered, release := make(chan struct{}), make(chan struct{})
+	t.Cleanup(func() {
+		select {
+		case <-release:
+		default:
+			close(release)
+		}
+	})
+	id := cli.AddEventHandlerWithContext(func(ctx context.Context, _ any) error {
+		return cli.launchLifecycle(ctx, func(context.Context) error { close(entered); <-release; return nil })
+	})
+	defer cli.RemoveEventHandler(id)
+	canceled, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, _ = cli.BeginDrain(canceled)
+	if cli.dispatchEventContext(ctx, "synthetic event") {
+		t.Fatal("accepted callback failed")
+	}
+	root.Finish(nil)
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("callback child not started")
+	}
+	done := make(chan error, 1)
+	go func() { _, err := cli.BeginDrain(context.Background()); done <- err }()
+	select {
+	case <-done:
+		t.Fatal("callback descendant escaped join")
+	default:
+	}
+	close(release)
+	if err := <-done; !errors.Is(err, ErrLifecycleCoverageIncomplete) {
+		t.Fatal(err)
+	}
+}
+
+func TestLifecycleContextCallbackErrorsAndPanicsSticky(t *testing.T) {
+	for _, panics := range []bool{false, true} {
+		t.Run(map[bool]string{false: "return", true: "panic"}[panics], func(t *testing.T) {
+			cli := syntheticLifecycleClient()
+			failure := errors.New("synthetic application callback failure")
+			cli.AddEventHandlerWithContext(func(context.Context, any) error {
+				if panics {
+					panic(failure)
+				}
+				return failure
+			})
+			if !cli.dispatchEventContext(context.Background(), "synthetic") {
+				t.Fatal("callback failure was reported as success")
+			}
+			held, err := cli.BeginDrain(context.Background())
+			if held != nil || !errors.Is(err, failure) || !errors.Is(err, ErrLifecycleCoverageIncomplete) {
+				t.Fatalf("callback error lost: %v %v", held, err)
+			}
+		})
+	}
+}
+
+func TestLifecycleQRWithoutEventsCanceledAndJoined(t *testing.T) {
+	cli := syntheticLifecycleClient()
+	ctx, cancel := context.WithCancel(context.Background())
+	output, err := cli.GetQRChannel(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cancel()
+	done := make(chan error, 1)
+	go func() { _, err := cli.BeginDrain(context.Background()); done <- err }()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) || !errors.Is(err, ErrLifecycleCoverageIncomplete) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("canceled idle QR retained its root")
+	}
+	select {
+	case _, ok := <-output:
+		if ok {
+			t.Fatal("unexpected QR payload")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("QR output not closed after cleanup")
+	}
+	cli.eventHandlersLock.RLock()
+	remaining := len(cli.eventHandlers)
+	cli.eventHandlersLock.RUnlock()
+	if remaining != 0 {
+		t.Fatalf("QR handler leaked: %d", remaining)
+	}
+}
+
+func TestLifecycleFrameOverflowChildJoinedAndCancellationRetained(t *testing.T) {
+	cli := syntheticLifecycleClient()
+	base, root, err := cli.BeginOperation(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer root.Finish(nil)
+	ctx, cancel := context.WithCancel(base)
+	defer cancel()
+	queue := make(chan *waBinary.Node, 1)
+	queue <- &waBinary.Node{Tag: "synthetic-filled-slot"}
+	frame, err := waBinary.Marshal(waBinary.Node{Tag: "message", Attrs: waBinary.Attrs{"id": "synthetic-overflow"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	cli.handleFrame(ctx, frame, queue)
+	cli.lifecycle.mu.Lock()
+	active := cli.lifecycle.active
+	cli.lifecycle.mu.Unlock()
+	if active != 2 {
