index 0000000..678590e
--- /dev/null
+++ b/lifecycle_source_inventory_test.go
@@ -0,0 +1,93 @@
+package whatsmeow
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"io/fs"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+)
+
+// This allowlist identifies registration implementations, not whole-client
+// coverage. New raw launches fail review even when the public drain refuses.
+func TestLifecycleSourceProducerInventory(t *testing.T) {
+	registered := map[string]int{
+		"lifecycle.go:LaunchContext":                   1,
+		"lifecycle_workers.go:launchLifecycle":         1,
+		"keyshare_drain.go:launchAppStateSyncKeyShare": 1,
+		"keyshare_drain.go:goAppStateKeyShareChild":    1,
+		"client.go:unlockedConnect":                    1,
+		"client.go:handlerQueueLoopWithScope":          1,
+		// The standalone socket fallback is a deliberate compatibility escape.
+		// Client-created sockets must install hooks; it never grants hold authority.
+		"socket/framesocket.go:launch": 1,
+	}
+	seen := map[string]int{}
+	var candidates []string
+	err := filepath.WalkDir(".", func(path string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if entry.IsDir() {
+			if entry.Name() == ".git" || entry.Name() == "proto" || entry.Name() == "vendor" {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if !strings.HasSuffix(path, ".go") || strings.HasSuffix(path, "_test.go") {
+			return nil
+		}
+		file, err := parser.ParseFile(token.NewFileSet(), path, nil, 0)
+		if err != nil {
+			return err
+		}
+		for _, decl := range file.Decls {
+			fn, ok := decl.(*ast.FuncDecl)
+			if !ok {
+				continue
+			}
+			key := filepath.ToSlash(path) + ":" + fn.Name.Name
+			ast.Inspect(fn.Body, func(node ast.Node) bool {
+				switch n := node.(type) {
+				case *ast.GoStmt:
+					seen[key]++
+					candidates = append(candidates, "goroutine "+key)
+				case *ast.CallExpr:
+					if sel, ok := n.Fun.(*ast.SelectorExpr); ok {
+						if id, ok := sel.X.(*ast.Ident); ok && id.Name == "time" && (sel.Sel.Name == "After" || sel.Sel.Name == "AfterFunc" || sel.Sel.Name == "NewTimer" || sel.Sel.Name == "NewTicker") {
+							candidates = append(candidates, "timer "+key+":"+sel.Sel.Name)
+						}
+						if sel.Sel.Name == "launchLifecycle" || sel.Sel.Name == "dispatchEvent" || sel.Sel.Name == "dispatchEventContext" || strings.HasPrefix(sel.Sel.Name, "AddEventHandler") {
+							candidates = append(candidates, "callback-or-registration "+key+":"+sel.Sel.Name)
+						}
+					}
+				}
+				return true
+			})
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for key, count := range seen {
+		if registered[key] != count {
+			t.Errorf("unreviewed raw worker %s count=%d expected=%d", key, count, registered[key])
+		}
+	}
+	for key, count := range registered {
+		if seen[key] != count {
+			t.Errorf("producer inventory stale %s count=%d expected=%d", key, seen[key], count)
+		}
+	}
+	sort.Strings(candidates)
+	for _, candidate := range candidates {
+		t.Log(candidate)
+	}
+	if len(LifecycleCoverageGaps()) == 0 {
+		t.Fatal("incomplete public/foreign ownership cannot be waived by the source inventory")
+	}
+}
diff --git a/lifecycle_workers.go b/lifecycle_workers.go
new file mode 100644
index 0000000..17aacdf
--- /dev/null
+++ b/lifecycle_workers.go
@@ -0,0 +1,96 @@
+package whatsmeow
+
+import (
+	"context"
+	"fmt"
+	"runtime/debug"
+)
+
+type lifecycleContextKey struct{}
+
+// lifecycleContext preserves ownership, not cancellation. A scope from another
+// client is never a capability to register children on this client.
+func (cli *Client) lifecycleContext(ctx context.Context, scope *LifecycleScope) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, lifecycleContextKey{}, scope)
+}
+
+func (cli *Client) scopeForContext(ctx context.Context) (*LifecycleScope, error) {
+	if ctx != nil {
+		if parent, ok := ctx.Value(lifecycleContextKey{}).(*LifecycleScope); ok && parent != nil && parent.owner == cli.lifecycle {
+			return parent.Child()
+		}
+	}
+	return cli.BeginLifecycleScope(ctx)
+}
+
+// launchLifecycle admits before launch. Accepted descendants remain admissible
+// after root sealing. Rejection is sticky even for legacy void call sites.
+func (cli *Client) launchLifecycle(ctx context.Context, fn func(context.Context) error) error {
+	scope, err := cli.scopeForContext(ctx)
+	if err != nil {
+		cli.lifecycle.recordError(err)
+		cli.Log.Warnf("Rejected lifecycle worker: %v", err)
+		return err
+	}
+	ctx = cli.lifecycleContext(ctx, scope)
+	go func() {
+		var workErr error
+		defer func() {
+			if recovered := recover(); recovered != nil {
+				if cause, ok := recovered.(error); ok {
+					workErr = fmt.Errorf("lifecycle worker panic: %w", cause)
+				} else {
+					workErr = fmt.Errorf("lifecycle worker panic: %v", recovered)
+				}
+				cli.Log.Errorf("Lifecycle worker panicked: %v\n%s", recovered, debug.Stack())
+			}
+			scope.Finish(workErr)
+		}()
+		workErr = fn(ctx)
+	}()
+	return nil
+}
+
+func (l *clientLifecycle) recordError(err error) {
+	if err == nil {
+		return
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.err == nil {
+		l.err = err
+	}
+}
+
+// Every production key-share root also enters the common lifecycle owner.
+// Sealing this one gate atomically closes all registered root classes. Do not
+// seal the narrow key-share counter yet: a live accepted node scope can still
+// produce a causal key-share child while the common owner is being joined.
+func (cli *Client) sealLifecycleRoots() {
+	l := cli.lifecycle
+	l.mu.Lock()
+	l.sealed = true
+	l.completeLocked()
+	l.mu.Unlock()
+}
+
+// holdKnown is only a boundary for this registry, not whole-client authority.
+// BeginDrain intentionally never exposes it while coverage remains incomplete.
+func (l *clientLifecycle) holdKnown(ctx context.Context) (*HeldBoundary, error) {
+	if err := l.drain(ctx); err != nil {
+		return nil, err
+	}
+	return &HeldBoundary{owner: l}, nil
+}
+
+func (cli *Client) beginLifecycleWorker(ctx context.Context) (context.Context, func(error), error) {
+	scope, err := cli.scopeForContext(ctx)
+	if err != nil {
+		cli.lifecycle.recordError(err)
+		return nil, nil, err
+	}
+	return cli.lifecycleContext(ctx, scope), scope.Finish, nil
+}
