+)
+
+func TestLifecycleHistorySyncRejectedStartResetsFlagWithoutEnqueue(t *testing.T) {
+	cli := NewClient(&store.Device{}, nil)
+	cli.sealLifecycleRoots()
+	info := &types.MessageInfo{MessageSource: types.MessageSource{IsFromMe: true}}
+	msg := &waE2E.Message{ProtocolMessage: &waE2E.ProtocolMessage{
+		HistorySyncNotification: &waE2E.HistorySyncNotification{},
+	}}
+	if cli.handleProtocolMessage(context.Background(), info, msg) != true {
+		t.Fatal("expected protocol handler to remain successful")
+	}
+	if cli.historySyncHandlerStarted.Load() {
+		t.Fatal("rejected history loop left started flag set")
+	}
+	if got := len(cli.historySyncNotifications); got != 0 {
+		t.Fatalf("rejected history loop enqueued %d notifications", got)
+	}
+}
+
+func TestLifecycleHistorySyncAcceptedRootCancelsAndDrainJoins(t *testing.T) {
+	cli := NewClient(&store.Device{}, nil)
+	ctx, cancel := context.WithCancel(context.Background())
+	if !cli.startHistorySyncNotificationLoop(ctx) {
+		t.Fatal("accepted history loop was rejected")
+	}
+	cli.sealLifecycleRoots()
+	cancel()
+	deadline := time.After(time.Second)
+	for cli.historySyncHandlerStarted.Load() {
+		select {
+		case <-deadline:
+			t.Fatal("history loop did not stop after cancellation")
+		default:
+			time.Sleep(time.Millisecond)
+		}
+	}
+	if _, err := cli.BeginDrain(context.Background()); !errors.Is(err, ErrLifecycleCoverageIncomplete) {
+		t.Fatalf("drain did not join accepted history root: %v", err)
+	}
+}
+
+func TestLifecycleAcceptedOfflineSyncPreviewDispatchAfterSeal(t *testing.T) {
+	cli := NewClient(&store.Device{}, nil)
+	ctx, root, err := cli.BeginOperation(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	cancelCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	seen := make(chan *events.OfflineSyncPreview, 1)
+	cli.AddEventHandler(func(evt any) {
+		if preview, ok := evt.(*events.OfflineSyncPreview); ok {
+			seen <- preview
+		}
+	})
+	if !cli.startHistorySyncNotificationLoop(cancelCtx) {
+		t.Fatal("accepted history loop was rejected")
+	}
+	cli.sealLifecycleRoots()
+	cli.handleIB(ctx, &waBinary.Node{Tag: "ib", Content: []waBinary.Node{{
+		Tag: "offline_preview", Attrs: waBinary.Attrs{"count": "7", "message": "3"},
+	}}})
+	select {
+	case preview := <-seen:
+		if preview.Total != 7 || preview.Messages != 3 {
+			t.Fatalf("unexpected preview: %+v", preview)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("OfflineSyncPreview was not dispatched after sealing")
+	}
+	cancel()
+	root.Finish(nil)
+	if _, err := cli.BeginDrain(context.Background()); !errors.Is(err, ErrLifecycleCoverageIncomplete) {
+		t.Fatalf("drain did not join accepted roots: %v", err)
+	}
+}
