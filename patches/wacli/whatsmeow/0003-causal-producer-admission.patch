+// LifecycleHooks lets callers register socket-owned goroutines before launch.
+type LifecycleHooks struct {
+	Launch      func(context.Context, func(context.Context) error) error
+	Begin       func(context.Context) (context.Context, func(error), error)
+	ReportError func(error)
+}
+
+func (fs *FrameSocket) SetLifecycleHooks(hooks LifecycleHooks) {
+	fs.lock.Lock()
+	fs.hooks = hooks
+	fs.lock.Unlock()
+}
+
+func (fs *FrameSocket) reportError(err error) {
+	if err == nil {
+		return
+	}
+	fs.lock.Lock()
+	report := fs.hooks.ReportError
+	fs.lock.Unlock()
+	if report != nil {
+		report(err)
+	}
+}
+
+func (fs *FrameSocket) launch(ctx context.Context, fn func(context.Context) error) error {
+	fs.lock.Lock()
+	hook := fs.hooks.Launch
+	fs.lock.Unlock()
+	if hook != nil {
+		return hook(ctx, fn)
+	}
+	go func() { _ = fn(ctx) }()
+	return nil
+}
+
