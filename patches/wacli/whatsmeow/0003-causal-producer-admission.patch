@@ -0,0 +1,15 @@
+package whatsmeow
+
+// LifecycleCoverageGaps describes why BeginDrain still returns no boundary.
+// A fresh slice is returned: callers cannot approve, waive, or remove a gap.
+// Registering all visible go statements does not revoke previously borrowed
+// handles or force arbitrary user callbacks to register their own descendants.
+func LifecycleCoverageGaps() []string {
+	return []string{
+		"public synchronous client APIs and previously borrowed Store/DangerousInternals handles are not a revocable admission facade",
+		"legacy event handlers and arbitrary user callbacks can launch work without returning or propagating operation scopes",
+		"socket package standalone callers may omit the additive worker launcher; foreign transports and writable handles are outside client ownership",
+		"queued node/frame membership and all error-only logging continuations are not a verified whole-client persistence frontier",
+		"application and foreign-process media writers require their own exhaustive ownership and retained immutable membership contract",
+	}
+}
