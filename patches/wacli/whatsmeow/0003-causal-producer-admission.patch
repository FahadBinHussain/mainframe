@@ -0,0 +1,244 @@
+package whatsmeow
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/store"
+)
+
+func syntheticLifecycleClient() *Client { return NewClient(&store.Device{}, nil) }
+
+func TestLifecycleAtomicAllRootSealBeforeWait(t *testing.T) {
+	cli := syntheticLifecycleClient()
+	root, err := cli.BeginScope(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer root.Finish(nil)
+	result := make(chan error, 1)
+	go func() {
+		held, err := cli.BeginDrain(context.Background())
+		if held != nil {
+			result <- errors.New("partial SDK returned a held boundary")
+			return
+		}
+		result <- err
+	}()
+	deadline := time.After(time.Second)
+	for {
+		cli.lifecycle.mu.Lock()
+		generic := cli.lifecycle.sealed
+		cli.lifecycle.mu.Unlock()
+		if generic {
+			break
+		}
+		select {
+		case <-deadline:
+			t.Fatal("sealing waited for a live generic worker")
+		default:
+			time.Sleep(time.Millisecond)
+		}
+	}
+	if err := cli.launchAppStateSyncKeyShare(context.Background(), nil); !errors.Is(err, ErrLifecycleSealed) {
+		t.Fatalf("key-share root still admitted while generic work live: %v", err)
+	}
+	select {
+	case err := <-result:
+		t.Fatalf("returned while root live: %v", err)
+	default:
+	}
+	root.Finish(nil)
+	if err := <-result; !errors.Is(err, ErrLifecycleCoverageIncomplete) {
+		t.Fatal(err)
+	}
+}
+
+func TestLifecycleHeldKnownOnlyAfterGrandchild(t *testing.T) {
+	cli := syntheticLifecycleClient()
+	ctx, root, err := cli.BeginOperation(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	result := make(chan *HeldBoundary, 1)
+	go func() {
+		held, err := cli.lifecycle.holdKnown(context.Background())
+		if err != nil {
+			result <- nil
+			return
+		}
+		result <- held
+	}()
+	// Seal synchronously without canceling accepted work.
+	canceled, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := cli.lifecycle.drain(canceled); !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	entered, release := make(chan struct{}), make(chan struct{})
+	t.Cleanup(func() {
+		select {
+		case <-release:
+		default:
+			close(release)
+		}
+	})
+	if err := cli.launchLifecycle(ctx, func(childCtx context.Context) error {
+		return cli.launchLifecycle(childCtx, func(context.Context) error { close(entered); <-release; return nil })
+	}); err != nil {
+		t.Fatal(err)
+	}
+	root.Finish(nil)
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("descendant not started")
+	}
+	select {
+	case <-result:
+		t.Fatal("held boundary preceded descendant completion")
+	default:
+	}
+	close(release)
+	select {
+	case held := <-result:
+		if held == nil || held.owner != cli.lifecycle {
+			t.Fatal("missing registry-only hold")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("hold did not finish")
+	}
+	if _, err := root.Child(); !errors.Is(err, ErrLifecycleScopeDone) {
+		t.Fatal(err)
+	}
+	if _, err := cli.BeginScope(context.Background()); !errors.Is(err, ErrLifecycleSealed) {
+		t.Fatal(err)
+	}
+	held, err := cli.BeginDrain(context.Background())
+	if held != nil || !errors.Is(err, ErrLifecycleCoverageIncomplete) {
+		t.Fatalf("registry hold became whole-client authority: %v %v", held, err)
+	}
+}
+
+func TestLifecycleConcurrentSealAdmissionStableZero(t *testing.T) {
+	for range 100 {
+		l := newClientLifecycle()
+		start := make(chan struct{})
+		var wg sync.WaitGroup
+		for range 16 {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				<-start
+				op, err := l.admit()
+				if err == nil {
+					op.Finish(nil)
+				} else if !errors.Is(err, ErrLifecycleSealed) {
+					t.Errorf("admission: %v", err)
+				}
+			}()
+		}
+		close(start)
+		held, err := l.holdKnown(context.Background())
+		if err != nil || held == nil {
+			t.Fatal(err)
+		}
+		wg.Wait()
+		l.mu.Lock()
+		active, sealed := l.active, l.sealed
+		l.mu.Unlock()
+		if active != 0 || !sealed {
+			t.Fatalf("unstable zero active=%d sealed=%v", active, sealed)
+		}
+	}
+}
+
+func TestLifecycleLaunchPanicAndForeignContextFailClosed(t *testing.T) {
+	cli := syntheticLifecycleClient()
+	failure := errors.New("synthetic worker panic")
+	if err := cli.launchLifecycle(context.Background(), func(context.Context) error { panic(failure) }); err != nil {
+		t.Fatal(err)
+	}
+	held, err := cli.BeginDrain(context.Background())
+	if held != nil || !errors.Is(err, failure) || !errors.Is(err, ErrLifecycleCoverageIncomplete) {
+		t.Fatalf("panic lost: %v %v", held, err)
+	}
+	other := syntheticLifecycleClient()
+	ctx, root, err := other.BeginOperation(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer root.Finish(nil)
+	if err := cli.launchLifecycle(ctx, func(context.Context) error { t.Error("foreign scope reopened owner"); return nil }); !errors.Is(err, ErrLifecycleSealed) {
+		t.Fatal(err)
+	}
+}
+
+func TestLifecycleKeyShareDescendantAfterCanceledDrain(t *testing.T) {
+	failure := errors.New("synthetic causal key-store failure")
+	keys := &drainTestKeys{entered: make(chan error, 1), release: make(chan struct{}), failure: failure}
+	cli := NewClient(&store.Device{AppStateKeys: keys, AppState: &drainTestVersions{}}, nil)
+	ctx, root, err := cli.BeginOperation(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var once sync.Once
+	release := func() { once.Do(func() { close(keys.release) }) }
+	t.Cleanup(func() { release(); root.Finish(nil) })
+	canceled, cancel := context.WithCancel(context.Background())
+	cancel()
+	held, err := cli.BeginDrain(canceled)
+	if held != nil || !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled drain=%v %v", held, err)
+	}
+	share := &waE2E.AppStateSyncKeyShare{Keys: []*waE2E.AppStateSyncKey{{
+		KeyID:   &waE2E.AppStateSyncKeyId{KeyID: []byte("synthetic")},
+		KeyData: &waE2E.AppStateSyncKeyData{KeyData: []byte("synthetic")},
+	}}}
+	if err := cli.launchAppStateSyncKeyShare(ctx, share); err != nil {
+		t.Fatalf("accepted causal child rejected: %v", err)
+	}
+	root.Finish(nil)
+	select {
+	case <-keys.entered:
+	case <-time.After(time.Second):
+		t.Fatal("accepted key persistence never started")
+	}
+	done := make(chan error, 1)
+	go func() {
+		held, err := cli.BeginDrain(context.Background())
+		if held != nil {
+			done <- errors.New("whole-client hold escaped coverage refusal")
+			return
+		}
+		done <- err
+	}()
+	select {
+	case <-done:
+		t.Fatal("key persistence escaped join")
+	default:
+	}
+	release()
+	if err := <-done; !errors.Is(err, failure) || !errors.Is(err, ErrLifecycleCoverageIncomplete) {
+		t.Fatalf("causal error lost: %v", err)
+	}
+}
+
+// Legacy void producers cannot return a launch error, but may not erase it.
+func TestLifecycleIgnoredLaunchRejectionRetainedByDrain(t *testing.T) {
+	cli := syntheticLifecycleClient()
+	cli.sealLifecycleRoots()
+	called := false
+	_ = cli.launchLifecycle(context.Background(), func(context.Context) error {
+		called = true
+		return nil
+	})
+	held, err := cli.BeginDrain(context.Background())
+	if called || held != nil || !errors.Is(err, ErrLifecycleSealed) || !errors.Is(err, ErrLifecycleCoverageIncomplete) {
+		t.Fatalf("ignored launch rejection lost: called=%v held=%v err=%v", called, held, err)
+	}
+}
