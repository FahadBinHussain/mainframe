@@ -0,0 +1,62 @@
+package whatsmeow
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	waLog "go.mau.fi/whatsmeow/util/log"
+)
+
+func protocolLifecycleTestClient() *Client {
+	return &Client{
+		Log:                   waLog.Noop,
+		lifecycle:             newClientLifecycle(),
+		appStateKeyShareDrain: newAppStateKeyShareDrain(),
+		BackgroundEventCtx:    context.Background(),
+	}
+}
+
+func TestProtocolLifecycleLaunchRegistersAndRetainsWorkerError(t *testing.T) {
+	cli := protocolLifecycleTestClient()
+	want := errors.New("synthetic protocol worker failure")
+	started := make(chan struct{})
+	if err := cli.launchLifecycle(context.Background(), func(context.Context) error {
+		close(started)
+		return want
+	}); err != nil {
+		t.Fatalf("launchLifecycle rejected worker: %v", err)
+	}
+	<-started
+	_, err := cli.BeginDrain(context.Background())
+	if !errors.Is(err, want) {
+		t.Fatalf("BeginDrain error %v does not retain worker error %v", err, want)
+	}
+	if !errors.Is(err, ErrLifecycleCoverageIncomplete) {
+		t.Fatalf("BeginDrain error %v lost coverage marker", err)
+	}
+}
+
+func TestProtocolLifecycleLaunchDescendantRegistersAfterRootSeals(t *testing.T) {
+	cli := protocolLifecycleTestClient()
+	root, err := cli.BeginLifecycleScope(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := cli.lifecycleContext(context.Background(), root)
+	childStarted := make(chan struct{})
+	childRelease := make(chan struct{})
+	if err := cli.launchLifecycle(ctx, func(context.Context) error {
+		close(childStarted)
+		<-childRelease
+		return nil
+	}); err != nil {
+		t.Fatalf("descendant launch rejected: %v", err)
+	}
+	root.Finish(nil)
+	close(childRelease)
+	<-childStarted
+	if _, err := cli.BeginDrain(context.Background()); !errors.Is(err, ErrLifecycleCoverageIncomplete) {
+		t.Fatalf("drain after descendant completion = %v, want coverage marker", err)
+	}
+}
