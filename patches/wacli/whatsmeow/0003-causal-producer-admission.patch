+	}
+	wait, cancelWait := context.WithCancel(context.Background())
+	cancelWait()
+	_, _ = cli.BeginDrain(wait)
+	root.Finish(nil)
+	done := make(chan error, 1)
+	go func() { _, err := cli.BeginDrain(context.Background()); done <- err }()
+	select {
+	case <-done:
+		t.Fatal("overflow enqueue escaped join")
+	default:
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) || !errors.Is(err, ErrLifecycleCoverageIncomplete) {
+			t.Fatalf("dropped overflow failure lost: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("overflow worker failed to exit")
+	}
+}
