+func TestLifecycleCallbackContextFinishesPerCallback(t *testing.T) {
+	cli := syntheticLifecycleClient()
+	returned := make(chan context.Context, 1)
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	cli.AddEventHandlerWithContext(func(ctx context.Context, _ any) error {
+		returned <- ctx
+		return nil
+	})
+	cli.AddEventHandlerWithContext(func(context.Context, any) error {
+		close(entered)
+		<-release
+		return nil
+	})
+	done := make(chan bool, 1)
+	go func() { done <- cli.dispatchEventContext(context.Background(), "synthetic") }()
+	ctx := <-returned
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("second callback did not start")
+	}
+	if err := cli.launchLifecycle(ctx, func(context.Context) error { t.Error("escaped callback context admitted work"); return nil }); !errors.Is(err, ErrLifecycleScopeDone) {
+		t.Fatalf("escaped context admission=%v", err)
+	}
+	for _, begin := range []func(context.Context) (*LifecycleScope, error){cli.BeginScope, cli.BeginLifecycleScope} {
+		if scope, err := begin(ctx); !errors.Is(err, ErrLifecycleScopeDone) {
+			if scope != nil {
+				scope.Finish(nil)
+			}
+			t.Errorf("escaped callback context reopened public root admission: %v", err)
+		}
+	}
+	if _, scope, err := cli.BeginOperation(ctx); !errors.Is(err, ErrLifecycleScopeDone) {
+		if scope != nil {
+			scope.Finish(nil)
+		}
+		t.Errorf("escaped callback context reopened operation admission: %v", err)
+	}
+	close(release)
+	if <-done {
+		t.Fatal("callbacks unexpectedly failed")
+	}
+}
