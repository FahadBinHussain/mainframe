+// dispatchEventHandler runs one callback under a distinct child scope. The
+// callback context is deliberately finished on every return path, so a context
+// retained by a callback cannot register work after that callback has returned.
+func (cli *Client) dispatchEventHandler(parent *LifecycleScope, ctx context.Context, handler wrappedEventHandler, evt any) (failed bool) {
+	callback, err := parent.Child()
+	if err != nil {
+		cli.lifecycle.recordError(err)
+		return true
+	}
+	ctx = cli.lifecycleContext(ctx, callback)
+	var callbackErr error
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			if cause, ok := recovered.(error); ok {
+				callbackErr = fmt.Errorf("event handler panic: %w", cause)
+			} else {
+				callbackErr = fmt.Errorf("event handler panic: %v", recovered)
+			}
+			cli.Log.Errorf("Event handler panicked: %v\n%s", recovered, debug.Stack())
+			failed = true
+		}
+		if callbackErr != nil {
+			cli.lifecycle.recordError(callbackErr)
+			failed = true
+		}
+		callback.Finish(callbackErr)
+	}()
+	if handler.ctxfn != nil {
+		callbackErr = handler.ctxfn(ctx, evt)
+		if callbackErr != nil {
+			failed = true
+		}
+	} else if handler.fn != nil && !handler.fn(evt) {
+		callbackErr = fmt.Errorf("event handler rejected %T", evt)
+		failed = true
+	}
+	return failed
+}
