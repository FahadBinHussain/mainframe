diff --git a/lifecycle.go b/lifecycle.go
new file mode 100644
index 0000000..f97d164
--- /dev/null
+++ b/lifecycle.go
@@ -0,0 +1,181 @@
+package whatsmeow
+
+import (
+	"context"
+	"errors"
+	"sync"
+)
+
+// ErrLifecycleCoverageIncomplete is returned by BeginDrain because this pinned
+// SDK does not yet own every asynchronous client root. A nil HeldBoundary is
+// always returned with this error; callers must not treat a partial drain as a
+// whole-client capture frontier.
+var ErrLifecycleCoverageIncomplete = errors.New("whatsmeow lifecycle coverage is incomplete")
+
+// HeldBoundary is intentionally opaque. It is only returned when the SDK can
+// prove that every client root and accepted descendant is quiescent. The
+// current pinned SDK never returns one from BeginDrain.
+type HeldBoundary struct{ _ struct{} }
+
+type clientLifecycle struct {
+	mu     sync.Mutex
+	active int
+	sealed bool
+	done   chan struct{}
+	closed bool
+	err    error
+}
+
+func newClientLifecycle() *clientLifecycle { return &clientLifecycle{done: make(chan struct{})} }
+
+// LifecycleScope tracks one accepted asynchronous operation. Register a scope
+// before launching work; Child remains legal after root sealing while its
+// parent is live, but not after Finish.
+type LifecycleScope struct {
+	owner *clientLifecycle
+	done  bool
+}
+
+// Operation is the public name for a tracked lifecycle scope.
+type Operation = LifecycleScope
+
+func (l *clientLifecycle) admit() (*LifecycleScope, error) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.sealed {
+		return nil, ErrLifecycleSealed
+	}
+	l.active++
+	return &LifecycleScope{owner: l}, nil
+}
+
+// ErrLifecycleSealed reports root admission after BeginDrain has sealed.
+var ErrLifecycleSealed = errors.New("whatsmeow lifecycle admission is sealed")
+var ErrLifecycleScopeDone = errors.New("whatsmeow lifecycle scope is finished")
+
+// BeginLifecycleScope admits a root operation. The caller must call Finish,
+// including on launch failure, and should use Child for causal descendants.
+func (cli *Client) BeginLifecycleScope(ctx context.Context) (*LifecycleScope, error) {
+	if ctx != nil {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+	}
+	return cli.lifecycle.admit()
+}
+
+// BeginOperation admits a root operation and returns the context selected by
+// the caller together with its tracker. The context is returned for convenient
+// propagation; admission itself is still linearized independently.
+func (cli *Client) BeginOperation(ctx context.Context) (context.Context, *Operation, error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	op, err := cli.BeginLifecycleScope(ctx)
+	return ctx, op, err
+}
+
+// BeginScope is the concise alias for BeginLifecycleScope.
+func (cli *Client) BeginScope(ctx context.Context) (*LifecycleScope, error) {
+	return cli.BeginLifecycleScope(ctx)
+}
+
+// Child admits a causal descendant. It is linearized with Finish and therefore
+// cannot race into existence after its parent has finished.
+func (s *LifecycleScope) Child() (*LifecycleScope, error) {
+	if s == nil || s.owner == nil {
+		return nil, ErrLifecycleScopeDone
+	}
+	l := s.owner
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if s.done {
+		return nil, ErrLifecycleScopeDone
+	}
+	l.active++
+	return &LifecycleScope{owner: l}, nil
+}
+
+// Launch registers a child before starting its goroutine and retains its error.
+func (s *LifecycleScope) Launch(fn func(context.Context) error) error {
+	return s.LaunchContext(context.Background(), fn)
+}
+
+// LaunchContext registers a child before starting its goroutine.
+func (s *LifecycleScope) LaunchContext(ctx context.Context, fn func(context.Context) error) error {
+	child, err := s.Child()
+	if err != nil {
+		return err
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	go func() {
+		var workErr error
+		defer func() { child.Finish(workErr) }()
+		workErr = fn(ctx)
+	}()
+	return nil
+}
+
+// Finish releases this scope. It is idempotent and retains the first error.
+func (s *LifecycleScope) Finish(err error) {
+	if s == nil || s.owner == nil {
+		return
+	}
+	l := s.owner
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if s.done {
+		return
+	}
+	s.done = true
+	if l.err == nil && err != nil {
+		l.err = err
+	}
+	l.active--
+	l.completeLocked()
+}
+
+func (l *clientLifecycle) completeLocked() {
+	if l.sealed && l.active == 0 && !l.closed {
+		l.closed = true
+		close(l.done)
+	}
+}
+
+func (l *clientLifecycle) drain(ctx context.Context) error {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	l.mu.Lock()
+	l.sealed = true
+	l.completeLocked()
+	done := l.done
+	l.mu.Unlock()
+	select {
+	case <-done:
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		l.mu.Lock()
+		defer l.mu.Unlock()
+		return l.err
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+// BeginDrain seals all lifecycle roots known to this SDK and waits for accepted
+// scopes and the existing app-state key-share scopes. Since socket callbacks,
+// reconnects, timers, node handlers, and arbitrary callback-launched work are
+// not all registered yet, it deliberately returns ErrLifecycleCoverageIncomplete
+// rather than a successful whole-client held boundary.
+func (cli *Client) BeginDrain(ctx context.Context) (*HeldBoundary, error) {
+	genericErr := cli.lifecycle.drain(ctx)
+	keyErr := cli.appStateKeyShareDrain.drain(ctx)
+	if genericErr != nil || keyErr != nil {
+		return nil, errors.Join(genericErr, keyErr)
+	}
+	return nil, ErrLifecycleCoverageIncomplete
+}
