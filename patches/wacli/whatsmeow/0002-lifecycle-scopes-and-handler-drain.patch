index 0000000..78159ab
--- /dev/null
+++ b/lifecycle_test.go
@@ -0,0 +1,68 @@
+package whatsmeow
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestLifecycleOperationDescendantAndStickyError(t *testing.T) {
+	l := newClientLifecycle()
+	root, err := l.admit()
+	if err != nil {
+		t.Fatal(err)
+	}
+	drained := make(chan error, 1)
+	go func() { drained <- l.drain(context.Background()) }()
+	child, err := root.Child()
+	if err != nil {
+		t.Fatal(err)
+	}
+	root.Finish(nil)
+	if _, err := root.Child(); !errors.Is(err, ErrLifecycleScopeDone) {
+		t.Fatalf("late child=%v", err)
+	}
+	failure := errors.New("synthetic failure")
+	child.Finish(failure)
+	child.Finish(nil)
+	if err := <-drained; !errors.Is(err, failure) {
+		t.Fatalf("drain error=%v", err)
+	}
+	if err := l.drain(context.Background()); !errors.Is(err, failure) {
+		t.Fatalf("sticky error=%v", err)
+	}
+}
+
+func TestLifecycleDrainCancellationSealsAdmission(t *testing.T) {
+	l := newClientLifecycle()
+	root, err := l.admit()
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if !errors.Is(l.drain(ctx), context.Canceled) {
+		t.Fatal("canceled drain succeeded")
+	}
+	if _, err := l.admit(); !errors.Is(err, ErrLifecycleSealed) {
+		t.Fatalf("late admission=%v", err)
+	}
+	child, err := root.Child()
+	if err != nil {
+		t.Fatalf("accepted root could not create child after sealing: %v", err)
+	}
+	root.Finish(nil)
+	grandchild, err := child.Child()
+	if err != nil {
+		t.Fatalf("live child could not create grandchild after ancestor finished: %v", err)
+	}
+	child.Finish(nil)
+	grandchild.Finish(nil)
+	deadline := time.After(time.Second)
+	select {
+	case <-l.done:
+	case <-deadline:
+		t.Fatal("drain did not complete")
+	}
+}
