diff --git a/handler_loop_lifecycle_test.go b/handler_loop_lifecycle_test.go
new file mode 100644
index 0000000..37ad3b2
--- /dev/null
+++ b/handler_loop_lifecycle_test.go
@@ -0,0 +1,98 @@
+package whatsmeow
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/store"
+)
+
+func TestSyntheticHandlerChildOutlivesQueueLoop(t *testing.T) {
+	cli := NewClient(&store.Device{}, nil)
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	cli.nodeHandlers["synthetic"] = func(context.Context, *binary.Node) {
+		close(entered)
+		<-release
+	}
+	scope, err := cli.BeginScope(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	queue := make(chan *binary.Node, 1)
+	closeWait := make(chan struct{})
+	connCtx, cancel := context.WithCancel(context.Background())
+	go cli.handlerQueueLoopWithScope(context.Background(), connCtx, queue, closeWait, scope)
+	queue <- &binary.Node{Tag: "synthetic"}
+	<-entered
+	cancel()
+	select {
+	case <-closeWait:
+	case <-time.After(time.Second):
+		t.Fatal("queue loop did not finish after cancellation")
+	}
+	drained := make(chan error, 1)
+	go func() { _, err := cli.BeginDrain(context.Background()); drained <- err }()
+	select {
+	case err := <-drained:
+		t.Fatalf("drain completed while handler was still running: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case err := <-drained:
+		if !errors.Is(err, ErrLifecycleCoverageIncomplete) {
+			t.Fatalf("expected explicit incomplete coverage, got %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("drain did not wait for actual handler return")
+	}
+}
+
+func TestSyntheticQueuedCancellationIsSticky(t *testing.T) {
+	cli := NewClient(&store.Device{}, nil)
+	scope, err := cli.BeginScope(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	queue := make(chan *binary.Node, 1)
+	queue <- &binary.Node{Tag: "synthetic"}
+	closeWait := make(chan struct{})
+	connCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+	go cli.handlerQueueLoopWithScope(context.Background(), connCtx, queue, closeWait, scope)
+	select {
+	case <-closeWait:
+	case <-time.After(time.Second):
+		t.Fatal("queue loop did not clean up canceled queue")
+	}
+	_, err = cli.BeginDrain(context.Background())
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("expected sticky cancellation error, got %v", err)
+	}
+}
+
+func TestSyntheticDangerousInternalsQueueStillProcessesNodes(t *testing.T) {
+	cli := NewClient(&store.Device{}, nil)
+	processed := make(chan struct{})
+	cli.nodeHandlers["synthetic"] = func(context.Context, *binary.Node) { close(processed) }
+	queue := make(chan *binary.Node, 1)
+	closeWait := make(chan struct{})
+	connCtx, cancel := context.WithCancel(context.Background())
+	go cli.DangerousInternals().HandlerQueueLoop(context.Background(), connCtx, queue, closeWait)
+	queue <- &binary.Node{Tag: "synthetic"}
+	select {
+	case <-processed:
+	case <-time.After(time.Second):
+		t.Fatal("raw queue loop skipped injected node")
+	}
+	cancel()
+	select {
+	case <-closeWait:
+	case <-time.After(time.Second):
+		t.Fatal("raw queue loop did not close")
+	}
+}
