@@ -211,0 +212,14 @@ func (a *App) drainContactJournal(ctx context.Context) (covered uint64, err erro
+
+// OwnedSaveContact retains the child lease through the complete account save,
+// including journal mirroring and persistence completion.
+func (a *App) OwnedSaveContact(ctx context.Context, target types.JID, fullName, firstName string, phonebook bool) (saved SavedContact, err error) {
+	if err := a.admitHandle(ctx); err != nil {
+		return SavedContact{}, err
+	}
+	child, finish, err := RegisterOperationChild(ctx)
+	if err != nil {
+		return SavedContact{}, errors.Join(ErrHandleRevoked, err)
+	}
+	defer finishOwnedEffect(finish, &err)
+	return a.SaveContact(child, target, fullName, firstName, phonebook)
+}
