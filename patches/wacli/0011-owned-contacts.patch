+func resolveContactReadJID(ctx context.Context, db *app.OwnedDB, rawJID string) (string, error) {
+	rawJID = strings.TrimSpace(rawJID)
+	jid, err := types.ParseJID(rawJID)
+	if err != nil {
+		return rawJID, nil
+	}
+	if jid.Server == types.HiddenUserServer {
+		pn, err := db.ResolveLIDToPNWithError(ctx, jid)
+		if err != nil {
+			return "", err
+		}
+		if pn.User != "" && pn.Server == types.DefaultUserServer {
+			return pn.ToNonAD().String(), nil
+		}
+	}
+	return canonicalCLIJID(jid).String(), nil
+}
+func contactIdentityJIDs(ctx context.Context, db *app.OwnedDB, rawJID string) ([]string, error) {
+	canonical, err := resolveContactReadJID(ctx, db, rawJID)
+	if err != nil {
+		return nil, err
+	}
+	jids := []string{canonical}
+	jid, err := types.ParseJID(canonical)
+	if err == nil && jid.Server == types.DefaultUserServer {
+		lid, err := db.ResolvePNToLIDWithError(ctx, jid)
+		if err != nil {
+			return nil, err
+		}
+		lid = lid.ToNonAD()
+		if lid.User != "" && lid.Server == types.HiddenUserServer {
+			jids = append(jids, lid.String())
+		}
+	}
+	return jids, nil
+}
+
+func contactMetadataJIDs(ctx context.Context, a *app.App, rawJID string) ([]string, error) {
+	db, err := a.OwnedDB(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if err := db.CheckContactResolver(ctx); err != nil {
+
+		return nil, err
+	}
+	return contactIdentityJIDs(ctx, db, rawJID)
+}
