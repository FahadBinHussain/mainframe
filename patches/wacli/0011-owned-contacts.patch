@@ -0,0 +1,144 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+type ownedContactSaveProbe struct {
+	WAClient
+	calls            atomic.Int32
+	entered, release chan struct{}
+}
+
+func (p *ownedContactSaveProbe) ResolvePNToLID(context.Context, types.JID) types.JID {
+	p.calls.Add(1)
+	close(p.entered)
+	<-p.release
+	return types.JID{}
+}
+func (*ownedContactSaveProbe) Disconnect() {}
+func (*ownedContactSaveProbe) Close()      {}
+
+func TestOwnedContactSaveInvocationJoinsAfterParentFinish(t *testing.T) {
+	a, _, ctx, finish := ownedTestApp(t)
+	probe := &ownedContactSaveProbe{entered: make(chan struct{}), release: make(chan struct{})}
+	a.wa = probe
+	var release sync.Once
+	defer release.Do(func() { close(probe.release) })
+	sealed, cancel := context.WithCancel(context.Background())
+	cancel()
+	if held, err := a.BeginDrain(sealed); held != nil || !errors.Is(err, ErrDrainCoverageIncomplete) {
+		t.Fatalf("seal = %v %v", held, err)
+	}
+	result := make(chan error, 1)
+	go func() {
+		_, err := a.OwnedSaveContact(ctx, types.JID{User: "15550009999", Server: types.DefaultUserServer}, "Synthetic", "Synthetic", false)
+		result <- err
+	}()
+	select {
+	case <-probe.entered:
+	case <-time.After(time.Second):
+		t.Fatal("save did not enter")
+	}
+	finish(nil)
+	drain := make(chan error, 1)
+	go func() { _, err := a.BeginDrain(context.Background()); drain <- err }()
+	select {
+	case err := <-drain:
+		t.Fatalf("save escaped drain: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	release.Do(func() { close(probe.release) })
+	var saveErr error
+	select {
+	case saveErr = <-result:
+		if saveErr == nil {
+			t.Fatal("missing-LID error lost")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("save did not finish")
+	}
+	select {
+	case err := <-drain:
+		if !errors.Is(err, saveErr) || !errors.Is(err, ErrDrainCoverageIncomplete) {
+			t.Fatalf("save cause lost: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("drain did not join")
+	}
+	if probe.calls.Load() != 1 {
+		t.Fatal("unexpected client count")
+	}
+}
+
+func TestOwnedContactResolverMissingSessionDoesNotCreateClient(t *testing.T) {
+	a, _, ctx, finish := ownedTestApp(t)
+	defer finish(nil)
+	a.opts.StoreDir = t.TempDir()
+	// Writable metadata commands must still use read-only local identity lookup.
+	a.opts.ReadOnly = false
+	d, err := a.OwnedDB(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := d.CheckContactResolver(ctx); err != nil {
+		t.Fatal(err)
+	}
+	jid := types.JID{User: "15550009999", Server: types.DefaultUserServer}
+	if got, err := d.ResolvePNToLIDWithError(ctx, jid); err != nil || got != jid {
+		t.Fatalf("fallback = %v %v", got, err)
+	}
+	if a.sessionResolver != nil {
+		t.Fatal("missing session constructed a resolver")
+	}
+	entries, err := os.ReadDir(a.opts.StoreDir)
+	if err != nil || len(entries) != 0 {
+		t.Fatalf("missing session changed store: %v %v", entries, err)
+	}
+}
+
+func TestOwnedContactResolverPreservesSessionOpenError(t *testing.T) {
+	a, _, ctx, finish := ownedTestApp(t)
+	defer finish(nil)
+	a.opts.StoreDir = t.TempDir()
+	if err := os.Mkdir(filepath.Join(a.opts.StoreDir, "session.db"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	d, err := a.OwnedDB(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := d.CheckContactResolver(ctx); err == nil {
+		t.Fatal("session-open error suppressed")
+	}
+}
+
+func TestOwnedContactCleanupUsesLiveParentWithoutCancellation(t *testing.T) {
+	a, _, ctx, finish := ownedTestApp(t)
+	defer finish(nil)
+	w, err := a.OwnedWA(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	canceled, cancel := context.WithCancel(ctx)
+	cancel()
+	if err := w.Disconnect(canceled); !errors.Is(err, ErrHandleRevoked) {
+		t.Fatal(err)
+	}
+	if err := w.Disconnect(context.WithoutCancel(canceled)); err != nil {
+		t.Fatal(err)
+	}
+	finish(nil)
+	if err := w.Disconnect(context.WithoutCancel(canceled)); !errors.Is(err, ErrHandleRevoked) {
+		t.Fatal("cleanup revived a finished parent", err)
+	}
+}
