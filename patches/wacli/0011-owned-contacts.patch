+)
+
+type ownedContactsProbe struct {
+	ownedContactReader
+	calls   atomic.Int32
+	entered chan struct{}
+	release chan struct{}
+	failure error
+	panics  bool
+}
+
+func (p *ownedContactsProbe) read() error {
+	p.calls.Add(1)
+	if p.entered != nil {
+		close(p.entered)
+		<-p.release
+	}
+	if p.panics {
+		panic(p.failure)
+	}
+	return p.failure
+}
+func (p *ownedContactsProbe) SearchContacts(string, int) ([]store.Contact, error) {
+	return nil, p.read()
+}
+func (p *ownedContactsProbe) ListContacts(int) ([]store.Contact, error)      { return nil, p.read() }
+func (p *ownedContactsProbe) ListContactAliases() (map[string]string, error) { return nil, p.read() }
+func (p *ownedContactsProbe) ListTags(string) ([]string, error)              { return nil, p.read() }
+func (p *ownedContactsProbe) UpsertContact(string, string, string, string, string, string) error {
+	return p.read()
+}
+func (p *ownedContactsProbe) SetAlias([]string, string) error     { return p.read() }
+func (p *ownedContactsProbe) RemoveAlias([]string) error          { return p.read() }
+func (p *ownedContactsProbe) AddTag([]string, string) error       { return p.read() }
+func (p *ownedContactsProbe) RemoveTag([]string, string) error    { return p.read() }
+func (p *ownedContactsProbe) SetSystemName(string, string) error  { return p.read() }
+func (p *ownedContactsProbe) CountSystemNames() (int64, error)    { return 0, p.read() }
+func (p *ownedContactsProbe) ClearAllSystemNames() (int64, error) { return 0, p.read() }
+
+type ownedContactInvocation struct {
+	name string
+	call func(*OwnedDB, context.Context) error
+}
+
+var ownedContactInvocations = []ownedContactInvocation{
+	{"search", func(d *OwnedDB, c context.Context) error { _, e := d.SearchContacts(c, "synthetic", 7); return e }},
+	{"list", func(d *OwnedDB, c context.Context) error { _, e := d.ListContacts(c, 7); return e }},
+	{"aliases", func(d *OwnedDB, c context.Context) error { _, e := d.ListContactAliases(c); return e }},
+	{"tags", func(d *OwnedDB, c context.Context) error { _, e := d.ListTags(c, "jid"); return e }},
+	{"upsert", func(d *OwnedDB, c context.Context) error {
+		return d.UpsertContact(c, "jid", "phone", "push", "full", "first", "business")
+	}},
+	{"set-alias", func(d *OwnedDB, c context.Context) error { return d.SetAlias(c, []string{"jid"}, "alias") }},
+	{"remove-alias", func(d *OwnedDB, c context.Context) error { return d.RemoveAlias(c, []string{"jid"}) }},
+	{"add-tag", func(d *OwnedDB, c context.Context) error { return d.AddTag(c, []string{"jid"}, "tag") }},
+	{"remove-tag", func(d *OwnedDB, c context.Context) error { return d.RemoveTag(c, []string{"jid"}, "tag") }},
+	{"set-system-name", func(d *OwnedDB, c context.Context) error { return d.SetSystemName(c, "jid", "name") }},
+	{"count-system-names", func(d *OwnedDB, c context.Context) error { _, e := d.CountSystemNames(c); return e }},
+	{"clear-system-names", func(d *OwnedDB, c context.Context) error { _, e := d.ClearAllSystemNames(c); return e }},
+}
+
+func TestOwnedContactsRefusalHasZeroStoreEffects(t *testing.T) {
+	for _, mode := range []string{"missing", "foreign", "canceled", "finished", "sealed-finished"} {
+		t.Run(mode, func(t *testing.T) {
+			a, _, ctx, finish := ownedTestApp(t)
+			defer finish(nil)
+			d, err := a.OwnedDB(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			probe := &ownedContactsProbe{ownedContactReader: d.contacts}
+			d.contacts = probe
+			use := ctx
+			switch mode {
+			case "missing":
+				use = context.Background()
+			case "foreign":
+				other := &App{}
+				var end func(error)
+				use, end, err = other.BeginScopedOperation(context.Background())
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer end(nil)
+			case "canceled":
+				var cancel context.CancelFunc
+				use, cancel = context.WithCancel(ctx)
+				cancel()
+			case "finished":
+				finish(nil)
+			case "sealed-finished":
+				canceled, cancel := context.WithCancel(context.Background())
+				cancel()
+				if held, e := a.BeginDrain(canceled); held != nil || !errors.Is(e, ErrDrainCoverageIncomplete) {
+					t.Fatalf("seal = %v %v", held, e)
+				}
+				finish(nil)
+			}
+			for _, op := range ownedContactInvocations {
+				if e := op.call(d, use); !errors.Is(e, ErrHandleRevoked) {
+					t.Errorf("%s = %v", op.name, e)
+				}
+			}
+			if got := probe.calls.Load(); got != 0 {
+				t.Fatalf("refused operations performed %d store effects", got)
+			}
+		})
+	}
+}
