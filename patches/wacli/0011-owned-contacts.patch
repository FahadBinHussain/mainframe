--- a/internal/app/app.go
+++ b/internal/app/app.go
@@ -6,0 +7 @@ import (
+	"os"
@@ -428,0 +430,12 @@ func (a *App) Connect(ctx context.Context, allowQR bool, qrWriter func(string))
+
+// contactResolver deliberately uses the read-only session view even for writable
+// metadata commands. A missing session is an identity fallback, not client creation.
+func (a *App) contactResolver() (LocalResolver, error) {
+	if _, err := os.Stat(filepath.Join(a.opts.StoreDir, "session.db")); err != nil {
+		if os.IsNotExist(err) {
+			return nil, nil
+		}
+		return nil, err
+	}
+	return a.ReadOnlyResolver()
+}
