+func TestOwnedContactsWARefusalAndAcceptedLifecycle(t *testing.T) {
+	for _, mode := range []string{"missing", "foreign", "canceled", "finished", "sealed-finished"} {
+		t.Run(mode, func(t *testing.T) {
+			a, _, ctx, finish := ownedTestApp(t)
+			defer finish(nil)
+			probe := &ownedContactsWAProbe{}
+			a.wa = probe
+			wa, err := a.OwnedWA(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			use := ctx
+			switch mode {
+			case "missing":
+				use = context.Background()
+			case "foreign":
+				other := &App{}
+				var end func(error)
+				use, end, err = other.BeginScopedOperation(context.Background())
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer end(nil)
+			case "canceled":
+				var cancel context.CancelFunc
+				use, cancel = context.WithCancel(ctx)
+				cancel()
+			case "finished":
+				finish(nil)
+			case "sealed-finished":
+				canceled, cancel := context.WithCancel(context.Background())
+				cancel()
+				if held, e := a.BeginDrain(canceled); held != nil || !errors.Is(e, ErrDrainCoverageIncomplete) {
+					t.Fatalf("seal = %v %v", held, e)
+				}
+				finish(nil)
+			}
+			if _, e := wa.GetAllContacts(use); !errors.Is(e, ErrHandleRevoked) {
+				t.Errorf("contacts = %v", e)
+			}
+			if _, e := wa.IsOnWhatsApp(use, []string{"1"}); !errors.Is(e, ErrHandleRevoked) {
+				t.Errorf("on whatsapp = %v", e)
+			}
+			if e := wa.Disconnect(use); !errors.Is(e, ErrHandleRevoked) {
+				t.Errorf("disconnect = %v", e)
+			}
+			if probe.calls.Load() != 0 {
+				t.Fatalf("refused WA effects = %d", probe.calls.Load())
+			}
+		})
+	}
+	for _, name := range []string{"contacts", "whatsapp", "disconnect"} {
+		t.Run("accepted-"+name, func(t *testing.T) {
+			a, _, ctx, finish := ownedTestApp(t)
+			defer finish(nil)
+			var failure error = errors.New("synthetic WA failure")
+			if name == "disconnect" {
+				failure = nil
+			}
+			probe := &ownedContactsWAProbe{entered: make(chan struct{}), release: make(chan struct{}), failure: failure}
+			a.wa = probe
+			wa, err := a.OwnedWA(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			sealed, cancel := context.WithCancel(context.Background())
+			cancel()
+			if held, e := a.BeginDrain(sealed); held != nil || !errors.Is(e, ErrDrainCoverageIncomplete) {
+				t.Fatalf("seal = %v %v", held, e)
+			}
+			result := make(chan error, 1)
+			go func() {
+				var e error
+				switch name {
+				case "contacts":
+					_, e = wa.GetAllContacts(ctx)
+				case "whatsapp":
+					_, e = wa.IsOnWhatsApp(ctx, []string{"1"})
+				default:
+					e = wa.Disconnect(ctx)
+				}
+				result <- e
+			}()
+			select {
+			case <-probe.entered:
+			case <-time.After(time.Second):
+				t.Fatal("WA effect not entered")
+			}
+			finish(nil)
+			drain := make(chan error, 1)
+			go func() { _, e := a.BeginDrain(context.Background()); drain <- e }()
+			select {
+			case e := <-drain:
+				t.Fatalf("drain escaped effect: %v", e)
+			case <-time.After(20 * time.Millisecond):
+			}
+			close(probe.release)
+			if e := <-result; !errors.Is(e, failure) {
+				t.Fatalf("effect = %v", e)
+			}
+			if e := <-drain; (failure != nil && !errors.Is(e, failure)) || !errors.Is(e, ErrDrainCoverageIncomplete) {
+				t.Fatalf("drain = %v", e)
+			}
+			if probe.calls.Load() != 1 {
+				t.Fatalf("WA effects = %d", probe.calls.Load())
+			}
+		})
+	}
+}
