+func TestOwnedContactsAcceptedAfterSealAndActualInvocationJoin(t *testing.T) {
+	for _, op := range ownedContactInvocations {
+		t.Run(op.name, func(t *testing.T) {
+			a, _, ctx, finish := ownedTestApp(t)
+			defer finish(nil)
+			d, err := a.OwnedDB(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			failure := errors.New("synthetic contact failure")
+			probe := &ownedContactsProbe{ownedContactReader: d.contacts, entered: make(chan struct{}), release: make(chan struct{}), failure: failure}
+			d.contacts = probe
+			var once sync.Once
+			defer once.Do(func() { close(probe.release) })
+			sealed, cancel := context.WithCancel(context.Background())
+			cancel()
+			if held, e := a.BeginDrain(sealed); held != nil || !errors.Is(e, ErrDrainCoverageIncomplete) {
+				t.Fatalf("seal = %v %v", held, e)
+			}
+			result := make(chan error, 1)
+			go func() { result <- op.call(d, ctx) }()
+			select {
+			case <-probe.entered:
+			case <-time.After(time.Second):
+				t.Fatal("live parent failed to admit child after seal")
+			}
+			finish(nil)
+			drain := make(chan error, 1)
+			go func() { _, e := a.BeginDrain(context.Background()); drain <- e }()
+			select {
+			case e := <-drain:
+				t.Fatalf("drain escaped invocation: %v", e)
+			case <-time.After(20 * time.Millisecond):
+			}
+			once.Do(func() { close(probe.release) })
+			if e := <-result; !errors.Is(e, failure) {
+				t.Fatalf("actual error = %v", e)
+			}
+			select {
+			case e := <-drain:
+				if !errors.Is(e, failure) || !errors.Is(e, ErrDrainCoverageIncomplete) {
+					t.Fatalf("drain = %v", e)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("drain did not join")
+			}
+			if got := probe.calls.Load(); got != 1 {
+				t.Fatalf("store effect count = %d", got)
+			}
+		})
+	}
+}
