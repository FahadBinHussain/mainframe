@@ -0,0 +1,199 @@
+package app
+
+import (
+	"context"
+
+	"github.com/openclaw/wacli/internal/store"
+	"go.mau.fi/whatsmeow/types"
+)
+
+type ownedContactReader interface {
+	SearchContacts(string, int) ([]store.Contact, error)
+	ListContacts(int) ([]store.Contact, error)
+	ListContactAliases() (map[string]string, error)
+	ListTags(string) ([]string, error)
+	UpsertContact(string, string, string, string, string, string) error
+	SetAlias([]string, string) error
+	RemoveAlias([]string) error
+	AddTag([]string, string) error
+	RemoveTag([]string, string) error
+	SetSystemName(string, string) error
+	CountSystemNames() (int64, error)
+	ClearAllSystemNames() (int64, error)
+}
+
+// Contact methods are deliberately narrow; the underlying DB and resolver never escape.
+func (d *OwnedDB) contactEffect(ctx context.Context) (context.Context, func(error), error) {
+	return d.effect(ctx)
+}
+func (d *OwnedDB) SearchContacts(ctx context.Context, q string, limit int) (v []store.Contact, err error) {
+	_, finish, err := d.contactEffect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return d.contacts.SearchContacts(q, limit)
+}
+func (d *OwnedDB) ListContacts(ctx context.Context, limit int) (v []store.Contact, err error) {
+	_, finish, err := d.contactEffect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return d.contacts.ListContacts(limit)
+}
+func (d *OwnedDB) ListContactAliases(ctx context.Context) (v map[string]string, err error) {
+	_, finish, err := d.contactEffect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return d.contacts.ListContactAliases()
+}
+func (d *OwnedDB) ListTags(ctx context.Context, jid string) (v []string, err error) {
+	_, finish, err := d.contactEffect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return d.contacts.ListTags(jid)
+}
+func (d *OwnedDB) UpsertContact(ctx context.Context, jid, phone, pushName, fullName, firstName, businessName string) (err error) {
+	_, finish, err := d.contactEffect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return d.contacts.UpsertContact(jid, phone, pushName, fullName, firstName, businessName)
+}
+func (d *OwnedDB) SetAlias(ctx context.Context, jids []string, alias string) (err error) {
+	_, f, err := d.contactEffect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(f, &err)
+	return d.contacts.SetAlias(jids, alias)
+}
+func (d *OwnedDB) RemoveAlias(ctx context.Context, jids []string) (err error) {
+	_, f, err := d.contactEffect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(f, &err)
+	return d.contacts.RemoveAlias(jids)
+}
+func (d *OwnedDB) AddTag(ctx context.Context, jids []string, tag string) (err error) {
+	_, f, err := d.contactEffect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(f, &err)
+	return d.contacts.AddTag(jids, tag)
+}
+func (d *OwnedDB) RemoveTag(ctx context.Context, jids []string, tag string) (err error) {
+	_, f, err := d.contactEffect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(f, &err)
+	return d.contacts.RemoveTag(jids, tag)
+}
+func (d *OwnedDB) SetSystemName(ctx context.Context, jid, name string) (err error) {
+	_, f, err := d.contactEffect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(f, &err)
+	return d.contacts.SetSystemName(jid, name)
+}
+func (d *OwnedDB) CountSystemNames(ctx context.Context) (n int64, err error) {
+	_, f, err := d.contactEffect(ctx)
+	if err != nil {
+		return 0, err
+	}
+	defer finishOwnedEffect(f, &err)
+	return d.contacts.CountSystemNames()
+}
+func (d *OwnedDB) ClearAllSystemNames(ctx context.Context) (n int64, err error) {
+	_, f, err := d.contactEffect(ctx)
+	if err != nil {
+		return 0, err
+	}
+	defer finishOwnedEffect(f, &err)
+	return d.contacts.ClearAllSystemNames()
+}
+
+func (w *OwnedWA) GetAllContacts(ctx context.Context) (v map[types.JID]types.ContactInfo, err error) {
+	ctx, f, err := w.effect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer finishOwnedEffect(f, &err)
+	return w.client.GetAllContacts(ctx)
+}
+func (w *OwnedWA) IsOnWhatsApp(ctx context.Context, phones []string) (v []types.IsOnWhatsAppResponse, err error) {
+	ctx, f, err := w.effect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer finishOwnedEffect(f, &err)
+	return w.client.IsOnWhatsApp(ctx, phones)
+}
+
+// Disconnect retains an invocation lease just like every other client effect.
+// Lifecycle callers may use WithoutCancel while their parent scope is still live.
+func (w *OwnedWA) Disconnect(ctx context.Context) (err error) {
+	_, finish, err := w.effect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(finish, &err)
+	w.client.Disconnect()
+	return nil
+}
+
+// CheckContactResolver preserves the original eager read-only resolver errors,
+// including for empty contact sets and inputs requiring no identity lookup.
+func (d *OwnedDB) CheckContactResolver(ctx context.Context) (err error) {
+	_, finish, err := d.effect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(finish, &err)
+	_, err = d.app.contactResolver()
+	return err
+}
+
+// ResolveLIDToPNWithError resolves identity under a leased, read-only-safe facade.
+func (d *OwnedDB) ResolveLIDToPNWithError(ctx context.Context, jid types.JID) (out types.JID, err error) {
+	child, finish, err := d.effect(ctx)
+	if err != nil {
+		return jid, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	resolver, err := d.app.contactResolver()
+	if err != nil {
+		return jid, err
+	}
+	if resolver == nil {
+		return jid, nil
+	}
+	return resolver.ResolveLIDToPN(child, jid), nil
+}
+
+// ResolvePNToLIDWithError resolves identity under a leased, read-only-safe facade.
+func (d *OwnedDB) ResolvePNToLIDWithError(ctx context.Context, jid types.JID) (out types.JID, err error) {
+	child, finish, err := d.effect(ctx)
+	if err != nil {
+		return jid, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	resolver, err := d.app.contactResolver()
+	if err != nil {
+		return jid, err
+	}
+	if resolver == nil {
+		return jid, nil
+	}
+	return resolver.ResolvePNToLID(child, jid), nil
+}
