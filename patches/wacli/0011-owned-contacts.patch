+type ownedContactsWAProbe struct {
+	WAClient
+	calls   atomic.Int32
+	entered chan struct{}
+	release chan struct{}
+	failure error
+	panics  bool
+}
+
+func (w *ownedContactsWAProbe) read() error {
+	w.calls.Add(1)
+	if w.entered != nil {
+		close(w.entered)
+		<-w.release
+	}
+	if w.panics {
+		panic(w.failure)
+	}
+	return w.failure
+}
+func (w *ownedContactsWAProbe) GetAllContacts(context.Context) (map[types.JID]types.ContactInfo, error) {
+	return nil, w.read()
+}
+func (w *ownedContactsWAProbe) IsOnWhatsApp(context.Context, []string) ([]types.IsOnWhatsAppResponse, error) {
+	return nil, w.read()
+}
+func (w *ownedContactsWAProbe) Disconnect() { _ = w.read() }
+func (*ownedContactsWAProbe) Close()        {}
