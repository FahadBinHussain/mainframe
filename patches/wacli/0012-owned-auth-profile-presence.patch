+func TestOwnedPresenceWatchHoldsLeaseThroughSubscribeFailure(t *testing.T) {
+	a, _, ctx, finish := ownedTestApp(t)
+	failure := errors.New("synthetic subscribe failure")
+	fake := newCountedProfilePresenceWA()
+	fake.failure = failure
+	fake.entered = make(chan struct{})
+	fake.release = make(chan struct{})
+	a.wa = fake
+	jid, _, _, _ := profilePresenceArgs()
+	result := make(chan error, 1)
+	go func() { _, e := a.WatchPresenceOwned(ctx, jid, 0); result <- e }()
+	select {
+	case <-fake.entered:
+	case <-time.After(time.Second):
+		t.Fatal("subscribe did not enter")
+	}
+	finish(nil)
+	drain := make(chan error, 1)
+	go func() { _, e := a.BeginDrain(context.Background()); drain <- e }()
+	select {
+	case e := <-drain:
+		t.Fatalf("drain escaped watch: %v", e)
+	case <-time.After(30 * time.Millisecond):
+	}
+	close(fake.release)
+	if e := <-result; !errors.Is(e, failure) {
+		t.Fatalf("watch error = %v", e)
+	}
+	select {
+	case e := <-drain:
+		if !errors.Is(e, failure) {
+			t.Fatalf("drain lost watch failure: %v", e)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("drain did not join watch")
+	}
+}
