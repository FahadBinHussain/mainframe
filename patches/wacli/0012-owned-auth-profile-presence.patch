+package app
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+type countedProfilePresenceWA struct {
+	*fakeWA
+	calls          atomic.Int32
+	resolverCalls  atomic.Int32
+	entered        chan struct{}
+	release        chan struct{}
+	failure        error
+	panicOnProfile bool
+}
+
+func newCountedProfilePresenceWA() *countedProfilePresenceWA {
+	return &countedProfilePresenceWA{fakeWA: newFakeWA()}
+}
+func (w *countedProfilePresenceWA) hit() { w.calls.Add(1) }
+func (w *countedProfilePresenceWA) SetProfilePicture(context.Context, []byte) (string, error) {
+	w.hit()
+	w.blockOrPanic()
+	return "synthetic-picture", w.failure
+}
+func (w *countedProfilePresenceWA) GetProfilePictureInfo(context.Context, types.JID, bool, string) (*types.ProfilePictureInfo, error) {
+	w.hit()
+	return nil, w.failure
+}
+func (w *countedProfilePresenceWA) SetStatusMessage(context.Context, string) error {
+	w.hit()
+	return w.failure
+}
+func (w *countedProfilePresenceWA) SetProfileName(context.Context, string) error {
+	w.hit()
+	return w.failure
+}
+func (w *countedProfilePresenceWA) GetUserInfo(context.Context, []types.JID) (map[types.JID]types.UserInfo, error) {
+	w.hit()
+	return nil, w.failure
+}
+func (w *countedProfilePresenceWA) GetBusinessProfile(context.Context, types.JID) (*types.BusinessProfile, error) {
+	w.hit()
+	return nil, w.failure
+}
+func (w *countedProfilePresenceWA) SendPresence(context.Context, types.Presence) error {
+	w.hit()
+	w.blockOrPanic()
+	return w.failure
+}
+func (w *countedProfilePresenceWA) SendChatPresence(context.Context, types.JID, types.ChatPresence, types.ChatPresenceMedia) error {
+	w.hit()
+	return w.failure
+}
+func (w *countedProfilePresenceWA) SubscribePresence(ctx context.Context, jid types.JID) error {
+	w.hit()
+	if w.entered != nil {
+		select {
+		case <-w.entered:
+		default:
+			close(w.entered)
+		}
+		select {
+		case <-w.release:
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+	return w.failure
+}
+func (w *countedProfilePresenceWA) ResolvePNToLID(ctx context.Context, jid types.JID) types.JID {
+	w.resolverCalls.Add(1)
+	return w.fakeWA.ResolvePNToLID(ctx, jid)
+}
+func (w *countedProfilePresenceWA) ResolveLIDToPN(ctx context.Context, jid types.JID) types.JID {
+	w.resolverCalls.Add(1)
+	return w.fakeWA.ResolveLIDToPN(ctx, jid)
+}
+func (w *countedProfilePresenceWA) blockOrPanic() {
+	if w.entered != nil {
+		select {
+		case <-w.entered:
+		default:
+			close(w.entered)
+		}
+		<-w.release
+	}
+	if w.panicOnProfile {
+		panic(w.failure)
+	}
+}
+
+func profilePresenceArgs() (types.JID, types.Presence, types.ChatPresence, types.ChatPresenceMedia) {
+	return types.NewJID("15550000001", types.DefaultUserServer), types.PresenceAvailable, types.ChatPresenceComposing, types.ChatPresenceMediaText
+}
+
+func callAllProfilePresenceMethods(t *testing.T, w *OwnedWA, ctx context.Context) {
+	t.Helper()
+	jid, presence, chat, media := profilePresenceArgs()
+	if _, err := w.SetProfilePicture(ctx, []byte("synthetic")); err == nil {
+		t.Error("SetProfilePicture unexpectedly succeeded")
+	}
+	if _, err := w.GetProfilePictureInfo(ctx, jid, false, ""); err == nil {
+		t.Error("GetProfilePictureInfo unexpectedly succeeded")
+	}
+	if err := w.SetStatusMessage(ctx, "synthetic"); err == nil {
+		t.Error("SetStatusMessage unexpectedly succeeded")
+	}
+	if err := w.SetProfileName(ctx, "synthetic"); err == nil {
+		t.Error("SetProfileName unexpectedly succeeded")
+	}
+	if _, err := w.GetUserInfo(ctx, []types.JID{jid}); err == nil {
+		t.Error("GetUserInfo unexpectedly succeeded")
+	}
+	if _, err := w.GetBusinessProfile(ctx, jid); err == nil {
+		t.Error("GetBusinessProfile unexpectedly succeeded")
+	}
+	if err := w.SendPresence(ctx, presence); err == nil {
+		t.Error("SendPresence unexpectedly succeeded")
+	}
+	if err := w.SendChatPresence(ctx, jid, chat, media); err == nil {
+		t.Error("SendChatPresence unexpectedly succeeded")
+	}
+	if err := w.SubscribePresence(ctx, jid); err == nil {
+		t.Error("SubscribePresence unexpectedly succeeded")
