+	go func() { result <- auth.Connect(parent) }()
+	select {
+	case <-client.connectEntered:
+	case <-time.After(time.Second):
+		t.Fatal("Connect did not reach SDK")
+	}
+	finish(nil)
+	drain := make(chan error, 1)
+	go func() { _, e := a.BeginDrain(context.Background()); drain <- e }()
+	select {
+	case e := <-drain:
+		t.Fatalf("drain escaped blocked Connect: %v", e)
+	case <-time.After(25 * time.Millisecond):
+	}
+	close(client.connectRelease)
+	if e := <-result; !errors.Is(e, failure) {
+		t.Fatalf("Connect error = %v, want failure", e)
+	}
+	select {
+	case e := <-drain:
+		if !errors.Is(e, failure) || !errors.Is(e, ErrDrainCoverageIncomplete) {
+			t.Fatalf("drain error = %v, want failure and coverage", e)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("drain did not join Connect")
+	}
+}
