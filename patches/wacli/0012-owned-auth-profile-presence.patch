+func TestOwnedProfilePresenceRoutesUseOwnedFacade(t *testing.T) {
+	for _, name := range []string{"profile.go", "presence.go"} {
+		fset := token.NewFileSet()
+		file, err := parser.ParseFile(fset, name, nil, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ast.Inspect(file, func(n ast.Node) bool {
+			if sel, ok := n.(*ast.SelectorExpr); ok {
+				switch sel.Sel.Name {
+				case "WA", "DB", "OpenWA", "EnsureAuthed", "LocalResolver", "ReadOnlyResolver":
+					t.Errorf("%s: migrated route borrows raw accessor/method value %s", fset.Position(sel.Pos()), sel.Sel.Name)
+				}
+			}
+			if call, ok := n.(*ast.CallExpr); ok {
+				if sel, ok := call.Fun.(*ast.SelectorExpr); ok && sel.Sel.Name == "Connect" && len(call.Args) == 3 {
+					t.Errorf("%s calls raw App.Connect", fset.Position(call.Pos()))
+				}
+			}
+			return true
+		})
+	}
+}
diff --git a/cmd/wacli/owned_session_cleanup.go b/cmd/wacli/owned_session_cleanup.go
new file mode 100644
index 0000000..3f442c1
--- /dev/null
+++ b/cmd/wacli/owned_session_cleanup.go
@@ -0,0 +1,29 @@
+package main
+
+import (
+	"errors"
+
+	"github.com/openclaw/wacli/internal/app"
+	"github.com/openclaw/wacli/internal/lock"
+)
+
+// closeOwnedSession is for routes that own an App and optional lock. Unlike
+// closeApp, it retains durable drain/close failures for the command result.
+func closeOwnedSession(a *app.App, lk *lock.Lock) error {
+	var err error
+	if a != nil {
+		err = errors.Join(err, a.CloseWithError())
+	}
+	if lk != nil {
+		err = errors.Join(err, lk.Release())
+	}
+	return err
+}
+
+// Finish the command token before CloseWithError joins the owner. Already
+// accepted children keep their independent leases and are still joined by close.
+// Calling close first would wait forever for this very command token.
+func finishOwnedSession(a *app.App, lk *lock.Lock, finish func(error), resultErr error) error {
+	finish(resultErr)
+	return errors.Join(resultErr, closeOwnedSession(a, lk))
+}
