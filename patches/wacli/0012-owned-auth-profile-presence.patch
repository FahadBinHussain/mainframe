+		authed, jid, e := auth.Status(parent)
+		result <- struct {
+			authed bool
+			jid    string
+			err    error
+		}{authed, jid, e}
+	}()
+	select {
+	case <-client.statusEntered:
+	case <-time.After(time.Second):
+		t.Fatal("Status did not reach SDK IsAuthed")
+	}
+	finish(nil)
+	drain := make(chan error, 1)
+	go func() { _, e := a.BeginDrain(context.Background()); drain <- e }()
+	select {
+	case e := <-drain:
+		t.Fatalf("drain escaped blocked Status: %v", e)
+	case <-time.After(25 * time.Millisecond):
+	}
+	close(client.statusRelease)
+	got := <-result
+	if got.err != nil || !got.authed || got.jid == "" {
+		t.Fatalf("Status = %#v, want authenticated identity", got)
+	}
+	select {
+	case e := <-drain:
+		if !errors.Is(e, ErrDrainCoverageIncomplete) {
