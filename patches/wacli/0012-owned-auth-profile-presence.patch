+package main
+
+import (
+	"context"
+	"errors"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"testing"
+	"time"
+
+	"github.com/openclaw/wacli/internal/app"
+)
+
+func TestOwnedSessionFinishPrecedesCloseAndRetainsFailure(t *testing.T) {
+	a := &app.App{}
+	_, finish, err := a.BeginScopedOperation(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	cause := errors.New("synthetic command failure")
+	done := make(chan error, 1)
+	go func() { done <- finishOwnedSession(a, nil, finish, cause) }()
+	select {
+	case err := <-done:
+		if !errors.Is(err, cause) {
+			t.Fatalf("cleanup lost cause: %v", err)
+		}
+	case <-time.After(time.Second):
+		finish(cause) // unblock an erroneous close-first implementation
+		t.Fatal("close waited on its own unfinished command token")
+	}
+	if err := a.CloseWithError(); !errors.Is(err, cause) {
+		t.Fatalf("idempotent close lost command failure: %v", err)
+	}
+}
+
+func TestOwnedAuthRoutesDoNotBorrowRawHandles(t *testing.T) {
+	fset := token.NewFileSet()
+	file, err := parser.ParseFile(fset, "auth.go", nil, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	begins, finishes := 0, 0
+	ast.Inspect(file, func(n ast.Node) bool {
+		sel, ok := n.(*ast.SelectorExpr)
+		if ok {
+			switch sel.Sel.Name {
+			case "WA", "DB", "OpenWA", "EnsureAuthed":
+				t.Errorf("%s: auth route borrows %s", fset.Position(sel.Pos()), sel.Sel.Name)
+			case "BeginScopedOperation":
+				begins++
+			}
+		}
+		call, ok := n.(*ast.CallExpr)
+		if ok {
+			if id, ok := call.Fun.(*ast.Ident); ok && id.Name == "finishOwnedSession" {
+				finishes++
+			}
+		}
+		return true
+	})
+	if begins != 3 || finishes != 3 {
+		t.Fatalf("auth scope/cleanup routes = %d/%d, want 3/3", begins, finishes)
+	}
+}
