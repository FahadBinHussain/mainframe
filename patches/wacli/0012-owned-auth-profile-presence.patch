+				use = context.Background()
+			case "foreign":
+				other := &App{}
+				use, otherFinish, err = other.BeginScopedOperation(context.Background())
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer otherFinish(nil)
+			case "finished":
+				finish(nil)
+			case "canceled":
+				var cancel context.CancelFunc
+				use, cancel = context.WithCancel(root)
+				cancel()
+			}
+			jid, presence, chat, media := profilePresenceArgs()
+			_, _ = w.SetProfilePicture(use, nil)
+			_, _ = w.GetProfilePictureInfo(use, jid, false, "")
+			_ = w.SetStatusMessage(use, "")
+			_ = w.SetProfileName(use, "")
+			_, _ = w.GetUserInfo(use, nil)
+			_, _ = w.GetBusinessProfile(use, jid)
+			_ = w.SendPresence(use, presence)
+			_ = w.SendChatPresence(use, jid, chat, media)
+			_ = w.SubscribePresence(use, jid)
+			if fake.calls.Load() != 0 {
+				t.Fatalf("client calls = %d, want zero", fake.calls.Load())
+			}
+		})
+	}
+}
