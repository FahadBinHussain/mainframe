@@ -0,0 +1,142 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/openclaw/wacli/internal/app"
+)
+
+func TestOwnedDelegatedPresenceRoutesDoNotBorrowRawHandles(t *testing.T) {
+	fset := token.NewFileSet()
+	file, err := parser.ParseFile(fset, "send_ipc.go", nil, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	seen := 0
+	for _, decl := range file.Decls {
+		fn, ok := decl.(*ast.FuncDecl)
+		if !ok || (fn.Name.Name != "executeDelegatedPresence" && fn.Name.Name != "executeDelegatedPresenceSubscribe") {
+			continue
+		}
+		seen++
+		ast.Inspect(fn.Body, func(n ast.Node) bool {
+			sel, ok := n.(*ast.SelectorExpr)
+			if !ok {
+				return true
+			}
+			switch sel.Sel.Name {
+			case "WA", "DB", "WatchPresence", "LocalResolver":
+				t.Errorf("%s: delegated presence borrows %s", fset.Position(sel.Pos()), sel.Sel.Name)
+			}
+			return true
+		})
+	}
+	if seen != 2 {
+		t.Fatalf("guarded %d routes, want two", seen)
+	}
+}
+
+func TestOwnedDelegatedPresenceRefusedBeforeClientEffects(t *testing.T) {
+	for _, mode := range []string{"finished", "canceled", "sealed"} {
+		t.Run(mode, func(t *testing.T) {
+			a := &app.App{} // any attempted underlying client effect would panic
+			ctx, finish, err := a.BeginScopedOperation(context.Background())
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer finish(nil)
+			switch mode {
+			case "finished":
+				finish(nil)
+			case "canceled":
+				var cancel context.CancelFunc
+				ctx, cancel = context.WithCancel(ctx)
+				cancel()
+			case "sealed":
+				finish(nil)
+				_, _ = a.BeginDrain(context.Background())
+				ctx = context.Background()
+			}
+			_, err = executeDelegatedPresence(ctx, a, sendDelegateRequest{To: "15550000001@s.whatsapp.net", PresenceState: "composing"})
+			if err == nil {
+				t.Fatal("refused presence was accepted")
+			}
+			_, err = executeDelegatedPresenceSubscribe(ctx, a, sendDelegateRequest{To: "15550000001@s.whatsapp.net"})
+			if !errors.Is(err, app.ErrHandleRevoked) {
+				t.Fatalf("subscribe refusal = %v", err)
+			}
+		})
+	}
+}
+
+func TestOwnedPresenceCanceledAttemptRemainsJoined(t *testing.T) {
+	a := &app.App{}
+	parent, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	ctx, finish, err := a.BeginScopedOperation(parent)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer finish(nil)
+	entered, release, returned := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	defer once.Do(func() { close(release) })
+	var effects atomic.Int32
+	result := make(chan error, 1)
+	go func() {
+		result <- sendOwnedPresenceWithRetry(ctx, a, func(context.Context) error { t.Error("canceled presence reconnected"); return nil }, func(context.Context) error {
+			effects.Add(1)
+			close(entered)
+			<-release
+			close(returned)
+			return errors.New("synthetic delayed presence failure")
+		})
+	}()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("attempt not started")
+	}
+	cancel()
+	select {
+	case err := <-result:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("caller result = %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("caller failed to cancel")
+	}
+	finish(nil)
+	drained := make(chan error, 1)
+	go func() { _, err := a.BeginDrain(context.Background()); drained <- err }()
+	select {
+	case err := <-drained:
+		t.Fatalf("drain escaped accepted attempt: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	once.Do(func() { close(release) })
+	select {
+	case <-returned:
+	case <-time.After(time.Second):
+		t.Fatal("effect did not finish")
+	}
+	select {
+	case err := <-drained:
+		if !errors.Is(err, app.ErrDrainCoverageIncomplete) || !errors.Is(err, context.Canceled) {
+			t.Fatalf("drain lost refusal/cancellation: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("drain did not join")
+	}
+	if effects.Load() != 1 {
+		t.Fatalf("effects = %d", effects.Load())
+	}
+}
