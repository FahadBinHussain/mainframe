diff --git a/internal/app/owned_auth.go b/internal/app/owned_auth.go
new file mode 100644
index 0000000..fcb4280
--- /dev/null
+++ b/internal/app/owned_auth.go
@@ -0,0 +1,107 @@
+package app
+
+import (
+	"context"
+	"errors"
+)
+
+// OwnedAuth is the application-owned authentication facade. Its methods admit
+// one operation and retain that lease until the underlying operation returns.
+// Callers never borrow the SDK client or the application database.
+type OwnedAuth struct{ app *App }
+
+// OwnedAuth returns an authentication facade only for a live application-owned
+// operation scope.
+func (a *App) OwnedAuth(ctx context.Context) (*OwnedAuth, error) {
+	if err := a.admitHandle(ctx); err != nil {
+		return nil, err
+	}
+	return &OwnedAuth{app: a}, nil
+}
+
+func (h *OwnedAuth) effect(ctx context.Context) (context.Context, func(error), error) {
+	if err := h.app.admitHandle(ctx); err != nil {
+		return nil, nil, err
+	}
+	child, finish, err := RegisterOperationChild(ctx)
+	if err != nil {
+		return nil, nil, errors.Join(ErrHandleRevoked, err)
+	}
+	return child, finish, nil
+}
+
+// Sync runs the complete authentication/bootstrap lifecycle under one owned
+// lease. Cancellation is passed to Sync, but the lease is not released until
+// Sync itself has returned.
+func (h *OwnedAuth) Sync(ctx context.Context, opts SyncOptions) (result SyncResult, err error) {
+	child, finish, err := h.effect(ctx)
+	if err != nil {
+		return SyncResult{}, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return h.app.Sync(child, opts)
+}
+
+// Connect ensures authentication and connects the session under one accepted
+// child lease. Callers must use this rather than borrowing the SDK client.
+func (h *OwnedAuth) Connect(ctx context.Context) (err error) {
+	child, finish, err := h.effect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(finish, &err)
+	if err = h.app.EnsureAuthed(child); err != nil {
+		return err
+	}
+	return h.app.Connect(child, false, nil)
+}
+
+// Status opens the session through the application and reports its durable
+// authentication identity. Refused calls do not open the session.
+func (h *OwnedAuth) Status(ctx context.Context) (authed bool, linkedJID string, err error) {
+	child, finish, err := h.effect(ctx)
+	if err != nil {
+		return false, "", err
+	}
+	defer finishOwnedEffect(finish, &err)
+	_ = child // application-local status reads have no context-bearing SDK call
+	if err = h.app.OpenWA(); err != nil {
+		return false, "", err
+	}
+	h.app.waMu.Lock()
+	client := h.app.wa
+	h.app.waMu.Unlock()
+	if client == nil {
+		return false, "", ErrHandleRevoked
+	}
+	authed = client.IsAuthed()
+	if revoked, e := SessionRevoked(h.app.StoreDir()); e != nil {
+		return false, "", e
+	} else if revoked {
+		authed = false
+	}
+	if authed {
+		linkedJID = client.LinkedJID()
+	}
+	return authed, linkedJID, nil
+}
+
+// Logout ensures an authenticated session, connects it if necessary, then
+// invalidates it. All SDK interaction remains inside the accepted lease.
+func (h *OwnedAuth) Logout(ctx context.Context) (err error) {
+	child, finish, err := h.effect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(finish, &err)
+	if err = h.app.EnsureAuthed(child); err != nil {
+		return err
+	}
+	if err = h.app.Connect(child, false, nil); err != nil {
+		return err
+	}
+	h.app.waMu.Lock()
+	client := h.app.wa
+	h.app.waMu.Unlock()
+	return client.Logout(child)
+}
diff --git a/internal/app/owned_auth_test.go b/internal/app/owned_auth_test.go
new file mode 100644
index 0000000..e440d56
--- /dev/null
+++ b/internal/app/owned_auth_test.go
@@ -0,0 +1,365 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/openclaw/wacli/internal/wa"
+)
+
+// countedAuthWA embeds the complete fake client so any unexpected SDK method
+// still panics through the nil embedded client, while the methods exercised by
+// OwnedAuth are counted and (when requested) held at the SDK boundary.
+type countedAuthWA struct {
+	*fakeWA
+	isAuthedCalls  atomic.Int32
+	connectCalls   atomic.Int32
+	logoutCalls    atomic.Int32
+	statusEntered  chan struct{}
+	statusRelease  chan struct{}
+	connectEntered chan struct{}
+	connectRelease chan struct{}
+	connectErr     error
+	logoutEntered  chan struct{}
+	logoutRelease  chan struct{}
+	logoutErr      error
+}
+
+func (w *countedAuthWA) IsAuthed() bool {
+	w.isAuthedCalls.Add(1)
+	if w.statusEntered != nil {
+		select {
+		case <-w.statusEntered:
+		default:
+			close(w.statusEntered)
+		}
+		<-w.statusRelease
+	}
+	return w.fakeWA.IsAuthed()
+}
+
+func (w *countedAuthWA) Connect(ctx context.Context, opts wa.ConnectOptions) error {
+	w.connectCalls.Add(1)
+	if w.connectEntered != nil {
+		select {
+		case <-w.connectEntered:
+		default:
+			close(w.connectEntered)
+		}
+		<-w.connectRelease
+	}
+	if w.connectErr != nil {
+		return w.connectErr
+	}
+	return w.fakeWA.Connect(ctx, opts)
+}
+
+func (w *countedAuthWA) Logout(ctx context.Context) error {
+	w.logoutCalls.Add(1)
+	if w.logoutEntered != nil {
+		close(w.logoutEntered)
+		<-w.logoutRelease
+	}
+	if w.logoutErr != nil {
+		return w.logoutErr
+	}
+	return w.fakeWA.Logout(ctx)
+}
+
+func newCountedAuthApp(t *testing.T) (*App, *countedAuthWA, context.Context, func(error)) {
+	t.Helper()
+	a := newTestApp(t)
+	client := &countedAuthWA{fakeWA: newFakeWA()}
+	a.wa = client
+	// Install the fake first; no SDK client or session database is constructed.
+	if err := a.OpenWA(); err != nil {
+		t.Fatalf("OpenWA: %v", err)
+	}
+	ctx, finish, err := a.BeginScopedOperation(context.Background())
+	if err != nil {
+		t.Fatalf("BeginScopedOperation: %v", err)
+	}
+	t.Cleanup(func() { finish(nil) })
+	return a, client, ctx, finish
+}
+
+func TestOwnedAuthRefusesMissingForeignFinishedAndCanceledContextsWithoutEffects(t *testing.T) {
+	for _, mode := range []string{"missing", "foreign", "finished", "canceled"} {
+		t.Run(mode, func(t *testing.T) {
+			a, client, parent, finish := newCountedAuthApp(t)
+			auth, err := a.OwnedAuth(parent)
+			if err != nil {
+				t.Fatal(err)
+			}
+			use := parent
+			switch mode {
+			case "missing":
+				use = context.Background()
+			case "foreign":
+				other := &App{}
+				var end func(error)
+				use, end, err = other.BeginScopedOperation(context.Background())
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer end(nil)
+			case "finished":
+				finish(nil)
+			case "canceled":
+				var cancel context.CancelFunc
+				use, cancel = context.WithCancel(parent)
+				cancel()
+			}
+
+			ops := []struct {
+				name string
+				call func() error
+			}{
+				{"sync", func() error {
+					_, e := auth.Sync(use, SyncOptions{Mode: SyncModeOnce, IdleExit: time.Millisecond})
+					return e
+				}},
+				{"connect", func() error { return auth.Connect(use) }},
+				{"status", func() error { _, _, e := auth.Status(use); return e }},
+				{"logout", func() error { return auth.Logout(use) }},
+			}
+			for _, op := range ops {
+				if e := op.call(); !errors.Is(e, ErrHandleRevoked) {
+					t.Errorf("%s refusal = %v", op.name, e)
+				}
+			}
+			if got := client.isAuthedCalls.Load() + client.connectCalls.Load() + client.logoutCalls.Load(); got != 0 {
+				t.Fatalf("refused calls reached SDK %d times", got)
+			}
+			if _, err := os.Stat(filepath.Join(a.StoreDir(), "SESSION_REVOKED")); !errors.Is(err, os.ErrNotExist) {
+				t.Fatalf("refused calls changed session marker: %v", err)
+			}
+		})
+	}
+}
+
+func TestOwnedAuthConnectJoinsBlockedSDKCallAndPreservesFailure(t *testing.T) {
+	a, client, parent, finish := newCountedAuthApp(t)
+	failure := errors.New("synthetic connect failure")
+	client.connectEntered = make(chan struct{})
