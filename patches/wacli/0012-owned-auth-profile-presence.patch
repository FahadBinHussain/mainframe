+func TestOwnedAuthLogoutJoinsActualEffectAfterCancelAndTimeout(t *testing.T) {
+	for _, mode := range []string{"cancel", "deadline", "close"} {
+		t.Run(mode, func(t *testing.T) {
+			a, client, parent, finish := newCountedAuthApp(t)
+			client.logoutEntered = make(chan struct{})
+			client.logoutRelease = make(chan struct{})
+			failure := errors.New("synthetic delayed logout failure")
+			client.logoutErr = failure
+			ctx, cancel := context.WithCancel(parent)
+			if mode == "deadline" {
+				cancel()
+				ctx, cancel = context.WithTimeout(parent, 100*time.Millisecond)
+			}
+			defer cancel()
+			auth, err := a.OwnedAuth(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			result := make(chan error, 1)
+			go func() { result <- auth.Logout(ctx) }()
+			select {
+			case <-client.logoutEntered:
+			case <-time.After(time.Second):
+				t.Fatal("logout never reached actual SDK effect")
+			}
+			if mode == "deadline" {
+				<-ctx.Done()
+			} else {
+				cancel()
+			}
+			finish(nil)
+			joined := make(chan error, 1)
+			go func() {
+				if mode == "close" {
+					joined <- a.CloseWithError()
+				} else {
+					_, e := a.BeginDrain(context.Background())
+					joined <- e
+				}
+			}()
+			select {
+			case e := <-joined:
+				close(client.logoutRelease)
+				t.Fatalf("owner escaped logout effect: %v", e)
+			case <-time.After(20 * time.Millisecond):
+			}
+			close(client.logoutRelease)
+			select {
+			case e := <-result:
+				if !errors.Is(e, failure) {
+					t.Fatalf("logout lost effect failure: %v", e)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("logout failed to return")
+			}
+			select {
+			case e := <-joined:
+				if !errors.Is(e, failure) {
+					t.Fatalf("owner lost logout failure: %v", e)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("owner failed to join logout")
+			}
+			if client.logoutCalls.Load() != 1 {
+				t.Fatalf("logout calls = %d", client.logoutCalls.Load())
+			}
+		})
+	}
+}
