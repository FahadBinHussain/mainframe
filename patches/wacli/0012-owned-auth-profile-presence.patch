+func TestOwnedPresenceCleanupWithoutCancelRetainsFailure(t *testing.T) {
+	a, _, root, finish := ownedTestApp(t)
+	failure := errors.New("synthetic cleanup failure")
+	fake := newCountedProfilePresenceWA()
+	fake.failure = failure
+	fake.entered = make(chan struct{})
+	fake.release = make(chan struct{})
+	a.wa = fake
+	w, err := a.OwnedWA(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	parent, cancel := context.WithCancel(root)
+	cancel()
+	result := make(chan error, 1)
+	go func() { result <- w.SendPresence(context.WithoutCancel(parent), types.PresenceUnavailable) }()
+	select {
+	case <-fake.entered:
+	case <-time.After(time.Second):
+		t.Fatal("cleanup presence did not enter")
+	}
+	finish(nil)
+	drain := make(chan error, 1)
+	go func() { _, e := a.BeginDrain(context.Background()); drain <- e }()
+	select {
+	case e := <-drain:
+		t.Fatalf("drain escaped cleanup effect: %v", e)
+	case <-time.After(30 * time.Millisecond):
+	}
+	close(fake.release)
+	if e := <-result; !errors.Is(e, failure) {
+		t.Fatalf("cleanup failure = %v", e)
+	}
+	select {
+	case e := <-drain:
+		if !errors.Is(e, failure) || !errors.Is(e, ErrDrainCoverageIncomplete) {
+			t.Fatalf("drain lost cleanup failure: %v", e)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("drain did not join cleanup effect")
+	}
+	if err := w.SendPresence(context.WithoutCancel(parent), types.PresenceUnavailable); !errors.Is(err, ErrHandleRevoked) {
+		t.Fatalf("finished token revived by WithoutCancel: %v", err)
+	}
+	other := &App{}
+	foreign, otherFinish, err := other.BeginScopedOperation(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer otherFinish(nil)
+	if err := w.SendPresence(context.WithoutCancel(foreign), types.PresenceUnavailable); !errors.Is(err, ErrHandleRevoked) {
+		t.Fatalf("foreign token accepted by WithoutCancel: %v", err)
+	}
+}
