+		t.Fatal(err)
+	}
+	auth, err := a.OwnedAuth(parent)
+	if err != nil {
+		t.Fatal(err)
+	}
+	authed, jid, err := auth.Status(parent)
+	if err != nil {
+		t.Fatalf("Status: %v", err)
+	}
+	if authed || jid != "" {
+		t.Fatalf("Status = authed %v jid %q despite revocation", authed, jid)
+	}
+	if client.isAuthedCalls.Load() != 1 {
+		t.Fatalf("IsAuthed calls = %d, want 1", client.isAuthedCalls.Load())
+	}
