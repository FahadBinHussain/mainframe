+package app
+
+import (
+	"context"
+	"time"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+// Profile and presence operations are exposed only through the borrowed facade;
+// the underlying client never escapes command ownership.
+func (w *OwnedWA) SetProfilePicture(ctx context.Context, avatar []byte) (id string, err error) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		return "", err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return w.client.SetProfilePicture(ctx, avatar)
+}
+func (w *OwnedWA) GetProfilePictureInfo(ctx context.Context, jid types.JID, preview bool, existingID string) (info *types.ProfilePictureInfo, err error) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return w.client.GetProfilePictureInfo(ctx, jid, preview, existingID)
+}
+func (w *OwnedWA) SetStatusMessage(ctx context.Context, msg string) (err error) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return w.client.SetStatusMessage(ctx, msg)
+}
+func (w *OwnedWA) SetProfileName(ctx context.Context, name string) (err error) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return w.client.SetProfileName(ctx, name)
+}
+func (w *OwnedWA) GetUserInfo(ctx context.Context, jids []types.JID) (info map[types.JID]types.UserInfo, err error) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return w.client.GetUserInfo(ctx, jids)
+}
+func (w *OwnedWA) GetBusinessProfile(ctx context.Context, jid types.JID) (profile *types.BusinessProfile, err error) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return w.client.GetBusinessProfile(ctx, jid)
+}
+func (w *OwnedWA) SendPresence(ctx context.Context, state types.Presence) (err error) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return w.client.SendPresence(ctx, state)
+}
+func (w *OwnedWA) SendChatPresence(ctx context.Context, jid types.JID, state types.ChatPresence, media types.ChatPresenceMedia) (err error) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return w.client.SendChatPresence(ctx, jid, state, media)
+}
+func (w *OwnedWA) SubscribePresence(ctx context.Context, jid types.JID) (err error) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return w.client.SubscribePresence(ctx, jid)
+}
+
+// WatchPresence retains an effect lease for the complete subscription/wait.
+func (a *App) WatchPresenceOwned(ctx context.Context, jid types.JID, wait time.Duration) (*PresenceState, error) {
+	owned, err := a.OwnedWA(ctx)
+	if err != nil {
+		return nil, err
+	}
+	child, finish, err := owned.effect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	var resultErr error
+	defer finishOwnedEffect(finish, &resultErr)
+	state, resultErr := a.WatchPresence(child, jid, wait)
+	return state, resultErr
+}
