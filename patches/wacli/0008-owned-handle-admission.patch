+++ b/internal/app/owned_wa_test.go
@@ -0,0 +1,215 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/openclaw/wacli/internal/store"
+	"go.mau.fi/whatsmeow/types"
+)
+
+type ownedProbeWA struct {
+	WAClient
+	calls   atomic.Int32
+	entered chan struct{}
+	release chan struct{}
+	failure error
+	panics  bool
+}
+
+func (w *ownedProbeWA) SendText(context.Context, types.JID, string) (types.MessageID, error) {
+	w.calls.Add(1)
+	if w.entered != nil {
+		close(w.entered)
+		<-w.release
+	}
+	if w.panics {
+		panic(w.failure)
+	}
+	return "synthetic-id", w.failure
+}
+func (*ownedProbeWA) Disconnect() {}
+func (*ownedProbeWA) Close()      {}
+
+func ownedTestApp(t *testing.T) (*App, *ownedProbeWA, context.Context, func(error)) {
+	t.Helper()
+	db, err := store.Open(filepath.Join(t.TempDir(), "synthetic.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = db.Close() })
+	probe := &ownedProbeWA{}
+	a := &App{db: db, wa: probe}
+	ctx, finish, err := a.BeginScopedOperation(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { finish(nil) })
+	return a, probe, ctx, finish
+}
+
+func TestOwnedBorrowedHandlesRefuseBeforeEffects(t *testing.T) {
+	for _, mode := range []string{"finished", "canceled", "foreign", "missing", "closed"} {
+		t.Run(mode, func(t *testing.T) {
+			a, probe, ctx, finish := ownedTestApp(t)
+			wa, err := a.OwnedWA(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			db, err := a.OwnedDB(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			use := ctx
+			switch mode {
+			case "finished":
+				finish(nil)
+			case "canceled":
+				var cancel context.CancelFunc
+				use, cancel = context.WithCancel(ctx)
+				cancel()
+			case "foreign":
+				other := &App{}
+				var end func(error)
+				use, end, err = other.BeginScopedOperation(context.Background())
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer end(nil)
+			case "missing":
+				use = context.Background()
+			case "closed":
+				finish(nil)
+				if err := a.CloseWithError(); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if _, err := wa.SendText(use, types.JID{}, "synthetic"); !errors.Is(err, ErrHandleRevoked) {
+				t.Fatalf("WA admission: %v", err)
+			}
+			if err := db.UpsertChat(use, "synthetic", "private", "synthetic", time.Time{}); !errors.Is(err, ErrHandleRevoked) {
+				t.Fatalf("DB admission: %v", err)
+			}
+			if probe.calls.Load() != 0 {
+				t.Fatal("revoked borrowed WA reached effect")
+			}
+			if mode != "closed" {
+				if _, err := a.db.GetChat("synthetic"); err == nil {
+					t.Fatal("revoked borrowed DB wrote a row")
+				}
+			}
+		})
+	}
+}
+
+func TestOwnedAcceptedEffectHoldsCloseUntilActualReturn(t *testing.T) {
+	a, probe, ctx, finish := ownedTestApp(t)
+	probe.entered = make(chan struct{})
+	probe.release = make(chan struct{})
+	failure := errors.New("synthetic delayed effect error")
+	probe.failure = failure
+	wa, err := a.OwnedWA(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result := make(chan error, 1)
+	go func() { _, err := wa.SendText(ctx, types.JID{}, "synthetic"); result <- err }()
+	select {
+	case <-probe.entered:
+	case <-time.After(time.Second):
+		t.Fatal("effect not entered")
+	}
+	finish(nil)
+	closed := make(chan error, 1)
+	go func() { closed <- a.CloseWithError() }()
+	select {
+	case <-ctx.Done():
+	case <-time.After(time.Second):
+		t.Fatal("close did not cancel owned group")
+	}
+	select {
+	case err := <-closed:
+		t.Fatalf("close escaped active borrowed effect: %v", err)
+	default:
+	}
+	close(probe.release)
+	if err := <-result; !errors.Is(err, failure) {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-closed:
+		if !errors.Is(err, failure) {
+			t.Fatalf("close lost effect error: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("close failed to join")
+	}
+}
+
+func TestOwnedLiveDescendantAfterSealAndForeignRootRefusal(t *testing.T) {
+	a, _, ctx, finish := ownedTestApp(t)
+	db, err := a.OwnedDB(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	canceled, cancel := context.WithCancel(context.Background())
+	cancel()
+	if held, err := a.BeginDrain(canceled); held != nil || !errors.Is(err, ErrDrainCoverageIncomplete) {
+		t.Fatalf("hold escaped: %v %v", held, err)
+	}
+	if err := db.UpsertChat(ctx, "synthetic", "private", "synthetic", time.Time{}); err != nil {
+		t.Fatalf("accepted lineage lost after seal: %v", err)
+	}
+	if _, _, err := a.BeginScopedOperation(context.Background()); !errors.Is(err, ErrOperationSealed) {
+		t.Fatal(err)
+	}
+	other := &App{}
+	if _, _, err := other.BeginScopedOperation(ctx); !errors.Is(err, ErrOperationForeignScope) {
+		t.Fatalf("foreign root reentry: %v", err)
+	}
+	finish(nil)
+	if err := db.UpsertChat(ctx, "late", "private", "late", time.Time{}); !errors.Is(err, ErrHandleRevoked) {
+		t.Fatal(err)
+	}
+}
+
+func TestOwnedPanicRetainsFailureAndFinishesEffect(t *testing.T) {
+	a, probe, ctx, finish := ownedTestApp(t)
+	failure := errors.New("synthetic effect panic")
+	probe.failure = failure
+	probe.panics = true
+	wa, err := a.OwnedWA(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	func() {
+		defer func() {
+			if got := recover(); got != failure {
+				t.Fatalf("panic changed: %v", got)
+			}
+		}()
+		_, _ = wa.SendText(ctx, types.JID{}, "synthetic")
+	}()
+	finish(nil)
+	if held, err := a.BeginDrain(context.Background()); held != nil || !errors.Is(err, failure) || !errors.Is(err, ErrDrainCoverageIncomplete) {
+		t.Fatalf("panic cause/coverage lost: %v %v", held, err)
+	}
+}
+
+func TestOwnedLegacyRawDBRemainsExplicitCoverageGap(t *testing.T) {
+	a, _, _, finish := ownedTestApp(t)
+	raw := a.DB()
+	finish(nil)
+	held, err := a.BeginDrain(context.Background())
+	if held != nil || !errors.Is(err, ErrDrainCoverageIncomplete) {
+		t.Fatalf("raw gap was certified: %v %v", held, err)
+	}
+	// A retained raw DB is intentionally a counterexample, not a successful hold.
+	if err := raw.UpsertChat("raw-gap", "private", "synthetic", time.Time{}); err != nil {
+		t.Fatal(err)
+	}
+}
