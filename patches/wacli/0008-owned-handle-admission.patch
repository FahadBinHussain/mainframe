@@ -0,0 +1,68 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/openclaw/wacli/internal/store"
+)
+
+// OwnedDB is the deliberately limited metadata-write facade used by file send.
+// It never exposes the underlying database; methods hold a child lease for the
+// complete database invocation.
+type OwnedDB struct {
+	db  *store.DB
+	app *App
+}
+
+func (a *App) OwnedDB(ctx context.Context) (*OwnedDB, error) {
+	if err := a.admitHandle(ctx); err != nil {
+		return nil, err
+	}
+	a.waMu.Lock()
+	closed := a.closed
+	a.waMu.Unlock()
+	if closed || a.db == nil {
+		return nil, ErrHandleRevoked
+	}
+	return &OwnedDB{db: a.db, app: a}, nil
+}
+
+func (d *OwnedDB) effect(ctx context.Context) (context.Context, func(error), error) {
+	if err := d.app.admitHandle(ctx); err != nil {
+		return nil, nil, err
+	}
+	child, finish, err := RegisterOperationChild(ctx)
+	if err != nil {
+		return nil, nil, errors.Join(ErrHandleRevoked, err)
+	}
+	return child, finish, nil
+}
+
+func (d *OwnedDB) UpsertChat(ctx context.Context, jid, kind, name string, updatedAt time.Time) (err error) {
+	_, finish, err := d.effect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return d.db.UpsertChat(jid, kind, name, updatedAt)
+}
+
+func (d *OwnedDB) UpsertMessage(ctx context.Context, p store.UpsertMessageParams) (err error) {
+	_, finish, err := d.effect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return d.db.UpsertMessage(p)
+}
+
+func (d *OwnedDB) UpsertStatusMessage(ctx context.Context, p store.UpsertStatusMessageParams) (err error) {
+	_, finish, err := d.effect(ctx)
+	if err != nil {
+		return err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return d.db.UpsertStatusMessage(p)
+}
diff --git a/internal/app/owned_wa.go b/internal/app/owned_wa.go
