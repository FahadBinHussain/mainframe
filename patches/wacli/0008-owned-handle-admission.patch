index 0000000..8df725f
--- /dev/null
+++ b/internal/app/owned_wa.go
@@ -0,0 +1,191 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"go.mau.fi/whatsmeow"
+	waProto "go.mau.fi/whatsmeow/binary/proto"
+	"go.mau.fi/whatsmeow/types"
+)
+
+// ErrHandleRevoked is returned before a client effect when its admission scope
+// is absent, canceled, finished, or stale.
+var ErrHandleRevoked = errors.New("WACLI borrowed handle admission is revoked")
+
+// OwnedWA is a narrow, non-escaping facade. Its SDK client is private.
+type OwnedWA struct {
+	client WAClient
+	app    *App
+	borrow context.Context
+}
+
+func (a *App) OwnedWA(ctx context.Context) (*OwnedWA, error) {
+	if err := a.admitHandle(ctx); err != nil {
+		return nil, err
+	}
+	a.waMu.Lock()
+	client := a.wa
+	closed := a.closed
+	a.waMu.Unlock()
+	if closed || client == nil {
+		return nil, ErrHandleRevoked
+	}
+	return &OwnedWA{client: client, app: a, borrow: ctx}, nil
+}
+
+func (a *App) admitHandle(ctx context.Context) error {
+	if ctx == nil {
+		return ErrHandleRevoked
+	}
+	scope, _ := ctx.Value(operationScopeKey{}).(*operationScope)
+	if scope == nil || scope.owner != &a.operations {
+		return ErrHandleRevoked
+	}
+	if err := ctx.Err(); err != nil {
+		return errors.Join(ErrHandleRevoked, err)
+	}
+	scope.owner.mu.Lock()
+	done := scope.done
+	scope.owner.mu.Unlock()
+	if done {
+		return ErrHandleRevoked
+	}
+	return nil
+}
+
+func (w *OwnedWA) effect(ctx context.Context) (context.Context, func(error), error) {
+	if err := w.app.admitHandle(ctx); err != nil {
+		return nil, nil, err
+	}
+	child, finish, err := RegisterOperationChild(ctx)
+	if err != nil {
+		return nil, nil, errors.Join(ErrHandleRevoked, err)
+	}
+	return child, finish, nil
+}
+
+func (w *OwnedWA) SendText(ctx context.Context, to types.JID, text string) (id types.MessageID, err error) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		return "", err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return w.client.SendText(ctx, to, text)
+}
+func (w *OwnedWA) SendProtoMessage(ctx context.Context, to types.JID, msg *waProto.Message) (id types.MessageID, err error) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		return "", err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return w.client.SendProtoMessage(ctx, to, msg)
+}
+func (w *OwnedWA) SendProtoMessageWithExtra(ctx context.Context, to types.JID, msg *waProto.Message, mediaHandle string) (id types.MessageID, err error) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		return "", err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return w.client.SendProtoMessageWithExtra(ctx, to, msg, mediaHandle)
+}
+func (w *OwnedWA) Upload(ctx context.Context, data []byte, mediaType whatsmeow.MediaType) (out whatsmeow.UploadResponse, err error) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		return whatsmeow.UploadResponse{}, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return w.client.Upload(ctx, data, mediaType)
+}
+func (w *OwnedWA) UploadNewsletter(ctx context.Context, data []byte, mediaType whatsmeow.MediaType) (out whatsmeow.UploadResponse, err error) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		return whatsmeow.UploadResponse{}, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return w.client.UploadNewsletter(ctx, data, mediaType)
+}
+func (w *OwnedWA) ResolveChatName(ctx context.Context, chat types.JID, pushName string) string {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		w.app.recordOwnedError(err)
+		return ""
+	}
+	var effectErr error
+	defer finishOwnedEffect(finish, &effectErr)
+	return w.client.ResolveChatName(ctx, chat, pushName)
+}
+func (w *OwnedWA) ResolvePNToLID(ctx context.Context, jid types.JID) (out types.JID) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		w.app.recordOwnedError(err)
+		return
+	}
+	var effectErr error
+	defer finishOwnedEffect(finish, &effectErr)
+	return w.client.ResolvePNToLID(ctx, jid)
+}
+func (w *OwnedWA) ResolveLIDToPN(ctx context.Context, jid types.JID) (out types.JID) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		w.app.recordOwnedError(err)
+		return
+	}
+	var effectErr error
+	defer finishOwnedEffect(finish, &effectErr)
+	return w.client.ResolveLIDToPN(ctx, jid)
+}
+func (w *OwnedWA) GetGroupInfo(ctx context.Context, jid types.JID) (out *types.GroupInfo, err error) {
+	ctx, finish, err := w.effect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer finishOwnedEffect(finish, &err)
+	return w.client.GetGroupInfo(ctx, jid)
+}
+
+// No-context compatibility readers are bound to the borrowing scope. Refusal
+// cannot be returned by their legacy signature, so it remains a drain error.
+func (w *OwnedWA) LinkedJID() string {
+	_, finish, err := w.effect(w.borrow)
+	if err != nil {
+		w.app.recordOwnedError(err)
+		return ""
+	}
+	var effectErr error
+	defer finishOwnedEffect(finish, &effectErr)
+	return w.client.LinkedJID()
+}
+func (w *OwnedWA) LinkedLID() string {
+	_, finish, err := w.effect(w.borrow)
+	if err != nil {
+		w.app.recordOwnedError(err)
+		return ""
+	}
+	var effectErr error
+	defer finishOwnedEffect(finish, &effectErr)
+	return w.client.LinkedLID()
+}
+
+func (a *App) recordOwnedError(err error) {
+	a.operations.mu.Lock()
+	defer a.operations.mu.Unlock()
+	if a.operations.err == nil {
+		a.operations.err = err
+	}
+}
+
+// Finish actual invocations even on panic, retaining the cause without changing
+// the caller's existing panic semantics.
+func finishOwnedEffect(finish func(error), effectErr *error) {
+	if recovered := recover(); recovered != nil {
+		if cause, ok := recovered.(error); ok {
+			finish(fmt.Errorf("owned handle effect panic: %w", cause))
+		} else {
+			finish(fmt.Errorf("owned handle effect panic: %v", recovered))
+		}
+		panic(recovered)
+	}
+	finish(*effectErr)
+}
